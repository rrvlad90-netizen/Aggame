//flares



Actor Flare_General
{
+NOINTERACTION
+NOGRAVITY
+CLIENTSIDEONLY
renderstyle Add
radius 1
height 1
alpha 0.4
scale 0.4
}

Actor FireballFlare : Flare_General
{
alpha 0.6
scale 0.15
states
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(128,2)
		LENY A 1 bright
		stop
		TNT1 A 0
		LENY B 1 bright
		stop
	}
}


Actor ExplosionFlareSpawner : Flare_General
{
states
	{
	Spawn:
	    TNT1 A 0
	    TNT1 A 0 A_SpawnItem("NewfagExplosionFlare") 
		L2NR AAA 1 BRIGHT //A_SpawnItem("RedFlareLarge1x")
		
		L2NR A 5
		stop
	}
}

