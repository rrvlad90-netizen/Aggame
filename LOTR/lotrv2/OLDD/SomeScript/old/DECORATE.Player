ACTOR Kinv : Inventory {
    Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR Jmp : Inventory {
    Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR Jmp2 : Inventory {
    Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR Van: PlayerPawn //HereticPlayer
{
  Health 100
  Radius 16
  Height 56
  Mass 300
  PainChance 255
  Speed 0.55
  +NOBLOOD
  //+NOPAIN
  	+NOSKIN
    +NOICEDEATH
    Player.ForwardMove 0.49
  Player.SideMove  0.49, 0.49 
  
  	//Player.RunHealth 15
	//Player.ViewHeight 56
  Player.DisplayName "VanH"
  Player.StartItem "Shell", 50
  Player.StartItem "Shotgun2"
  //Player.StartItem "SkyrimBow"
  //Player.StartItem "CrossbowAmmo", 50
  Player.WeaponSlot 1, Shotgun2 //TwoHandedAxe2, TwoHandedAxe
  //Player.WeaponSlot 2, SkyrimBow
 // Player.WeaponSlot 3, SwordWW
  //Player.WeaponSlot 4, Blaster
  //Player.WeaponSlot 5, SkullRod
  //Player.WeaponSlot 6, PhoenixRod
  //Player.WeaponSlot 7, Mace
  Player.ColorRange 225, 240
  Player.ColorSet 0, "Green",         225, 240,  238
  Player.ColorSet 1, "Yellow",        114, 129,  127
  Player.ColorSet 2, "Red",           145, 160,  158
  Player.ColorSet 3, "Blue",          190, 205,  203
  // Doom Legacy additions
//  Player.ColorSet 4, "Brown",          67,  82,   80
//  Player.ColorSet 5, "Light Gray",      9,  24,   22
//  Player.ColorSet 6, "Light Brown",    74,  89,   87
//  Player.ColorSet 7, "Light Red",     150, 165,  163
//  Player.ColorSet 8, "Light Blue",    192, 207,  205
// Player.ColorSet 9, "Beige",          95, 110,  108

  States
  {
  Spawn:
  TNT1 A 0 A_JumpIfInventory("Jmp",1,"SpawnLand")
  //TNT1 A 0 SetPlayerProperty(TRUE, ON, PROP_TOTALLYFROZEN) //frozen_all time_stop
  TNT1 A 0 SetPlayerProperty(0, 0, PROP_FROZEN)
   //TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
   VAT1 A 1
	Loop
  SpawnLand:
    //TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
	  TNT1 A 0 SetPlayerProperty(0, 1, PROP_FROZEN)
	      TNT1 A 0 A_TakeInventory("Jmp",1)
   VAJK BCDE 1 Fast
   Almost:
    TNT1 A 0 A_TakeInventory("Jmp2",1)
   VAJK FGHIJ 1 Fast
	Goto Spawn  
    //Stop
  See:
    VANR ABCDEFGHIJKLMNOPQA 1
    Loop
  Melee:
  Missile:
  TNT1 A 0 A_JumpIfInventory("Jmp",1,"Fly")
  TNT1 A 0 A_JumpIfInventory("Jmp2",1,"Almost")
  VAT1 A 1
  TNT1 A 0 A_JumpIFInventory("Kinv", 1,"Kick")
  	VAT1 A 3   
	TNT1 A 0 A_JumpIFInventory("Kinv", 1,"Kick")
    VAT1 ABCCCDDDEEEDDDDCCCBA 1 Fast	
	VAT1 A 5
    Goto Spawn
  Kick:
  VANK ABCDEFGHIJKLMNOPQR 1 Fast	
  VKAN ABCDEFGHIJ 1 Fast
    Goto Spawn  
  Pain:
    //TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
	TNT1 A 0 SetPlayerProperty(0, 1, PROP_FROZEN)
    VKAN J 1 A_Pain
	VKAN JIG 3 
    //VKAN HGIJ 4 
    Goto Spawn
  Jump: 
        TNT1 A 0 A_GiveInventory("Jmp",1)
		TNT1 A 0 A_GiveInventory("Jmp2",1)
		VJNK ABCDEFGHIJKLMNOPQ 1 Fast
		Fly:
		VJNK R 1 A_CheckFloor(1)
		Wait
		VJNK R 1
		VJNK R 1
		Goto Spawn
	
	
  Death:
    TNT1 A 0 A_Stop
    VNDD A 3
    VNDD B 3 A_PlayerScream
    VNDD C 3 A_NoBlocking
    VNDD DEFGHIJ 3
    VNDD J -1
    Stop
  XDeath:
    TNT1 A 0 A_Stop
    VNDD A 3
    VNDD B 3 A_PlayerScream  //A_XScream
    VNDD C 3 A_NoBlocking
    VNDD DEFGHIJ 3
    VNDD J -1
    Stop
  Burn:
    //FDTH A 5 BRIGHT A_PlaySound("*burndeath")
    //FDTH D 4 BRIGHT A_PlayerScream
    //FDTH G 5 BRIGHT A_PlaySound("*burndeath")
    //FDTH O 5 BRIGHT A_NoBlocking
    //ACLO E 35 A_CheckPlayerDone
    //Wait
  AltSkinDeath:	
    TNT1 A 0 A_Stop
    VNDD A 3
    VNDD B 3 A_PlayerScream
    VNDD C 3 A_NoBlocking
    VNDD DEFGHIJ 3
    VNDD J -1
    Stop 
  AltSkinXDeath:
    TNT1 A 0 A_Stop
    VNDD A 3
    VNDD B 3 A_PlayerScream  //A_XScream
    VNDD C 3 A_NoBlocking
    VNDD DEFGHIJ 3
    VNDD J -1
    Stop
  }
}



ACTOR Shotgun2 : Shotgun replaces Shotgun
{
  Weapon.KickBack 100
  Weapon.SelectionOrder 1300
  Weapon.AmmoUse 1
  Weapon.AmmoGive 8
  Weapon.AmmoType "Shell"
  Inventory.PickupMessage "$GOTSHOTGUN"
  Obituary "$OB_MPSHOTGUN"
  Tag "$TAG_SHOTGUN"
  +WEAPON.WIMPY_WEAPON
  Damagetype "kickb"
  States
  {
  Ready:
    SHTG A 1 A_WeaponReady
    Loop
  Deselect:
    SHTG A 1 A_Lower
    Loop
  Select:
    SHTG A 1 A_Raise
    Loop
  Fire:
    TNT1 A 0 A_JumpIfInventory("Jmp2",1,"Ready")
		  TNT1 A 0 SetPlayerProperty(0, 1, PROP_FROZEN)
    //TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
    SHTG A 3
	TNT1 A 0 A_SPawnItemEx("YellowFlareSmall",45,10,38,0)
    SHTG A 7 A_FireShotgun
    SHTG BC 5 
    SHTG D 4
    SHTG CB 5
    SHTG A 15	
	TNT1 A 0 A_ReFire
	//TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
    Goto Ready
	
  AltFire:
    TNT1 A 0 A_GiveInventory("Kinv",1)
		  TNT1 A 0 SetPlayerProperty(0, 1, PROP_FROZEN)
    //TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
    SHTG AAAAAAAAAA 1 Fast
    SHTG A 1 Fast A_CustomPunch(2, FALSE, 0, BulletPuff, 28)   //last numbet it is a range of attack
    SHTG AAAAAAAAAAAAAAAA 1 Fast
	TNT1 A 0 A_ReFire
	//TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
	TNT1 A 0 A_TakeInventory("Kinv",1)
    Goto Ready
  Flash:
    SHTF A 4 Bright A_Light1
    SHTF B 3 Bright A_Light2
    Goto LightDone
  Spawn:
    SHOT A -1
    Stop
  }
}


Actor YellowFlareSmall
{
//+NOCLIP
+NOINTERACTION
+NOGRAVITY
+CLIENTSIDEONLY
renderstyle Add
radius 1
height 1
+FORCEXYBILLBOARD
scale 0.15
Alpha 0.3
states
	{
	Spawn:
		TNT1 A 0
		//TNT1 A 0 A_Jump(128,2)
		LENY A 1 bright
		stop
		TNT1 A 0
		LENY B 1 bright
		stop
	}
}