ACTOR WarriorLungeActive : Inventory
{
    Inventory.MaxAmount 1
    +INVENTORY.UNDROPPABLE
}

ACTOR Jmp : Inventory {
    Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR Jmp2 : Inventory {
    Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}


ACTOR PlayerWarrior : WarriorThirdPersonBase
{
    Health 120
    Radius 16
    Height 56
    Mass 300
    PainChance 0
    Speed 0.95

    RenderStyle None

    +NOBLOOD
    +NOPAIN
    +NOSKIN
    +NOICEDEATH

	DamageFactor "Gondor", 0

    Player.ForwardMove 0.49
    Player.SideMove 0.49, 0.49
    Player.ViewHeight 48

    Player.DisplayName "PlayerWarrior"
	Player.Portrait "PORT1"
    Player.StartItem "LotrSword"
	Player.StartItem "Clip", 9
    Player.WeaponSlot 1, LotrSword

  //Player.Face "GOND"	
  Player.ColorRange 225, 240
  Player.ColorSet 0, "Green",         225, 240,  238
  Player.ColorSet 1, "Yellow",        114, 129,  127
  Player.ColorSet 2, "Red",           145, 160,  158
  Player.ColorSet 3, "Blue",          190, 205,  203
  // Doom Legacy additions
//  Player.ColorSet 4, "Brown",          67,  82,   80
//  Player.ColorSet 5, "Light Gray",      9,  24,   22
//  Player.ColorSet 6, "Light Brown",    74,  89,   87
//  Player.ColorSet 7, "Light Red",     150, 165,  163
//  Player.ColorSet 8, "Light Blue",    192, 207,  205
// Player.ColorSet 9, "Beige",          95, 110,  108

  States
  {
  Spawn:
  TNT1 A 0 A_JumpIfInventory("Jmp",1,"SpawnLand")
   ////TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
   GONS A 1
	Loop
  SpawnLand:
    	 TNT1 A 0 ACS_NamedExecute("LockPlayer")
	      TNT1 A 0 A_TakeInventory("Jmp",1)
   VAJK BCDE 1 Fast 
   Almost:
    TNT1 A 0 A_TakeInventory("Jmp2",1)
   VAJK FGHIJ 1 Fast
	Goto Spawn  
    //Stop
  See:
		GON2 JKLMNOPQRSTUVW 1 Fast
		GON3 ABCDEFGHIJKL 1 Fast
    Loop
Melee:
Missile:
    /*
     * Даём оружию один тик, чтобы выдать
     * WarriorLungeActive.
     */
	TNT1 A 0 A_Jump(80,"Kick2")
    GONS A 1

    TNT1 A 0 A_JumpIfInventory(
        "WarriorLungeActive",
        1,
        "Lunge"
    )

    TNT1 A 0 A_BeginWarriorAttack
    TNT1 A 0 A_PlaySound("EMPR")

    GON1 ABCDEFGHIJKLMNOPQR 1 Fast
    GON1 S 1 Fast A_CustomMeleeAttack(
        57,
        "CSAWFLESH"
    )

    GON1 TUVWXYZ 1 Fast
    GN22 ABCDEFGHIJKLMN 1 Fast

    TNT1 A 0 A_FinishWarriorAttack
    Goto Spawn
	
Kick2:
    GN22 N 1

    TNT1 A 0 A_JumpIfInventory(
        "WarriorLungeActive",
        1,
        "Lunge"
    )

    TNT1 A 0 A_BeginWarriorAttack
    TNT1 A 0 A_PlaySound("EMPR")
	
	GN22 MLKJHIGFEDCBA 1 Fast
	GON1 ZYXWVUT 1 Fast

    GON1 S 1 Fast A_CustomMeleeAttack(
        57,
        "CSAWFLESH"
    )
	GON1 RQPONMLKJIHGFEDCBA 1 Fast

    TNT1 A 0 A_FinishWarriorAttack
    Goto Spawn	


Lunge:
    TNT1 A 0 A_BeginWarriorAttack
    TNT1 A 0 A_PlaySound("EMPR")

    /*
     * Специальная анимация суперудара.
     * Само движение и урон выполняет LotrSword.
     */
    GON4 ABCDEFGHIJKLMNOP 1 Fast A_CustomMeleeAttack(1)
    GON4 Q 1 Fast A_CustomMeleeAttack(1)
    GON4 RSTUVWXYZ 1 Fast A_CustomMeleeAttack(1)
    GNN4 ABCDEFGH 1 Fast A_CustomMeleeAttack(1)

    TNT1 A 0 A_FinishWarriorAttack
    Goto Spawn
  Jump: 
        TNT1 A 0 A_GiveInventory("Jmp",1)
		TNT1 A 0 A_GiveInventory("Jmp2",1)
		VJNK A 1 Fast A_Recoil(-14)
		VJNK BCDEFGHIJKLMNOPQ 1 Fast 
		Fly:
		VJNK R 1 A_CheckFloor(1)
		Wait
		VJNK R 1
		VJNK R 1

		Goto Spawn
	
	
  Death:
  TNT1 A 0 A_ResetWarriorControl
    TNT1 A 0 A_Stop
  		//TNT1 A 0 A_Recoil(11)
		GOND ABCDEFGHIJKLMNOPQRSTU 1
		GOND U 1 A_PlayerSkinCheck("AltSkinDeath")
		GOND U 1 A_NoBlocking
		GOND U 120
		TNT1 A -1
    Stop
  XDeath:
  TNT1 A 0 A_ResetWarriorControl
    TNT1 A 0 A_Stop
  		//TNT1 A 0 A_Recoil(11)
		GOND ABCDEFGHIJKLMNOPQRSTU 1
		GOND U 1 A_PlayerSkinCheck("AltSkinXDeath")
		GOND U 1 A_NoBlocking
		GOND U 120
		TNT1 A -1
    Stop
  Burn:
  TNT1 A 0 A_ResetWarriorControl
    //FDTH A 5 BRIGHT A_PlaySound("*burndeath")
    //FDTH D 4 BRIGHT A_PlayerScream
    //FDTH G 5 BRIGHT A_PlaySound("*burndeath")
    //FDTH O 5 BRIGHT A_NoBlocking
    //ACLO E 35 A_CheckPlayerDone
    //Wait
  AltSkinDeath:	
  TNT1 A 0 A_ResetWarriorControl
    TNT1 A 0 A_Stop
  		//TNT1 A 0 A_Recoil(11)
		GOND ABCDEFGHIJKLMNOPQRSTU 1
		GOND U 1 A_PlayerSkinCheck("AltSkinXDeath")
		GOND U 1 A_NoBlocking
		GOND U 120
		TNT1 A -1
    Stop 
  AltSkinXDeath:
  TNT1 A 0 A_ResetWarriorControl
    TNT1 A 0 A_Stop
  		//TNT1 A 0 A_Recoil(11)
		GOND ABCDEFGHIJKLMNOPQRSTU 1
		GOND U 1 A_PlayerSkinCheck("AltSkinXDeath")
		GOND U 1 A_NoBlocking
		GOND U 120
		TNT1 A -1
    Stop
  }
}

ACTOR WarriorCaptain : PlayerWarrior
{
    Player.DisplayName "Warrior Captain"
	Player.Portrait "PORT2"
    //Player.Face "CAPT"
}

ACTOR LotrSword : Weapon replaces Chainsaw
{
  Weapon.SelectionOrder 3500
  Weapon.KickBack 20
  Weapon.YAdjust -8
  +BLOODSPLATTER
  +WEAPON.NOAUTOAIM
  +WEAPON.WIMPY_WEAPON
  +WEAPON.MELEEWEAPON
  //+WEAPON.NOAUTOFIRE
  Obituary "$OB_MPCWEAPMACE"
  Tag "$TAG_CWEAPMACE"
  Weapon.AmmoType2 "Clip"
  Weapon.AmmoUse2 3
  +WEAPON.NOAUTOFIRE
  
    DamageType PlayAtt

  States
  {
  Select:
    MUAS A 1 A_Raise
    Loop
  Deselect:
    TNT1 A 1 A_Lower
    Loop
  Ready:
    TNT1 A 1 A_WeaponReady
    Loop
Fire:
    TNT1 A 0 A_JumpIfInventory("Jmp2",1,"Ready")
	TNT1 A 0 A_PlayWeaponSound("AxeSwing")
    MAAS A 11 Offset(60, 20)
	TNT1 A 0 A_PlaySound("HAMMIS2")
	TNT1 A 0 A_FireCustomMissile("SwordSlash3", 0, 0, -20,5) //random(-5,5))
	TNT1 A 0 A_FireCustomMissile("SwordSlash3", 0, 0, 20,5) //random(-5,5))
    TNT1 E 1 Offset(-11, 58) A_FireCustomMissile("SwordSlash2", 0, 0, -1, 5) //random(-5,5))//("SwordSlash2",0,-1,0,15)
	TNT1 A 23
    TNT1 A 1 Offset(8, 75) A_ReFire
    Goto Ready
AltFire:
    TNT1 A 0 A_JumpIfInventory("Clip", 3, "Lunge")
    TNT1 A 8
    Goto Ready

Lunge:
    TNT1 A 0 A_GiveInventory("WarriorLungeActive", 1)
    TNT1 A 0 A_TakeInventory("Clip", 3)
    TNT1 A 0 A_PlayWeaponSound("AxeSwing")

    MAAS A 1 Offset(60, 20) A_Recoil(-3)
    MAAS A 1 Offset(60, 20) A_Recoil(-3)
    MAAS A 1 Offset(60, 20) A_Recoil(-3)

    TNT1 A 0 A_CustomPunch(
        45,
        true,
        0,
        "BulletPuff",
        80
    )

    MAAS A 1 Offset(60, 20) A_Recoil(-3)
    MAAS A 1 Offset(60, 20) A_Recoil(-3)
    MAAS A 1 Offset(60, 20) A_Recoil(-3)

    MAAS A 5 Offset(60, 20)

    TNT1 A 0 A_TakeInventory("WarriorLungeActive", 1)
    TNT1 A 18
    Goto Ready
	
  }
}

ACTOR SwordSlash2
{
  Radius 17
  Height 18
  Speed 13
  Damage 6 //25
  Projectile
  +RANDOMIZE
  +ZDOOMTRANS
  RenderStyle Add
  Alpha 0.75
  //SeeSound "weapons/plasmaf"
  //DeathSound "weapons/plasmax"
  Obituary "$OB_MPPLASMARIFLE" // "%o was melted by %k's plasma gun."
    Scale 0.6
  DamageType PlayAtt
  
  States
  {
  Spawn:
    TNT1 A 0 A_PlaySound("HAMSWING")
    TNT1 AAA 1
	Stop
  Death:
	TNT1 A 1
    Stop
  }
}

