///Troll
Actor MoriaTroll
{
  health 650
  Radius 29
  Height 45
  Speed 12
  mass 9999
  Monster
  +LOOKALLAROUND
  +NOTARGET
  +DROPOFF
  +NOBLOOD
  +RANDOMIZE
   +BOSS
   	DamageFactor "Mordor", 0
SeeSound "trollsee"
PainSound "troll"
DeathSound "troll"

  States
  {
  Spawn:
    TRLA A 1
    TNT1 A 0 Thing_ChangeTID(0, 2700)
    TRLA A 1 A_Look
    Loop

See:
    TRLL ABCDEFGHIJKLM 2 A_Chase
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 512, 512, 360, "See")
    Loop

Melee:
   TNT1 A 0 A_Jump(128,"Melee2")
   TRLA AAAAA 2  A_FaceTarget
   TRLA AABBCCDEFGHI 2 A_FaceTarget
   TNT1 A 0 A_PlaySound("AxeSwing")
   TRLA J 4 A_CustomMissile("TrollSlash",18, -13) //A_CustomMeleeAttack(38,"trolbam")//A_SargAttack
   TRLA KLMNOP 2
   Goto See

Melee2:
   TRAA AA 2 A_FaceTarget
   TRAA AABBCCDEFGHIJ 2 A_FaceTarget
   TNT1 A 0 A_PlaySound("AxeSwing")
   TRAA K 4 A_CustomMissile("TrollSlash",18, -13) //A_CustomMeleeAttack(38,"trolbam")//A_SargAttack
   TRAA LMNOP 2
   Goto See

Pain:
	//TNT1 A 0 A_PlaySound("sworbam")
    TRLA A 2 A_Pain
    Goto See

Death:
    TRLD A 1 A_Scream
    TRLD B 1 A_NoBlocking
    TRLD DEFGHIJKLMNOPQRSTUVWXYZ 1
	TRDD ABDEFGHIJKLMNOPQRSTUVWXYZ 1
	TRDD Z 680
    TRDD Z 1 A_Respawn
    Stop		
  }
}


Actor MoriaTroll2: MoriaTroll
{
  +NOBLOOD
  health 850
}

Actor BattleMoriaTroll : MoriaTroll
{
    Health 700

    States
    {
    Death:
	    TRLD A 1 A_Scream
		TRLD B 1 A_NoBlocking
		TRLD DEFGHIJKLMNOPQRSTUVWXYZ 1
		TRDD ABDEFGHIJKLMNOPQRSTUVWXYZ 1
		TRDD Z 680
		TRDD ZZZZZZZZZZZZZ 1 A_FadeOut (0.5)
		TNT1 A -1
        Stop
    }
}

Actor TrollRespawn : RandomSpawner replaces fatso
{
DropItem "MoriaTroll", 255, 255
DropItem "MoriaTroll2", 255, 255
}

///Ent
Actor Ent
{
  health 600
  Radius 29
  Height 45
  Speed 12
  mass 9999
  Monster
  +LOOKALLAROUND
  +NOBLOOD
  +FRIENDLY
  +RANDOMIZE
   +BOSS
   +DROPOFF
   
   DamageFactor "Gondor", 0
  States
  {
  Spawn:
    TRLA A 1
    TNT1 A 0 Thing_ChangeTID(0, 888)
    TRLA A 1 A_Look
    Loop

See:
    TRLL ABCDEFGHIJKLMNOPQRSTUVWXY 2 A_Chase
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 512, 512, 360, "See")
    Loop

Melee:
   TRLA AAABBBCDEFGHIJKLMN 1 A_FaceTarget
   TNT1 A 0 A_PlaySound("Swordswoosh")
   TRLA O 4 A_SargAttack
   TRLA PQRSTUVWXYZZZZ 2
   Goto See

Pain:
    TRLA A 2 A_Pain
    Goto See

Death:
    TRLD A 6 A_Scream
    TRLD B 5 A_NoBlocking
    TRLD DEFGHIJKLMNOPQRSTU 5
    TRLD U -1
    Stop		
  }
}

Actor TrollSlash
{
Speed 30
radius 5
Height 5
PROJECTILE
RenderStyle add
scale 0.5
Damage 7
DamageType "Mordor"
States
{
Spawn:
TNT1 A 1
Goto Death2

Death:
TNT1 A 1 A_PlaySound("trolbam")
Death2:
TNT1 A 1
Stop
}
}