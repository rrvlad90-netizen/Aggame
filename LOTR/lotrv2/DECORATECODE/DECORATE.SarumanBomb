Actor BBomb replaces ExplosiveBarrel
{
  Health 20
  Radius 10
  Height 42
  +SOLID
  +SHOOTABLE
  +NOBLOOD
  +ACTIVATEMCROSS
  +DONTGIB
  +NOICEDEATH
//  +OLDRADIUSDMG
//  DeathSound "world/barrelx"
  Obituary "Saruman bombs" // "%o went boom.
  States
  {
  Spawn:
    TRLA A 6
    Loop
  Death:
    TNT1 A 0 A_PlaySound("BBOOM")
    TRLA A 5 Bright 
    TRLA B 5 Bright A_CustomMissile("FireballExplosionFlamesBig")
    TRLA C 5 Bright A_Explode(1000,190)  //1 - damage, 2- distance 
    TNT1 A -1
    Stop
  }
}



