	See:
		GON2 FGHIJKLMNOPQRSTUVWXYZ 1 A_Chase //A_Chase("Melee", "Missile", CHF_NORANDOMTURN)
     		GON3 ABCD 1 A_Chase //A_Chase("Melee", "Missile", CHF_NORANDOMTURN)
		GON2 FGHIJKLMNOPQRSTUVWXYZ 1 A_Chase //A_Chase("Melee", "Missile", CHF_NORANDOMTURN)
     		GON3 ABCD 1 A_Chase //A_Chase("Melee", "Missile", CHF_NORANDOMTURN)
		TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 512, 0, 0, "See")
