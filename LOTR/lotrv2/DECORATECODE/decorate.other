		TNT1 A 0 A_ChangeFlag("Friendly", true)
		Goto Death
	Death:
		TNT1 A 1 A_NoBlocking
		TNT1 A 1 A_Fall
		TNT1 A 1 A_FadeOut
		TNT1 A -1
		Stop
		
	}
}





