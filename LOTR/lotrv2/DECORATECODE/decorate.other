		GON4 O 3 A_CustomMeleeAttack(random(7, 18)) //A_SargAttack
		GON4 PQRSTUVWXYZ 1
  		GON5 ABCDEFGHIJKL 1
		GON5 L 8
		GON5 L 1 A_ClearTarget
		GON5 L 1 A_Look
		//TNT1 A 0 A_TakeInventory("iseey", 1)
		Goto See
	Block:
		GON4 B 2 A_SetReflectiveInvulnerable
		GON4 B 29 A_CentaurDefend
		GON4 B 2 A_UnsetReflectiveInvulnerable
		Goto See
	Death:
		GON3 EFGHIJKLMNOPQRSTUVWXY 1
		GON3 Y 1 A_Scream
		GON3 Y 1 A_NoBlocking
		GON3 Y 380
		GON3 Y 1 A_FadeOut
		Stop
	}
}


