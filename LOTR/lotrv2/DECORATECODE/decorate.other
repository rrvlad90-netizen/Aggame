actor bossspawnernazgul replaces spidermastermind
{
	Health 99999
	Mass 9999
	Speed 0
	Height 1
	Radius 1
	+NOBLOOD
dropitem "NazgulBoss"
States
	{
	Spawn:
	        TNT1 A 0 NoDelay
		TNT1 A 1700
		TNT1 A 1700
		TNT1 A 1700
		TNT1 A 1700
		TNT1 A 1700
		TNT1 A 900
		Goto Death
	Death:
		TNT1 Y 1 A_NoBlocking
		TNT1 Y -1
		Stop
}
}


ACTOR NazgulBoss
{
	Health 1980
	Mass 175
	Speed 5
	Height 60
	Radius 12
	Monster
	+FLOORCLIP
        +DROPOFF
	//+TELESTOMP
	+SOLID
	+BOSS
	+NOTARGET
	+NORADIUSDMG
        +RANDOMIZE
	+LOOKALLAROUND
	+NOBLOOD
	MaxTargetRange 32
        ReactionTime 1
	PainChance 80
	SeeSound "nazgs"
	//PainSound "Orcdeath"
	//DeathSound "Orcdeath"
	//PainChance "isee", 255
	//DamageFactor "isee", 1
	States
	{
	Spawn:
	        TNT1 A 0 NoDelay
		ORC2 F 1 A_Look
		//TNT1 A 0 Thing_ChangeTID(0, 2700)
		//TNT1 A 0 Thing_Hate(0, 888, 0)
		ORC2 F 1 A_Look
		Goto spawn+4
	See:
		ORC2 FGHIJKLMNOPQRSTUVWXYZ 1 A_Chase //A_Chase("Melee", "Missile", CHF_NORANDOMTURN) //begut pryamo no eto ne nuzno, poskolky oni ocen typo s celyami rabotaut
     		ORC3 AB 1 A_Chase //CD    //A_Chase("Melee", "Missile", CHF_NORANDOMTURN)
		//TNT1 A 0 A_ClearTarget
		//TNT1 A 0 A_Look
		loop
	Pain:
//		TNT1 A 0 A_PlaySound("sworbam")
		ORC4 B 2 A_Recoil(2)
	 	ORC4 CDC 2 A_Pain
                TNT1 A 0 A_Jump(90, "Block")	
		Goto See


	//Pain.isee:
	//	TNT1 A 0 A_GiveInventory ("FF_Health",1)
//		Goto See

	Melee:
 		TNT1 A 0 A_Jump(80,"Scream")
 		TNT1 A 0 A_Jump(128,"MoveLeft")
  		TNT1 A 0 A_Jump(128,"MoveRight")
		ORC1 A 1 A_FaceTarget
		ORC1 BDFHJLN 1 A_FaceTarget
    		TNT1 A 0 A_PlaySound("AxeSwing")
		ORC1 O 3 A_CustomMeleeAttack(random(9, 21),"sworbam") //A_SargAttack
		ORC1 PQRSTUVWXYZ 1
  		ORC2 ABCDE 1
		Goto Melee2
        Melee2:
  		TNT1 A 0  A_Jump(80,"MoveBack")
		ORC4 A 1 A_FaceTarget
		ORC4 BDFHJLN 1 A_FaceTarget
    		TNT1 A 0 A_PlaySound("AxeSwing")
		ORC4 O 4 A_CustomMeleeAttack(random(15, 26),"sworbam") //A_SargAttack
		ORC4 PQRSTUVWXYZ 1
  		ORC5 ABCDEFGHIJKL 1
		ORC5 L 5
		//ORC5 L 1 A_ClearTarget
		//ORC5 L 1 A_Look
		Goto See //Block
	Scream:
		ORC1 Z 2 A_FaceTarget
		ORC2 A 1 A_PlaySound("nazgs")
		ORC5 B 2 A_Explode(40,50)
		ORC5 CCCC 5 A_FaceTarget
		ORC5 D 2 A_Explode(40,50)
		ORC5 CCCC 5 A_FaceTarget
		ORC5 D 2 A_Explode(40,50)
		ORC5 CCCC 5 A_FaceTarget
		ORC5 DE 2 A_FaceTarget
		Goto See

	MoveLeft:
  		TNT1 A 0  ThrustThing(angle*22,4,0,0)
		goto See

	MoveRight:
  		TNT1 A 0  ThrustThing(angle*22,4,0,0)
		goto See
	Block:
		TNT1 A 0 A_Jump(90, "See")
		ORC4 B 2 A_SetReflectiveInvulnerable
		ORC4 B 29 A_CentaurDefend
		ORC4 B 2 A_UnsetReflectiveInvulnerable
		Goto See

	MoveBack:
		TNT1 A 0 A_Recoil(1)
  		TNT1 A 0 A_Jump(150,"MoveBackwardandRight")
  		TNT1 A 0 A_Jump(150,"MoveBackwardandLeft")
		Goto See

	MoveBackwardandRight:
		TNT1 A 0 A_Recoil(1)
  		TNT1 A 0 ThrustThing(angle*22,4,0,0)
		goto See

	MoveBackwardandLeft:
		TNT1 A 0 A_Recoil(1)
  		TNT1 A 0 ThrustThing(angle*22,4,0,0)
		goto See
	Death:
		ORC3 EFGHIJKLMNOPQRSTUVWXY 1
		ORC3 Y 1 A_Scream
		ORC3 Y 1 A_NoBlocking
		ORC3 Y 1 A_BrainDie
		Stop
	}
}


Actor Troll
{
  health 650
  Radius 29
  Height 45
  Speed 7
  mass 9999
  Monster
  +LOOKALLAROUND
  +NOTARGET
  +DROPOFF
  +RANDOMIZE
  +NOBLOOD
   +BOSS
SeeSound "trollsee"
PainSound "troll"
DeathSound "troll"
  States
  {
  Spawn:
    TRLA A 1
    TNT1 A 0 Thing_ChangeTID(0, 2700)
    TRLA A 1 A_Look
    Loop

See:
    TRLL ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_Chase
	TRL1 ABCDEFGHIJKLMN 1 A_Chase
    TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 512, 512, 360, "See")
    Loop

Melee:
   TNT1 A 0 A_Jump(128,"Melee2")
   TRLA AAAABBBCCDEFGHIJKLMN 1 A_FaceTarget
   TNT1 A 0 A_PlaySound("Swordswoosh")
   TRLA O 4 A_SargAttack
   TRLA PQRSTUVWXYZZZ 2
   Goto See

Melee2:
   TRAA AAAABBBCCDEFGHIJKLMNOP 1 A_FaceTarget
   TNT1 A 0 A_PlaySound("Swordswoosh")
   TRAA Q 4 A_SargAttack
   TRAA STUVWXYZZZ 2
   Goto See

Pain:
//	TNT1 A 0 A_PlaySound("sworbam")
    TRLA A 2 A_Pain
    Goto See

Death:
    TRLD A 6 A_Scream
    TRLD B 5 A_NoBlocking
    TRLD DEFGHIJKLMNOPQRSTU 5
    TRLD U 600
    TRLD UUUUUUUUUUUUUUU 2 A_FadeOut
    Stop		
  }
}



ACTOR OrcArcher replaces chaingunguy
{  
  Monster
+SOLID     //you cannot push this monster
  +NOBLOOD
  +FLOORCLIP
        +RANDOMIZE
  +LOOKALLAROUND
+SOLID
speed 1
PainChance 255
Health 45
  Radius 18 //22
  Height 60
  Mass 99999 
  SeeSound "null"
  AttackSound "null"
  PainSound "null"
  ActiveSound "null"

//DropItem "SkyrimArrow", 84, 5
Reactiontime 1
States
  {

//-------
 Spawn:
    MES1 A 2 //A_Look
    TNT1 A 0 Thing_Hate(0, 888, 0)
    MES1 AAAAAAAA 2 A_LookEx(0, 0, 2048, 2048, 360, "See")
    Goto Spawn+3

  See:
    TNT1 A 0 A_ChangeFlag("NOTARGET", true)
    //MES1 A 1 A_ClearTarget
    MES1 AAAAAAAAAAAAAA 2 A_Chase("Missile", "Missile",CHF_DONTMOVE)
    Goto See

//  Missile:
//    TNT1 A 0 A_JumpIfCloser(1200, "Missile2")
//MES1 A 1 A_ClearTarget
//    Goto See


  Missile:
  //Missile:
	MES1 A 30
       TNT1 A 0 A_PlaySound("BOWREADY")
	MES1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_FaceTarget
	MES2 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_FaceTarget
	TNT1 A 0 A_PlaySound("ArrowSwing")
        MES2 Z 2 A_CustomMissile("ArrowProj2")//A_CustomBulletAttack(2, 2, 1, 2)
	MES3 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_FaceTarget
        MES4 AB 1 A_FaceTarget
        //MES4 AB 1 A_CPosRefire
	Goto See
Pain:
  TNT1 A 0 A_PlaySound("sworbam")
  MES1 A 1 A_Pain
Goto See

  Death:
		GON3 EFGHIJKLMNOPQRSTUVWXY 1
		GON3 Y 1 A_Scream
		GON3 Y 1 A_NoBlocking
		GON3 Y 380
		GON3 Y 1 A_FadeOut
		Stop

 }
}



