		VAT1 BCDFHJKLMNOPQ 1 Fast A_FaceTarget //BCDEFGHIJKLMN 1 A_FaceTarget
    	TNT1 R 0 A_PlaySound("AxeSwing")
		VAT1 R 5 Fast A_CustomMissile("OrcSlash1",18, -13) //A_CustomMeleeAttack(random(11, 18),"sworbam") //A_SargAttack
		VAT1 STUVWXZ 1 Fast
		VA11 ABCDEFGHIJKLM 1 Fast
		Goto See
		
		
				
    Melee2:
		VAT2 AA 3 Fast A_FaceTarget
		VAT2 BCDEFGH 1 Fast A_FaceTarget
    	TNT1 A 0 A_PlaySound("AxeSwing")
		VAT2 H 9 Fast A_CustomMissile("OrcSlash1",18, -13) //A_CustomMeleeAttack(random(16, 22),"sworbam") 
		VAT2 IJKLMNOPQRSTUVWXYZ 1 Fast
		VAA2 ABCDEFG 1 Fast 		
		Goto See
		
