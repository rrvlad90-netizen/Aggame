		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(11)
		VNDD ABC 1
		VNDD D 1 A_Scream
		VNDD E 1 A_NoBlocking
		VNDD FGHIJKLMNOPQRSTU 1
		VNDD U 380
		VNDD U 1 A_FadeOut
		Stop
		
    Diss: 
    TNT1 A 0 GiveInventory("ASpan",1)
    TNT1 A 5 A_ClearTarget
    TNT1 A 5 A_Respawn
    Stop
	}
}


