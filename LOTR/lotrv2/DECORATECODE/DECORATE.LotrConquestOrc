   		Loop

	//See2:
	//	OCR1 AABBCCBBAABBCCBB 1 Fast A_Chase
	//	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 256, 0, 0, "NewSee")
   	//	Goto See
	
		
	Pain:
//		TNT1 A 0 A_PlaySound("sworbam")
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(6)
	 	VNDD AABCCCBAA 2 A_Pain
//       		TNT1 A 0 A_Jump(90, "Block")	
		Goto See
	
	Pain.iseeyou:
		TNT1 A 0 A_GiveInventory ("FF_Health",1)
		Goto See	
		        

/*		
	Pain.iamplayerr:
			TNT1 A 0 A_Giveinventory("HatePlayer",1)
			TNT1 A 0 A_Recoil(6)	
			 VNDD ABCBA 2 Fast A_Pain
			 TNT1 A 0 A_Jump(90, "Block")	
	SeekPlayer:		 
		TNT1 A 0 Thing_Hate(0, 0, 0)
		TNT1 A 0 A_Look//Ex(LOF_NOSOUNDCHECK, 0, 256, 0, 0, "See")
		TNT1 A 0 A_ClearTarget
		Goto See
		*/
		
		
	Melee:
		TNT1 A 0 A_Jump(98, "Melee2")
