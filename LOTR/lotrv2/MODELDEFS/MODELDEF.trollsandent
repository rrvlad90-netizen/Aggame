   Model 0 "trollatt2.md3"
   Skin 0 "BattleTrollBody.jpg"
   Model 1 "troll2att2.md3"
   Skin 1 "TrollBulava.jpg"
   
// PITCHFROMMOMENTUM // A flag that will fix the model pitch for projectiles  
   Scale 1.22 1.22 1.22
//    Offset 0.0 0.0 -11.0
//    USEACTORROLL
//	USEACTORPITCH
//	SCALEWEAPONFOV
	
//die
FrameIndex TRLD A 0 0 FrameIndex TRLD A 1 0
FrameIndex TRLD B 0 1 FrameIndex TRLD B 1 1
FrameIndex TRLD C 0 2 FrameIndex TRLD C 1 2
FrameIndex TRLD D 0 3 FrameIndex TRLD D 1 3
