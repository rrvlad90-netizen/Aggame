//Troll
Model MoriaTroll
{
   Path "models/troll"
   Model 0 "trollrun.md3"
   Skin 0 "troll.png"
   Model 1 "trollweaponrun.md3"
   Skin 1 "StoneDark.png"
   
// PITCHFROMMOMENTUM // A flag that will fix the model pitch for projectiles  
   Scale 1.22 1.22 1.22
//      Offset 0.0 0.0 -11.0
//    USEACTORROLL
//	USEACTORPITCH
//	SCALEWEAPONFOV
	
//run  
FrameIndex TRLL A 0 0  FrameIndex TRLL A 1 0
FrameIndex TRLL B 0 1  FrameIndex TRLL B 1 1
FrameIndex TRLL C 0 2  FrameIndex TRLL C 1 2
FrameIndex TRLL D 0 3  FrameIndex TRLL D 1 3
