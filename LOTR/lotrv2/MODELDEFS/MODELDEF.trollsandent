//Troll
Model MoriaTroll
{
   Path "models/troll"
   Model 0 "trollwalk.md3"
   Skin 0 "BattleTrollBody.jpg"
   Model 1 "troll2walk.md3"
   Skin 1 "TrollBulava.jpg"
   
// PITCHFROMMOMENTUM // A flag that will fix the model pitch for projectiles  
   Scale 1.22 1.22 1.22
//      Offset 0.0 0.0 -11.0
//    USEACTORROLL
//	USEACTORPITCH
//	SCALEWEAPONFOV
	
//run  
FrameIndex TRLL A 0 0  FrameIndex TRLL A 1 0
FrameIndex TRLL B 0 1  FrameIndex TRLL B 1 1
FrameIndex TRLL C 0 2  FrameIndex TRLL C 1 2
FrameIndex TRLL D 0 3  FrameIndex TRLL D 1 3
FrameIndex TRLL E 0 4  FrameIndex TRLL E 1 4
FrameIndex TRLL F 0 5  FrameIndex TRLL F 1 5
FrameIndex TRLL G 0 6  FrameIndex TRLL G 1 6
FrameIndex TRLL H 0 7  FrameIndex TRLL H 1 7
FrameIndex TRLL I 0 8  FrameIndex TRLL I 1 8
FrameIndex TRLL J 0 9  FrameIndex TRLL J 1 9
FrameIndex TRLL K 0 10  FrameIndex TRLL K 1 10
FrameIndex TRLL L 0 11  FrameIndex TRLL L 1 11
FrameIndex TRLL M 0 12  FrameIndex TRLL M 1 12
}


