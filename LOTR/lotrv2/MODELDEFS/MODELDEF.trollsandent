//Ent
Model Ent
{
   Path "models/ent"
   Model 0 "entbodyrun.md3"
   Skin 0 "enttexture.png"
   Model 1 "entlegsrun.md3"
   Skin 1 "enttexture.png"
   
// PITCHFROMMOMENTUM // A flag that will fix the model pitch for projectiles  
   Scale 2.10 2.10 2.10
      Offset 0.0 0.0 -11.0
//   USEACTORROLL
//	USEACTORPITCH
//	SCALEWEAPONFOV
	
//run  
FrameIndex TRLL A 0 0 FrameIndex TRLL A 1 0
FrameIndex TRLL B 0 1 FrameIndex TRLL B 1 1
FrameIndex TRLL C 0 2 FrameIndex TRLL C 1 2
