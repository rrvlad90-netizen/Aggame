
Model LeperMonk // Name of actor in DECORATE
{
	Path "Models/LeperMonk"
	MODEL 0 "LeperMonk_Body.md3"
	MODEL 1 "LeperMonk_Weapon.md3"
	Scale 0.5 0.5 0.5
	INTERPOLATEDOUBLEDFRAMES

	FrameIndex IDLE A 0 0 FrameIndex IDLE A 1 0

	FrameIndex SHOT A 0 0 FrameIndex SHOT A 1 0
	FrameIndex SHOT B 0 1 FrameIndex SHOT B 1 1
	FrameIndex SHOT C 0 2 FrameIndex SHOT C 1 2
	FrameIndex SHOT D 0 3 FrameIndex SHOT D 1 3
	FrameIndex SHOT E 0 4 FrameIndex SHOT E 1 4
	FrameIndex SHOT F 0 0 FrameIndex SHOT F 1 0

	FrameIndex PAIN A 0 5 FrameIndex PAIN A 1 5
	FrameIndex PAIN B 0 6 FrameIndex PAIN B 1 6
	FrameIndex PAIN C 0 7 FrameIndex PAIN C 1 7
	FrameIndex PAIN D 0 8 FrameIndex PAIN D 1 8
	FrameIndex PAIN E 0 0 FrameIndex PAIN E 1 0

	FrameIndex WALK A 0 9 FrameIndex WALK A 1 9
	FrameIndex WALK B 0 10 FrameIndex WALK B 1 10
	FrameIndex WALK C 0 11 FrameIndex WALK C 1 11
	FrameIndex WALK D 0 12 FrameIndex WALK D 1 12
	FrameIndex WALK E 0 13 FrameIndex WALK E 1 13
	FrameIndex WALK F 0 14 FrameIndex WALK F 1 14
	FrameIndex WALK G 0 15 FrameIndex WALK G 1 15
	FrameIndex WALK H 0 16 FrameIndex WALK H 1 16
	FrameIndex WALK I 0 17 FrameIndex WALK I 1 17
	FrameIndex WALK J 0 18 FrameIndex WALK J 1 18
	FrameIndex WALK K 0 19 FrameIndex WALK K 1 19

/*
