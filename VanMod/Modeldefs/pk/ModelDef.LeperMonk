	FrameIndex THRW E 0 28 FrameIndex THRW E 1 28
	FrameIndex THRW F 0 29 FrameIndex THRW F 1 29
	FrameIndex THRW G 0 30 FrameIndex THRW G 1 30
	FrameIndex THRW H 0 31 FrameIndex THRW H 1 31
	FrameIndex THRW I 0 32 FrameIndex THRW I 1 32
	FrameIndex THRW J 0 33 FrameIndex THRW J 1 33
	FrameIndex THRW K 0 34 FrameIndex THRW K 1 34

	MODEL 1 ""	// Disable weapon mesh for leper monk

	FrameIndex THRW L 0 35 FrameIndex THRW L 1 35

	MODEL 0 "LeperMonk_Dead.md3"

	FrameIndex DEAD A 0 0
	FrameIndex DEAD B 0 1
	FrameIndex DEAD C 0 2
	FrameIndex DEAD D 0 3
	FrameIndex DEAD E 0 4
	FrameIndex DEAD F 0 5
	FrameIndex DEAD G 0 6
	FrameIndex DEAD H 0 7
	FrameIndex DEAD I 0 8
	FrameIndex DEAD J 0 9
	FrameIndex DEAD K 0 10
