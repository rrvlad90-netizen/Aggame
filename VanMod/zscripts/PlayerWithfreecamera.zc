#include "zscripts/StepEventHandler.zc"
#include "zscripts/nashmove.zc"


class Kinv : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


class Jmp : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


class Jmp2 : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


class VanFireLock : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


// ============================================================
// ВИЗУАЛЬНЫЕ ЧАСТИ
// ============================================================

class VanVisualPart : Actor
{
	Default
	{
		Radius 1;
		Height 1;

		RenderStyle "Normal";
		Alpha 1.0;

		+NOBLOCKMAP;
		+NOINTERACTION;
		+NOGRAVITY;
		+NOCLIP;
	}

	override void Tick()
	{
		Super.Tick();

		if (Master == null)
			Destroy();
	}
}


class VanVisualLegs : VanVisualPart
{
	States
	{
	Spawn:
	Stand:
		VLST A 1;
		Loop;

	RunForward:
		VLFW ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunBack:
		VLBK ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunLeft:
		VLLF ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunRight:
		VLRT ABCDEFGHIJKLMNOPQR 1;
		Loop;

	// Во время атаки, удара, прыжка и смерти
	// Sprite/Frame копируются из PlayerPawn.
	ActionHold:
		TNT1 A -1;
		Stop;
	}
}


class VanVisualBody : VanVisualPart
{
	States
	{
	Spawn:
	Stand:
		VBST A 1;
		Loop;

	Run:
		VBRN ABCDEFGHIJKLMNOPQR 1;
		Loop;

	ActionHold:
		TNT1 A -1;
		Stop;
	}
}


// ============================================================
// КАМЕРА
// ============================================================

class VanThirdPersonCamera : Actor
{
	Default
	{
		Radius 1;
		Height 1;

		+NOBLOCKMAP;
		+NOINTERACTION;
		+NOGRAVITY;
		+NOCLIP;
		+INVISIBLE;
	}

	override void Tick()
	{
		Super.Tick();

		if (Master == null)
			Destroy();
	}

	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}
}


// ============================================================
// ИГРОК
// ============================================================

class Van : PlayerPawn
{
	const MODE_FREE   = 0;
	const MODE_FIRE   = 1;
	const MODE_MELEE  = 2;
	const MODE_JUMP   = 3;
	const MODE_DEATH  = 4;
	const MODE_LAND   = 5;
	const MODE_PAIN   = 6;

	int VanMode;

	Actor ThirdPersonCamera;
	Actor VisualLegs;
	Actor VisualBody;

	bool CameraInitialized;
	bool JumpWasPressed;
	bool UsingActionVisuals;

	int CurrentLegsAnimation;
	int CurrentBodyAnimation;

	double CameraYaw;
	double BodyYaw;
	double LastBodyYaw;

	double CameraDistance;
	double CameraHeight;
	double CameraSide;
	double CameraWallGap;

	Default
	{
		Health 100;
		Radius 16;
		Height 56;
		Mass 300;
		PainChance 255;

		Speed 0.55;

		+NOBLOOD;
		+NOSKIN;
		+NOICEDEATH;

		// Физический PlayerPawn невидим.
		RenderStyle "None";

		Player.ForwardMove 0.49, 0.49;
		Player.SideMove 0.49, 0.49;

		Player.JumpZ 8.0;
		Player.ViewHeight 48;
		Player.MaxHealth 100;

		Player.DisplayName "VanH";

		Player.StartItem "Shell", 48;
		Player.StartItem "Shotgun2";

		Player.WeaponSlot 1, "Shotgun2";

		Player.ColorRange 225, 240;
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		CameraDistance = 106.0;
		CameraHeight = 68.0;
		CameraSide = 0.0;
		CameraWallGap = 4.0;

		CameraYaw = Angle;
		BodyYaw = Angle;
		LastBodyYaw = Angle;

		CurrentLegsAnimation = -1;
		CurrentBodyAnimation = -1;

		ThirdPersonCamera = Spawn(
			"VanThirdPersonCamera",
			Pos
		);

		if (ThirdPersonCamera != null)
			ThirdPersonCamera.Master = self;


		VisualLegs = Spawn(
			"VanVisualLegs",
			Pos
		);

		if (VisualLegs != null)
			VisualLegs.Master = self;


		VisualBody = Spawn(
			"VanVisualBody",
			Pos
		);

		if (VisualBody != null)
			VisualBody.Master = self;

		CameraInitialized = true;
	}


	bool IsActionMode()
	{
		return VanMode == MODE_FIRE ||
			VanMode == MODE_MELEE ||
			VanMode == MODE_JUMP ||
			VanMode == MODE_LAND ||
			VanMode == MODE_DEATH;
	}


	bool IsVanInputLocked()
	{
		return VanMode == MODE_FIRE ||
			VanMode == MODE_MELEE ||
			VanMode == MODE_JUMP ||
			VanMode == MODE_LAND ||
			VanMode == MODE_PAIN ||
			FindInventory("VanFireLock") != null ||
			FindInventory("Kinv") != null;
	}


	bool ShouldStopVanVelocity()
	{
		// MODE_JUMP здесь намеренно отсутствует.
		// В воздухе сохраняется начальный импульс,
		// но изменить его клавишами нельзя.
		return VanMode == MODE_FIRE ||
			VanMode == MODE_MELEE ||
			VanMode == MODE_LAND ||
			VanMode == MODE_PAIN ||
			FindInventory("VanFireLock") != null ||
			FindInventory("Kinv") != null;
	}


	void SyncVisualPart(Actor part)
	{
		if (part == null)
			return;

		part.SetOrigin(Pos, true);

		part.Angle = BodyYaw;
		part.Pitch = 0;
		part.Roll = 0;

		part.Scale = Scale;
		part.FloorClip = FloorClip;
		part.Translation = 0;
		part.Alpha = 1.0;
	}


	void SetLegsAnimation(int animation)
	{
		if (VisualLegs == null ||
			CurrentLegsAnimation == animation)
		{
			return;
		}

		CurrentLegsAnimation = animation;

		switch (animation)
		{
		case 1:
			VisualLegs.SetStateLabel("RunForward");
			break;

		case 2:
			VisualLegs.SetStateLabel("RunBack");
			break;

		case 3:
			VisualLegs.SetStateLabel("RunLeft");
			break;

		case 4:
			VisualLegs.SetStateLabel("RunRight");
			break;

		default:
			VisualLegs.SetStateLabel("Stand");
			break;
		}
	}


	void SetBodyAnimation(int animation)
	{
		if (VisualBody == null ||
			CurrentBodyAnimation == animation)
		{
			return;
		}

		CurrentBodyAnimation = animation;

		if (animation == 1)
			VisualBody.SetStateLabel("Run");
		else
			VisualBody.SetStateLabel("Stand");
	}


	void BeginActionVisuals()
	{
		if (UsingActionVisuals)
			return;

		UsingActionVisuals = true;

		CurrentLegsAnimation = -1;
		CurrentBodyAnimation = -1;

		if (VisualLegs != null)
			VisualLegs.SetStateLabel("ActionHold");

		if (VisualBody != null)
			VisualBody.SetStateLabel("ActionHold");
	}


	void CopyActionFrames()
	{
		BeginActionVisuals();

		if (VisualLegs != null)
		{
			VisualLegs.Sprite = Sprite;
			VisualLegs.Frame = Frame;
		}

		if (VisualBody != null)
		{
			VisualBody.Sprite = Sprite;
			VisualBody.Frame = Frame;
		}
	}


	void UpdateVanVisuals()
	{
		SyncVisualPart(VisualLegs);
		SyncVisualPart(VisualBody);

		if (IsActionMode())
		{
			CopyActionFrames();
			return;
		}

		if (UsingActionVisuals)
		{
			UsingActionVisuals = false;

			CurrentLegsAnimation = -1;
			CurrentBodyAnimation = -1;
		}

		if (VanMode == MODE_PAIN)
		{
			SetLegsAnimation(0);
			SetBodyAnimation(0);
			return;
		}

		double forward = 0;
		double side = 0;

		if (player != null)
		{
			forward = player.cmd.forwardmove;
			side = player.cmd.sidemove;
		}

		int legsAnimation = 0;

		// Для диагонального движения вперёд/назад
		// имеют приоритет над боковым движением.
		if (forward > 0)
			legsAnimation = 1;
		else if (forward < 0)
			legsAnimation = 2;
		else if (side < 0)
			legsAnimation = 3;
		else if (side > 0)
			legsAnimation = 4;

		SetLegsAnimation(legsAnimation);

		if (legsAnimation == 0)
			SetBodyAnimation(0);
		else
			SetBodyAnimation(1);
	}


	void UpdateVanCamera()
	{
		if (player == null ||
			ThirdPersonCamera == null)
		{
			return;
		}

		player.camera = ThirdPersonCamera;

		double backX =
			-cos(CameraYaw) * CameraDistance;

		double backY =
			-sin(CameraYaw) * CameraDistance;

		double sideX =
			cos(CameraYaw - 90) * CameraSide;

		double sideY =
			sin(CameraYaw - 90) * CameraSide;

		double offsetX = backX + sideX;
		double offsetY = backY + sideY;

		double wantedDistance = sqrt(
			offsetX * offsetX +
			offsetY * offsetY
		);

		double cameraDirection =
			atan2(offsetY, offsetX);

		double realDistance = wantedDistance;

		if (wantedDistance > 0)
		{
			FLineTraceData trace;

			bool blocked = LineTrace(
				cameraDirection,
				wantedDistance,
				0,
				TRF_THRUACTORS,
				CameraHeight,
				0,
				0,
				trace
			);

			if (blocked &&
				trace.Distance < realDistance)
			{
				realDistance = max(
					8.0,
					trace.Distance - CameraWallGap
				);
			}
		}

		Vector3 cameraPosition = Pos;

		cameraPosition.X +=
			cos(cameraDirection) * realDistance;

		cameraPosition.Y +=
			sin(cameraDirection) * realDistance;

		cameraPosition.Z += CameraHeight;

		ThirdPersonCamera.SetOrigin(
			cameraPosition,
			true
		);

		ThirdPersonCamera.Angle = CameraYaw;
		ThirdPersonCamera.Pitch = Pitch;
		ThirdPersonCamera.Roll = Roll;
	}


	override void Tick()
	{
		bool startJump = false;
		bool attackLocked = false;

		if (player != null)
		{
			if (VanMode != MODE_JUMP &&
				VanMode != MODE_LAND &&
				VanMode != MODE_DEATH &&
				VanMode != MODE_PAIN)
			{
				if (FindInventory("Kinv") != null)
					VanMode = MODE_MELEE;
				else if (
					FindInventory("VanFireLock") != null)
				{
					VanMode = MODE_FIRE;
				}
			}

			attackLocked =
				VanMode == MODE_FIRE ||
				VanMode == MODE_MELEE ||
				FindInventory("VanFireLock") != null ||
				FindInventory("Kinv") != null;

			if (attackLocked ||
				VanMode == MODE_LAND ||
				VanMode == MODE_PAIN)
			{
				JumpZ = 0;
			}
			else
			{
				JumpZ = 8.0;
			}

			bool jumpPressed =
				(player.cmd.buttons & BT_JUMP) != 0;

			bool attackPressed =
				(player.cmd.buttons &
					(BT_ATTACK | BT_ALTATTACK)) != 0;

			startJump =
				jumpPressed &&
				!JumpWasPressed &&
				!attackPressed &&
				player.onground &&
				Health > 0 &&
				VanMode == MODE_FREE &&
				!attackLocked;

			JumpWasPressed = jumpPressed;

			player.cmd.buttons &= ~BT_CROUCH;

			if (attackLocked ||
				VanMode == MODE_LAND ||
				VanMode == MODE_PAIN)
			{
				player.cmd.buttons &= ~BT_JUMP;
			}

			if (VanMode == MODE_JUMP ||
				VanMode == MODE_LAND ||
				FindInventory("Jmp2") != null)
			{
				player.cmd.buttons &=
					~(BT_ATTACK | BT_ALTATTACK);
			}

			if (!CameraInitialized)
			{
				CameraYaw = Angle;
				BodyYaw = Angle;
				LastBodyYaw = Angle;

				CameraInitialized = true;
			}
			else
			{
				CameraYaw += Angle - LastBodyYaw;
			}

			Angle = CameraYaw;

			if (IsVanInputLocked())
			{
				player.cmd.forwardmove = 0;
				player.cmd.sidemove = 0;
			}

			if (ShouldStopVanVelocity())
			{
				Vel.X = 0;
				Vel.Y = 0;
			}
		}

		Super.Tick();

		if (player == null)
			return;

		attackLocked =
			VanMode == MODE_FIRE ||
			VanMode == MODE_MELEE ||
			FindInventory("VanFireLock") != null ||
			FindInventory("Kinv") != null;

		if (attackLocked)
		{
			JumpZ = 0;

			if (Vel.Z > 0)
			{
				Vel.Z = 0;

				if (Pos.Z > FloorZ &&
					Pos.Z <= FloorZ + 4.0)
				{
					Vector3 correctedPosition = Pos;
					correctedPosition.Z = FloorZ;

					SetOrigin(
						correctedPosition,
						true
					);
				}
			}

			startJump = false;
		}
		else if (VanMode != MODE_LAND &&
			VanMode != MODE_PAIN)
		{
			JumpZ = 8.0;
		}

		if (startJump)
		{
			if (Vel.Z <= 0)
				Vel.Z = 8.0;

			VanMode = MODE_JUMP;
			BodyYaw = CameraYaw;

			GiveInventory("Jmp", 1);
			GiveInventory("Jmp2", 1);

			SetStateLabel("Jump");
		}

		if (ShouldStopVanVelocity())
		{
			Vel.X = 0;
			Vel.Y = 0;
		}

		// В свободном режиме модель следует за камерой.
		// Во время действий направление зафиксировано.
		if (VanMode == MODE_FREE)
			BodyYaw = CameraYaw;

		Angle = CameraYaw;
		LastBodyYaw = CameraYaw;

		UpdateVanVisuals();
		UpdateVanCamera();
	}


	action void A_SetVanMode(int mode)
	{
		invoker.VanMode = mode;
	}


	action void A_SetVanFreeIfUnlocked()
	{
		if (invoker.VanMode == MODE_DEATH ||
			invoker.VanMode == MODE_JUMP ||
			invoker.VanMode == MODE_LAND ||
			invoker.VanMode == MODE_PAIN)
		{
			return;
		}

		if (invoker.FindInventory(
				"VanFireLock") != null)
		{
			invoker.VanMode = MODE_FIRE;
			return;
		}

		if (invoker.FindInventory("Kinv") != null)
		{
			invoker.VanMode = MODE_MELEE;
			return;
		}

		invoker.VanMode = MODE_FREE;
	}


	action State A_SelectVanAttack()
	{
		if (invoker.VanMode == MODE_JUMP ||
			invoker.FindInventory("Jmp2") != null)
		{
			if (invoker.player != null &&
				invoker.player.onground)
			{
				return invoker.ResolveState(
					"SpawnLand"
				);
			}

			return invoker.ResolveState("JumpAir");
		}

		bool wantsMelee =
			invoker.FindInventory("Kinv") != null;

		if (invoker.player != null &&
			(invoker.player.cmd.buttons &
				BT_ALTATTACK) != 0)
		{
			wantsMelee = true;
		}

		invoker.BodyYaw = invoker.CameraYaw;

		if (wantsMelee)
		{
			invoker.VanMode = MODE_MELEE;
			return invoker.ResolveState("Kick");
		}

		invoker.VanMode = MODE_FIRE;
		return null;
	}


	action State A_WaitForVanFireEnd()
	{
		if (invoker.FindInventory(
				"VanFireLock") != null)
		{
			invoker.VanMode = MODE_FIRE;
			return null;
		}

		invoker.VanMode = MODE_FREE;
		return invoker.ResolveState("Spawn");
	}


	action State A_WaitForVanMeleeEnd()
	{
		if (invoker.FindInventory("Kinv") != null)
		{
			invoker.VanMode = MODE_MELEE;
			return null;
		}

		invoker.VanMode = MODE_FREE;
		return invoker.ResolveState("Spawn");
	}


	action void A_StartVanJump()
	{
		invoker.VanMode = MODE_JUMP;
		invoker.BodyYaw = invoker.CameraYaw;

		invoker.GiveInventory("Jmp", 1);
		invoker.GiveInventory("Jmp2", 1);
	}


	action State A_CheckVanLanding()
	{
		if (invoker.player != null &&
			invoker.player.onground)
		{
			return invoker.ResolveState(
				"SpawnLand"
			);
		}

		return null;
	}


	action void A_FinishVanJump()
	{
		invoker.TakeInventory("Jmp", 1);
		invoker.TakeInventory("Jmp2", 1);

		invoker.VanMode = MODE_FREE;
	}


	action void A_StartVanPain()
	{
		invoker.VanMode = MODE_PAIN;
		invoker.BodyYaw = invoker.CameraYaw;
	}


	action void A_FinishVanPain()
	{
		invoker.VanMode = MODE_FREE;
	}


	action void A_StartVanDeath()
	{
		invoker.VanMode = MODE_DEATH;

		invoker.TakeInventory("Jmp", 1);
		invoker.TakeInventory("Jmp2", 1);
		invoker.TakeInventory("Kinv", 1);
		invoker.TakeInventory("VanFireLock", 1);
	}


	States
	{
	Spawn:
		TNT1 A 1 A_SetVanFreeIfUnlocked;
		Loop;

	See:
		TNT1 A 1 A_SetVanFreeIfUnlocked;
		Loop;


	Melee:
	Missile:
		TNT1 A 0 A_SelectVanAttack;

		// body_attack.md3.
		VAT1 A 1;
		VAT1 A 3;
		VAT1 ABCDEEDCBA 2 Fast;
		VAT1 A 8;

	FireWait:
		VAT1 A 1 A_WaitForVanFireEnd;
		Loop;


	Kick:
		TNT1 A 0 A_SetVanMode(MODE_MELEE);

		// body_kick.md3 + legs_kick.md3.
		VANK ABCDEFGHIJKLMNOPQR 1 Fast;
		VKAN ABCDEFGHIJ 1 Fast;

	MeleeWait:
		VKAN J 1 A_WaitForVanMeleeEnd;
		Loop;


	Jump:
		TNT1 A 0 A_StartVanJump;

		// Начало прыжка.
		VJNK ABCDEFGHIJKLMNOPQ 1 Fast;

	JumpAir:
		// Кадр полёта.
		VJNK R 1 A_CheckVanLanding;
		Wait;

	SpawnLand:
		TNT1 A 0 A_SetVanMode(MODE_LAND);

		// Приземление.
		VAJK ABCDEFGHIJ 1 Fast;

		TNT1 A 0 A_FinishVanJump;
		Goto Spawn;


	Pain:
		TNT1 A 0 A_StartVanPain;
		TNT1 A 1 A_Pain;
		TNT1 A 8;
		TNT1 A 0 A_FinishVanPain;
		Goto Spawn;


	Death:
		TNT1 A 0 A_StartVanDeath;
		TNT1 A 0 A_Stop;

		// body_die.md3 + legs_die.md3.
		VNDD A 3;
		VNDD B 3 A_PlayerScream;
		VNDD C 3 A_NoBlocking;
		VNDD DEFGHIJ 3;
		VNDD J -1;
		Stop;

	XDeath:
		Goto Death;

	AltSkinDeath:
		Goto Death;

	AltSkinXDeath:
		Goto Death;
	}
}