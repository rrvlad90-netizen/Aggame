// ============================================================
// СЛУЖЕБНЫЙ INVENTORY
// ============================================================

class Kinv : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


class Jmp : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


class Jmp2 : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


class VanFireLock : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


// Запрос перехода Fire -> Kick.
class VanKickRequest : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


// Сообщает оружию, что игрок находится в Pain.
class VanPainLock : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


// ============================================================
// ВИЗУАЛЬНЫЕ ЧАСТИ
// ============================================================

class VanVisualPart : Actor
{
	Default
	{
		Radius 1;
		Height 1;

		RenderStyle "Normal";
		Alpha 1.0;

		+NOBLOCKMAP;
		+NOINTERACTION;
		+NOGRAVITY;
		+NOCLIP;
	}

	override void Tick()
	{
		Super.Tick();

		if (Master == null)
			Destroy();
	}
}


class VanVisualLegs : VanVisualPart
{
	States
	{
	Spawn:
	Stand:
		VLST A 1;
		Loop;

	RunForward:
		VLFW ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunBack:
		VLBK ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunLeft:
		VLLF ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunRight:
		VLRT ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunLeftBack:
		VLLB ABCDEFGHIJKLMNOPQR 1;
		Loop;

	RunRightBack:
		VLRB ABCDEFGHIJKLMNOPQR 1;
		Loop;


	// --------------------------------------------------------
	// ПРИСЕД
	// --------------------------------------------------------

	CrouchStand:
		VCST A 1;
		Loop;

	CrouchForward:
		VCFW ABCDEFGHIJKLMNOPQR 1;
		Loop;

	CrouchBack:
		VCBK ABCDEFGHIJKLMNOPQR 1;
		Loop;

	CrouchLeft:
		VCLF ABCDEFGHIJKLMNOPQR 1;
		Loop;

	CrouchRight:
		VCRT ABCDEFGHIJKLMNOPQR 1;
		Loop;

	CrouchLeftBack:
		VCLB ABCDEFGHIJKLMNOPQR 1;
		Loop;

	CrouchRightBack:
		VCRB ABCDEFGHIJKLMNOPQR 1;
		Loop;


	ActionHold:
		TNT1 A -1;
		Stop;
	}
}


class VanVisualBody : VanVisualPart
{
	States
	{
	Spawn:
	Stand:
		VBST A 1;
		Loop;

	Run:
		VBRN ABCDEFGHIJKLMNOPQR 1;
		Loop;


	// --------------------------------------------------------
	// ПРИСЕД
	// --------------------------------------------------------

	CrouchStand:
		VCBS A 1;
		Loop;

	CrouchRun:
		VCBR ABCDEFGHIJKLMNOPQR 1;
		Loop;


	ActionHold:
		TNT1 A -1;
		Stop;
	}
}


// ============================================================
// КАМЕРА
// ============================================================

class VanThirdPersonCamera : Actor
{
	Default
	{
		Radius 1;
		Height 1;

		+NOBLOCKMAP;
		+NOINTERACTION;
		+NOGRAVITY;
		+NOCLIP;
		+INVISIBLE;
	}

	override void Tick()
	{
		Super.Tick();

		if (Master == null)
			Destroy();
	}

	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}
}


// ============================================================
// ИГРОК
// ============================================================

class Van : PlayerPawn
{
	const MODE_FREE     = 0;
	const MODE_FIRE     = 1;
	const MODE_KICK     = 2;
	const MODE_JUMP     = 3;
	const MODE_LAND     = 4;
	const MODE_PAIN     = 5;
	const MODE_DEATH    = 6;
	const MODE_AIRPAIN  = 7;

	int VanMode;

	Actor ThirdPersonCamera;
	Actor VisualLegs;
	Actor VisualBody;

	bool JumpWasPressed;
	bool AltFireWasPressed;
	bool JumpingBackward;

	bool LegsUsingAction;
	bool BodyUsingAction;

	int CurrentLegsAnimation;
	int CurrentBodyAnimation;

	double CameraDistance;
	double CameraHeight;
	double CameraWallGap;


	Default
	{
		Health 100;
		Radius 16;
		Height 56;
		Mass 300;
		PainChance 255;

		Speed 0.55;

		+NOBLOOD;
		+NOSKIN;
		+NOICEDEATH;

		RenderStyle "None";

		Player.ForwardMove 0.49, 0.49;
		Player.SideMove 0.49, 0.49;

		Player.JumpZ 8.0;
		Player.ViewHeight 48;
		Player.MaxHealth 100;

		Player.DisplayName "VanH";

		Player.StartItem "Shell", 48;
		Player.StartItem "Shotgun2";

		Player.WeaponSlot 1, "Shotgun2";
		Player.ColorRange 225, 240;
	}


	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		CameraDistance = 106.0;
		CameraHeight = 68.0;
		CameraWallGap = 4.0;

		CurrentLegsAnimation = -1;
		CurrentBodyAnimation = -1;

		ThirdPersonCamera = Spawn(
			"VanThirdPersonCamera",
			Pos
		);

		if (ThirdPersonCamera != null)
			ThirdPersonCamera.Master = self;


		VisualLegs = Spawn(
			"VanVisualLegs",
			Pos
		);

		if (VisualLegs != null)
			VisualLegs.Master = self;


		VisualBody = Spawn(
			"VanVisualBody",
			Pos
		);

		if (VisualBody != null)
			VisualBody.Master = self;
	}


	bool IsKickLocked()
	{
		return VanMode == MODE_KICK ||
			FindInventory("Kinv") != null ||
			FindInventory("VanKickRequest") != null;
	}


	bool IsJumpMode()
	{
		return VanMode == MODE_JUMP ||
			VanMode == MODE_LAND ||
			VanMode == MODE_AIRPAIN ||
			FindInventory("Jmp2") != null;
	}


	bool IsCrouching()
	{
		return GetCrouchFactor() < 0.95;
	}


	void SyncVisualPart(Actor part)
	{
		if (part == null)
			return;

		part.SetOrigin(Pos, true);

		part.Angle = Angle;
		part.Pitch = 0;
		part.Roll = 0;

		part.Scale = Scale;
		part.FloorClip = FloorClip;
		part.Translation = 0;
		part.Alpha = 1.0;
	}


	// 0  = стойка
	// 1-6 = обычное движение
	// 10 = стойка в приседе
	// 11-16 = движение в приседе
	int GetWantedLegsAnimation()
	{
		if (player == null)
			return 0;

		double forward = player.cmd.forwardmove;
		double side = player.cmd.sidemove;

		if (IsCrouching())
		{
			if (forward > 0 && side < 0)
				return 13;

			if (forward > 0 && side > 0)
				return 14;

			if (forward < 0 && side < 0)
				return 15;

			if (forward < 0 && side > 0)
				return 16;

			if (forward > 0)
				return 11;

			if (forward < 0)
				return 12;

			if (side < 0)
				return 13;

			if (side > 0)
				return 14;

			return 10;
		}

		if (forward > 0 && side < 0)
			return 3;

		if (forward > 0 && side > 0)
			return 4;

		if (forward < 0 && side < 0)
			return 5;

		if (forward < 0 && side > 0)
			return 6;

		if (forward > 0)
			return 1;

		if (forward < 0)
			return 2;

		if (side < 0)
			return 3;

		if (side > 0)
			return 4;

		return 0;
	}


	void SetLegsAnimation(int animation)
	{
		if (VisualLegs == null)
			return;

		if (LegsUsingAction)
		{
			LegsUsingAction = false;
			CurrentLegsAnimation = -1;
		}

		if (CurrentLegsAnimation == animation)
			return;

		CurrentLegsAnimation = animation;

		switch (animation)
		{
		case 1:
			VisualLegs.SetStateLabel("RunForward");
			break;

		case 2:
			VisualLegs.SetStateLabel("RunBack");
			break;

		case 3:
			VisualLegs.SetStateLabel("RunLeft");
			break;

		case 4:
			VisualLegs.SetStateLabel("RunRight");
			break;

		case 5:
			VisualLegs.SetStateLabel("RunLeftBack");
			break;

		case 6:
			VisualLegs.SetStateLabel("RunRightBack");
			break;

		case 10:
			VisualLegs.SetStateLabel("CrouchStand");
			break;

		case 11:
			VisualLegs.SetStateLabel("CrouchForward");
			break;

		case 12:
			VisualLegs.SetStateLabel("CrouchBack");
			break;

		case 13:
			VisualLegs.SetStateLabel("CrouchLeft");
			break;

		case 14:
			VisualLegs.SetStateLabel("CrouchRight");
			break;

		case 15:
			VisualLegs.SetStateLabel("CrouchLeftBack");
			break;

		case 16:
			VisualLegs.SetStateLabel("CrouchRightBack");
			break;

		default:
			VisualLegs.SetStateLabel("Stand");
			break;
		}
	}


	// 0 = стойка
	// 1 = бег
	// 2 = стойка в приседе
	// 3 = движение в приседе
	void SetBodyAnimation(int animation)
	{
		if (VisualBody == null)
			return;

		if (BodyUsingAction)
		{
			BodyUsingAction = false;
			CurrentBodyAnimation = -1;
		}

		if (CurrentBodyAnimation == animation)
			return;

		CurrentBodyAnimation = animation;

		switch (animation)
		{
		case 1:
			VisualBody.SetStateLabel("Run");
			break;

		case 2:
			VisualBody.SetStateLabel("CrouchStand");
			break;

		case 3:
			VisualBody.SetStateLabel("CrouchRun");
			break;

		default:
			VisualBody.SetStateLabel("Stand");
			break;
		}
	}


	void CopyLegsActionFrame()
	{
		if (VisualLegs == null)
			return;

		if (!LegsUsingAction)
		{
			LegsUsingAction = true;
			CurrentLegsAnimation = -1;

			VisualLegs.SetStateLabel("ActionHold");
		}

		VisualLegs.Sprite = Sprite;
		VisualLegs.Frame = Frame;
	}


	void CopyBodyActionFrame()
	{
		if (VisualBody == null)
			return;

		if (!BodyUsingAction)
		{
			BodyUsingAction = true;
			CurrentBodyAnimation = -1;

			VisualBody.SetStateLabel("ActionHold");
		}

		VisualBody.Sprite = Sprite;
		VisualBody.Frame = Frame;
	}


	void UpdateVanVisuals()
	{
		SyncVisualPart(VisualLegs);
		SyncVisualPart(VisualBody);

		// Эти режимы заменяют одновременно тело и ноги.
		if (VanMode == MODE_KICK ||
			VanMode == MODE_JUMP ||
			VanMode == MODE_LAND ||
			VanMode == MODE_AIRPAIN ||
			VanMode == MODE_DEATH)
		{
			CopyLegsActionFrame();
			CopyBodyActionFrame();
			return;
		}

		int legsAnimation = GetWantedLegsAnimation();

		// При стрельбе и обычном Pain ноги продолжают движение.
		SetLegsAnimation(legsAnimation);

		if (VanMode == MODE_FIRE ||
			VanMode == MODE_PAIN)
		{
			CopyBodyActionFrame();
			return;
		}

		if (legsAnimation == 10)
		{
			SetBodyAnimation(2);
		}
		else if (legsAnimation >= 11)
		{
			SetBodyAnimation(3);
		}
		else if (legsAnimation == 0)
		{
			SetBodyAnimation(0);
		}
		else
		{
			SetBodyAnimation(1);
		}
	}


	void UpdateVanCamera()
	{
		if (player == null ||
			ThirdPersonCamera == null)
		{
			return;
		}

		player.camera = ThirdPersonCamera;

		double cameraDirection = Angle + 180;
		double realDistance = CameraDistance;

		FLineTraceData trace;

		bool blocked = LineTrace(
			cameraDirection,
			CameraDistance,
			0,
			TRF_THRUACTORS,
			CameraHeight,
			0,
			0,
			trace
		);

		if (blocked &&
			trace.Distance < realDistance)
		{
			realDistance = max(
				8.0,
				trace.Distance - CameraWallGap
			);
		}

		Vector3 cameraPosition = Pos;

		cameraPosition.X +=
			cos(cameraDirection) * realDistance;

		cameraPosition.Y +=
			sin(cameraDirection) * realDistance;

		cameraPosition.Z += CameraHeight;

		ThirdPersonCamera.SetOrigin(
			cameraPosition,
			true
		);

		ThirdPersonCamera.Angle = Angle;
		ThirdPersonCamera.Pitch = Pitch;
		ThirdPersonCamera.Roll = Roll;
	}


	void StartKickFromFire()
	{
		if (VanMode != MODE_FIRE)
			return;

		TakeInventory("VanFireLock", 1);
		GiveInventory("VanKickRequest", 1);

		VanMode = MODE_KICK;

		Vel.X = 0;
		Vel.Y = 0;

		if (player != null)
		{
			player.cmd.forwardmove = 0;
			player.cmd.sidemove = 0;

			player.cmd.buttons &=
				~(BT_ATTACK | BT_JUMP);
		}

		SetStateLabel("Kick");
	}


	override void Tick()
	{
		bool startJump = false;

		if (player != null)
		{
			bool jumpPressed =
				(player.cmd.buttons & BT_JUMP) != 0;

			bool newJumpPress =
				jumpPressed && !JumpWasPressed;

			JumpWasPressed = jumpPressed;


			bool altFirePressed =
				(player.cmd.buttons & BT_ALTATTACK) != 0;

			bool newAltFirePress =
				altFirePressed && !AltFireWasPressed;

			AltFireWasPressed = altFirePressed;


			startJump =
				newJumpPress &&
				player.onground &&
				Health > 0 &&
				VanMode == MODE_FREE &&
				FindInventory("Kinv") == null &&
				FindInventory("VanFireLock") == null &&
				FindInventory("VanPainLock") == null;


			if (jumpPressed && !newJumpPress)
				player.cmd.buttons &= ~BT_JUMP;


			// Удар мгновенно запрашивается во время стрельбы.
			if (newAltFirePress &&
				VanMode == MODE_FIRE &&
				Health > 0 &&
				FindInventory("Jmp2") == null &&
				FindInventory("VanPainLock") == null)
			{
				StartKickFromFire();
				startJump = false;
			}


			if (VanMode == MODE_PAIN)
			{
				// Движение и присед разрешены.
				player.cmd.buttons &=
					~(BT_ATTACK |
					  BT_ALTATTACK |
					  BT_JUMP);

				JumpZ = 0;
				startJump = false;
			}

			else if (VanMode == MODE_AIRPAIN)
			{
				player.cmd.buttons &=
					~(BT_ATTACK |
					  BT_ALTATTACK |
					  BT_JUMP);

				JumpZ = 0;
				startJump = false;
			}

			else if (IsKickLocked())
			{
				VanMode = MODE_KICK;

				player.cmd.forwardmove = 0;
				player.cmd.sidemove = 0;

				player.cmd.buttons &=
					~(BT_ATTACK |
					  BT_JUMP);

				JumpZ = 0;

				Vel.X = 0;
				Vel.Y = 0;

				startJump = false;
			}

			else if (IsJumpMode())
			{
				player.cmd.sidemove = 0;

				player.cmd.buttons &=
					~(BT_ATTACK |
					  BT_ALTATTACK |
					  BT_JUMP);

				JumpZ = 0;
				startJump = false;
			}

			else if (VanMode == MODE_FIRE ||
				FindInventory("VanFireLock") != null)
			{
				VanMode = MODE_FIRE;

				// Движение и присед во время стрельбы разрешены.
				player.cmd.buttons &= ~BT_JUMP;

				JumpZ = 0;
				startJump = false;
			}

			else
			{
				JumpZ = 8.0;
			}
		}


		Super.Tick();


		if (player == null)
			return;


		if (startJump)
		{
			JumpingBackward =
				player.cmd.forwardmove < 0;

			if (Vel.Z <= 0)
				Vel.Z = 8.0;

			VanMode = MODE_JUMP;

			GiveInventory("Jmp", 1);
			GiveInventory("Jmp2", 1);

			if (JumpingBackward)
				SetStateLabel("JumpBack");
			else
				SetStateLabel("Jump");
		}


		UpdateVanVisuals();
		UpdateVanCamera();
	}


	action void A_SetVanMode(int mode)
	{
		invoker.VanMode = mode;
	}


	action void A_SetVanFreeIfUnlocked()
	{
		if (invoker.VanMode == MODE_DEATH ||
			invoker.VanMode == MODE_JUMP ||
			invoker.VanMode == MODE_LAND ||
			invoker.VanMode == MODE_PAIN ||
			invoker.VanMode == MODE_AIRPAIN)
		{
			return;
		}

		if (invoker.FindInventory("Kinv") != null ||
			invoker.FindInventory("VanKickRequest") != null)
		{
			invoker.VanMode = MODE_KICK;
			return;
		}

		if (invoker.FindInventory("VanFireLock") != null)
		{
			invoker.VanMode = MODE_FIRE;
			return;
		}

		invoker.VanMode = MODE_FREE;
	}


	action State A_SelectVanAttack()
	{
		if (invoker.IsJumpMode())
		{
			if (invoker.player != null &&
				invoker.player.onground)
			{
				if (invoker.JumpingBackward)
					return invoker.ResolveState("JumpBackLand");

				return invoker.ResolveState("JumpLand");
			}

			if (invoker.JumpingBackward)
				return invoker.ResolveState("JumpBackAir");

			return invoker.ResolveState("JumpAir");
		}


		if (invoker.VanMode == MODE_PAIN)
			return invoker.ResolveState("GroundPain");

		if (invoker.VanMode == MODE_AIRPAIN)
			return invoker.ResolveState("AirPain");


		bool wantsKick =
			invoker.FindInventory("Kinv") != null ||
			invoker.FindInventory("VanKickRequest") != null;

		if (invoker.player != null &&
			(invoker.player.cmd.buttons &
				BT_ALTATTACK) != 0)
		{
			wantsKick = true;
		}


		if (wantsKick)
		{
			invoker.VanMode = MODE_KICK;

			invoker.Vel.X = 0;
			invoker.Vel.Y = 0;

			return invoker.ResolveState("Kick");
		}

		invoker.VanMode = MODE_FIRE;
		return null;
	}


	action State A_WaitForFireEnd()
	{
		if (invoker.FindInventory("VanKickRequest") != null ||
			invoker.FindInventory("Kinv") != null)
		{
			invoker.VanMode = MODE_KICK;
			return invoker.ResolveState("Kick");
		}

		if (invoker.FindInventory("VanFireLock") != null)
		{
			invoker.VanMode = MODE_FIRE;
			return null;
		}

		invoker.VanMode = MODE_FREE;
		return invoker.ResolveState("Spawn");
	}


	action State A_WaitForKickEnd()
	{
		if (invoker.FindInventory("Kinv") != null ||
			invoker.FindInventory("VanKickRequest") != null)
		{
			invoker.VanMode = MODE_KICK;
			return null;
		}

		invoker.VanMode = MODE_FREE;
		return invoker.ResolveState("Spawn");
	}


	action void A_StartVanJump()
	{
		invoker.VanMode = MODE_JUMP;

		invoker.GiveInventory("Jmp", 1);
		invoker.GiveInventory("Jmp2", 1);
	}


	action State A_CheckVanLanding()
	{
		if (invoker.player != null &&
			invoker.player.onground)
		{
			if (invoker.JumpingBackward)
				return invoker.ResolveState("JumpBackLand");

			return invoker.ResolveState("JumpLand");
		}

		return null;
	}


	action void A_FinishVanJump()
	{
		invoker.TakeInventory("Jmp", 1);
		invoker.TakeInventory("Jmp2", 1);

		invoker.JumpingBackward = false;
		invoker.VanMode = MODE_FREE;
	}


	action State A_SelectVanPain()
	{
		bool airPain =
			invoker.IsJumpMode() ||
			(invoker.player != null &&
			 !invoker.player.onground);

		invoker.TakeInventory("Kinv", 1);
		invoker.TakeInventory("VanFireLock", 1);
		invoker.TakeInventory("VanKickRequest", 1);

		invoker.GiveInventory("VanPainLock", 1);

		// Запрещаем повторно запускать Pain,
		// пока текущая анимация не закончилась.
		invoker.bNOPAIN = true;

		if (airPain)
		{
			invoker.VanMode = MODE_AIRPAIN;
			return invoker.ResolveState("AirPain");
		}

		invoker.VanMode = MODE_PAIN;
		return invoker.ResolveState("GroundPain");
	}


	action void A_StartVanGroundPain()
	{
		invoker.VanMode = MODE_PAIN;
	}


	action void A_FinishVanGroundPain()
	{
		invoker.bNOPAIN = false;
		invoker.TakeInventory("VanPainLock", 1);
		invoker.VanMode = MODE_FREE;
	}


	action void A_StartVanAirPain()
	{
		invoker.VanMode = MODE_AIRPAIN;
	}


	action State A_FinishVanAirPain()
	{
		invoker.bNOPAIN = false;
		invoker.TakeInventory("VanPainLock", 1);

		if (invoker.player != null &&
			invoker.player.onground)
		{
			invoker.VanMode = MODE_LAND;

			if (invoker.JumpingBackward)
				return invoker.ResolveState("JumpBackLand");

			return invoker.ResolveState("JumpLand");
		}

		invoker.VanMode = MODE_JUMP;

		if (invoker.JumpingBackward)
			return invoker.ResolveState("JumpBackAir");

		return invoker.ResolveState("JumpAir");
	}


	action void A_StartVanDeath()
	{
		invoker.bNOPAIN = false;
		invoker.VanMode = MODE_DEATH;

		invoker.TakeInventory("Jmp", 1);
		invoker.TakeInventory("Jmp2", 1);
		invoker.TakeInventory("Kinv", 1);
		invoker.TakeInventory("VanFireLock", 1);
		invoker.TakeInventory("VanKickRequest", 1);
		invoker.TakeInventory("VanPainLock", 1);
	}


	States
	{
	Spawn:
		TNT1 A 1 A_SetVanFreeIfUnlocked;
		Loop;

	See:
		TNT1 A 1 A_SetVanFreeIfUnlocked;
		Loop;


	Melee:
	Missile:
		TNT1 A 0 A_SelectVanAttack;

		VAT1 A 1;
		VAT1 A 3;
		VAT1 ABCDEEDCBA 2 Fast;
		VAT1 A 8;

	FireWait:
		VAT1 A 1 A_WaitForFireEnd;
		Loop;


	Kick:
		TNT1 A 0 A_SetVanMode(MODE_KICK);

		VANK ABCDEFGHIJKLMNOPQR 1 Fast;
		VKAN ABCDEFGHIJ 1 Fast;

	KickWait:
		VKAN J 1 A_WaitForKickEnd;
		Loop;


	Jump:
		TNT1 A 0 A_StartVanJump;
		VJNK ABCDEFGHIJKLMNOPQ 1 Fast;

	JumpAir:
		VJNK R 1 A_CheckVanLanding;
		Wait;

	JumpLand:
		TNT1 A 0 A_SetVanMode(MODE_LAND);
		VAJK ABCDEFGHIJ 1 Fast;
		TNT1 A 0 A_FinishVanJump;
		Goto Spawn;


	JumpBack:
		TNT1 A 0 A_StartVanJump;
		VJBK ABCDEFGHIJKLMNOPQ 1 Fast;

	JumpBackAir:
		VJBK R 1 A_CheckVanLanding;
		Wait;

	JumpBackLand:
		TNT1 A 0 A_SetVanMode(MODE_LAND);
		VBJL ABCDEFGHIJ 1 Fast;
		TNT1 A 0 A_FinishVanJump;
		Goto Spawn;


	Pain:
		TNT1 A 0 A_SelectVanPain;

	GroundPain:
		TNT1 A 0 A_StartVanGroundPain;
		VBPN A 3 A_Pain;
		VBPN B 3;
		TNT1 A 0 A_FinishVanGroundPain;
		Goto Spawn;

	AirPain:
		TNT1 A 0 A_StartVanAirPain;
		VAPN A 3 A_Pain;
		VAPN B 3;
		TNT1 A 0 A_FinishVanAirPain;
		Wait;


	Death:
		TNT1 A 0 A_StartVanDeath;
		TNT1 A 0 A_Stop;

		VNDD A 3;
		VNDD B 3 A_PlayerScream;
		VNDD C 3 A_NoBlocking;
		VNDD DEFGHIJ 3;
		VNDD J -1;
		Stop;

	XDeath:
		Goto Death;

	AltSkinDeath:
		Goto Death;

	AltSkinXDeath:
		Goto Death;
	}
}


// ============================================================
// ОРУЖИЕ
// ============================================================

class Shotgun2 : Shotgun replaces Shotgun
{
	Default
	{
		Weapon.KickBack 100;
		Weapon.SelectionOrder 1300;
		Weapon.AmmoUse 1;
		Weapon.AmmoGive 8;
		Weapon.AmmoType "Shell";

		Inventory.PickupMessage "$GOTSHOTGUN";
		Tag "$TAG_SHOTGUN";

		+WEAPON.WIMPY_WEAPON;
	}


	action State A_CheckFireInterrupt()
	{
		Actor user = invoker.Owner;

		if (user == null)
			return null;

		if (user.FindInventory("VanPainLock") != null ||
			user.FindInventory("Jmp2") != null)
		{
			return invoker.ResolveState("CancelFire");
		}

		if (user.FindInventory("VanKickRequest") != null ||
			user.FindInventory("Kinv") != null)
		{
			return invoker.ResolveState("ForceKick");
		}

		return null;
	}


	action State A_BeginVanKick()
	{
		Actor user = invoker.Owner;

		if (user == null)
			return invoker.ResolveState("CancelKick");

		if (user.FindInventory("VanPainLock") != null ||
			user.FindInventory("Jmp2") != null)
		{
			return invoker.ResolveState("CancelKick");
		}

		user.TakeInventory("VanFireLock", 1);
		user.TakeInventory("VanKickRequest", 1);
		user.GiveInventory("Kinv", 1);

		return null;
	}


	action State A_CheckKickInterrupt()
	{
		Actor user = invoker.Owner;

		if (user == null)
			return invoker.ResolveState("CancelKick");

		if (user.FindInventory("VanPainLock") != null ||
			user.FindInventory("Jmp2") != null ||
			user.FindInventory("Kinv") == null)
		{
			return invoker.ResolveState("CancelKick");
		}

		return null;
	}


	States
	{
	Ready:
		TNT1 A 0 A_JumpIfInventory(
			"VanPainLock",
			1,
			"PainLocked"
		);

		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"JumpLocked"
		);

		SHTG A 1 A_WeaponReady;
		Loop;


	PainLocked:
		// Обязательно отдельный кадр без action-функции.
		SHTG A 1;

		TNT1 A 0 A_JumpIfInventory(
			"VanPainLock",
			1,
			"PainLocked"
		);

		Goto Ready;

	JumpLocked:
		SHTG A 1;
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"JumpLocked"
		);
		Goto Ready;


	Deselect:
		SHTG A 1 A_Lower;
		Loop;

	Select:
		SHTG A 1 A_Raise;
		Loop;


	Fire:
		TNT1 A 0 A_JumpIfInventory(
			"VanPainLock",
			1,
			"CancelFire"
		);

		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"CancelFire"
		);

		TNT1 A 0 A_JumpIfInventory(
			"Kinv",
			1,
			"ForceKick"
		);

		TNT1 A 0 A_JumpIfInventory(
			"Shell",
			2,
			"RealFire"
		);

		Goto CancelFire;


	RealFire:
		TNT1 A 0 A_GiveInventory(
			"VanFireLock",
			1
		);

		// Три тика задержки, но проверка Kick идёт каждый тик.
		SHTG AAA 1 A_CheckFireInterrupt;

		TNT1 A 0 A_CheckFireInterrupt;

		TNT1 A 0 A_SpawnItemEx(
			"YellowFlareSmall",
			45,
			10,
			38,
			0
		);

		TNT1 AAAAA 0 A_FireCustomMissile(
			"Tracer",
			random(-12, 12),
			0,
			4,
			20
		);

		TNT1 A 0 A_PlaySound(
			"weapons/shotgf",
			CHAN_WEAPON
		);

		TNT1 A 0 A_TakeInventory(
			"Shell",
			2
		);

		SHTG AAA 1 A_CheckFireInterrupt;
		SHTG BBBCCC 1 A_CheckFireInterrupt;
		SHTG DDDD 1 A_CheckFireInterrupt;
		SHTG CCCBBB 1 A_CheckFireInterrupt;
		SHTG AAAAAAAAAA 1 A_CheckFireInterrupt;

		TNT1 A 0 A_ReFire;

		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		);

		Goto Ready;


	ForceKick:
		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		);
		Goto AltFire;


	CancelFire:
		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		);

		TNT1 A 0 A_TakeInventory(
			"VanKickRequest",
			1
		);

		Goto PainLocked;


	AltFire:
		TNT1 A 0 A_BeginVanKick;

	KickAnimation:
		SHTG AAAAAAAAAA 1 Fast A_CheckKickInterrupt;

		TNT1 A 0 A_CheckKickInterrupt;

		SHTG A 1 Fast A_CustomPunch(
			2,
			FALSE,
			0,
			"BulletPuff",
			28
		);

		SHTG AAAAAAAAAAAAAAAA 1 Fast A_CheckKickInterrupt;

		TNT1 A 0 A_TakeInventory(
			"Kinv",
			1
		);

		TNT1 A 0 A_TakeInventory(
			"VanKickRequest",
			1
		);

		Goto Ready;


	CancelKick:
		TNT1 A 0 A_TakeInventory(
			"Kinv",
			1
		);

		TNT1 A 0 A_TakeInventory(
			"VanKickRequest",
			1
		);

		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		);

		Goto PainLocked;

	KickPainWait:
		SHTG A 1 A_JumpIfInventory(
			"VanPainLock",
			1,
			"KickPainWait"
		);

		Goto Ready;


	Flash:
		SHTF A 4 Bright A_Light1;
		SHTF B 3 Bright A_Light2;
		Goto LightDone;


	Spawn:
		SHOT A -1;
		Stop;
	}
}


// ============================================================
// СНАРЯД
// ============================================================

class Tracer : FastProjectile
{
	Default
	{
		Projectile;

		+RANDOMIZE;
		+FORCEXYBILLBOARD;
		+DONTSPLASH;
		+NOEXTREMEDEATH;

		Damage 3;
		Radius 4;
		Height 4;
		Speed 120;

		RenderStyle "Add";
		Alpha 0.9;
		Scale 0.15;
	}

	States
	{
	Spawn:
		TRAC A 1 Bright;
		Loop;

	Death:
		Stop;

	XDeath:
		Stop;
	}
}


