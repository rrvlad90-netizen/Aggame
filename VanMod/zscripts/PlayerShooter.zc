class YellowFlareSmall : Actor
{
	Default
	{
		+NOINTERACTION;
		+NOGRAVITY;
		+CLIENTSIDEONLY;
		+FORCEXYBILLBOARD;

		RenderStyle "Add";

		Radius 1;
		Height 1;
		Scale 0.15;
		Alpha 0.3;
	}

	States
	{
	Spawn:
		LENY A 1 Bright;
		Stop;
	}
}