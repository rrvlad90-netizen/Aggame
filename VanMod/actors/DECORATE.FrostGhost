ACTOR FrostGhost replaces HellKnight
{
  Health 50
		Speed 7
		Radius 27
		Height 54
		Mass 800
		PainChance 100
  DamageType "Ice"
  Monster
  +DROPOFF
  +NOGRAVITY
  +FLOAT
  +FLOATBOB
  +NOBLOOD
  +TELESTOMP
  //+NOTARGET
  +NOICEDEATH
  +NOPAIN
  //+BOSS
  SeeSound "GHOST"
  DeathSound "GHOST"
  Obituary "Frozen by FrostGhost" // "%o was frozen solid by a Wendigo."

  States
  {
  Spawn:
    FGHO A 10 A_Look
    Loop
  See:
    FGHO A 4 A_Chase
    Loop
  Missile:
    FGHO BBBB 1 A_FaceTarget
    FGHO BC 1 A_FaceTarget
    FGHO C 1 Bright A_CustomMissile("FrozenBall",48,-32)  //HeadFX1
    FGHO C 1 Bright A_CustomMissile("FrozenBall",48,32)
	FGHO C 1
    FGHO BBBBBBBBB 1 
    Goto See
  Pain:
    FGHO D 1 A_Pain
    Goto See	
 Death:
    FGHO D 2 A_Scream
	FGHO DDDD 2
	FGHO DDDDDDDDDDDDDDDDDDDDDDDDD 2 A_FadeOut(0.1) 
	Stop
  }
}


actor FrozenBall
{
	Radius 8
	Height 6
	Speed 19
	Damage 1
	DamageType Ice
	PROJECTILE
	RENDERSTYLE ADD
	ALPHA 0.67
	Scale 0.28
   SeeSound "DSFIRSHT"
   DeathSound "DSFIRXPL"
	Decal DoomImpScorch
	Translation "Ice"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("MiniCryoSmoke1", 5, 1,true)
		Fly:
		TNT1 A 0 A_SpawnItem("MiniCryoSmoke1",0,0)
        CORN BBBBBBBBB 1 Bright A_SpawnItemEx ("MiniCryoSmoke1", 0, 0, 0, random(0, -4), random(-2, 2), random(-2, 2), 0, 0, 0)
        Loop
    Death:
           TNT1 AAAAA 0 A_SpawnItemEx("CryoSmoke1", 0, 0, 0, random(10, 30)*0.1, 0, random(0, 10)*0.1, random(1,360))
 	   TNT1 AAAAA 0 A_SpawnItemEx("CryoSmoke2", 0, 0, 0, random(10, 30)*0.1, 0, random(0, 10)*0.1, random(1,360))
 	   TNT1 AAAAA 0 A_SpawnItemEx("CryoSmoke3", 0, 0, 0, random(10, 30)*0.1, 0, random(0, 10)*0.1, random(1,360))
        Stop
    }
}


ACTOR CryoSmoke
{
    Radius 2
    Height 2
    +NOINTERACTION
    +FORCEXYBILLBOARD
    RenderStyle Shaded
	//Translation "Ice"
    StencilColor "A0 FF FF"
    Alpha 0.6
    Scale 0.85
    States
    {
    Spawn:
		SMKO A 0
        SMK2 A 2 A_FadeOut (0.03)
        Wait
    }
}

ACTOR BigCryoSmoke : CryoSmoke
{
Scale 1.2
}

