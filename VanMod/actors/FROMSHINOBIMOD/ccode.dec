ACTOR GuardArmor : BasicArmorPickup {
	Inventory.PickupMessage "$GOTMEGA" // "Picked up the MegaArmor!"
	Inventory.Icon "ARM2A0"
	Inventory.Amount 1
	Armor.SavePercent 100
	Armor.SaveAmount 1
}
ACTOR NoArmor : BasicArmorPickup {
	Radius 20
	Height 16
	Inventory.PickupMessage "$GOTMEGA" // "Picked up the MegaArmor!"
	Inventory.Icon "ARM2A0"
	Inventory.Amount 1
	Armor.SavePercent 0
	Armor.SaveAmount 1
	States {
		Spawn:
		ARM2 A 6
		ARM2 B 6 Bright
		Loop
	}
}
ACTOR Zangetsu3D {
	Radius 12
	Height 12
	Scale 1
	+NOGRAVITY
	+NOBLOCKMAP
	+NOCLIP
	+THRUACTORS
	States{
	Spawn:
		KT3D A 16
		Stop
	}
}
ACTOR FreezeTimeGiver : PowerupGiver {
	-COUNTITEM
	Inventory.MaxAmount 0
	Powerup.Type "PowerTimeFreezerSound"
	Powerup.Duration 0x7FFFFFFD
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
