
#include "Zangetsu.dec"
#include "Kubikiribocho.dec"
#include "BloodDec.dec"
#include "GibDec.dec"
#include "REPLACES.dec"
#include "SFX.dec"
#include "NinjaFX.dec"
#include "OniStage.dec"
#include "DOJO.dec"
#include "CHASECAM.dec"

#include "Actors/NewZombieman.dec"
#include "Actors/NewShotgunGuy.dec"
#include "Actors/NewImp.dec"
#include "Actors/NewDemon.dec"
#include "Actors/NewBaronOfHell.dec"
#include "Actors/NewLostSoul.dec"
#include "Actors/NewCacodemon.dec"
#include "Actors/NewCyberdemon.dec"
#include "Actors/NewSpiderMastermind.dec"
#include "Actors/NewChaingunGuy.dec"
#include "Actors/NewRevenant.dec"
#include "Actors/NewHellKnight.dec"
#include "Actors/NewArchvile.dec"
#include "Actors/NewArachnotron.dec"
#include "Actors/NewMancubus.dec"
#include "Actors/NewPainElemental.dec"
#include "Actors/NewWolfensteinSS.dec"
#include "Actors/NewExplosiveBarrel.dec"
