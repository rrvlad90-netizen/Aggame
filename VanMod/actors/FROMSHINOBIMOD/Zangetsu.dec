		TNT1 A 0
		TNT1 A 0 A_PlaySound("katana/Screech")
		TNT1 A 0 A_SpawnItemEx("RicochetSparkSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_Explode(10,64,0,true)
		TNT1 A 0 A_PlaySound("sfx/explode2")
		TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128) 
		TNT1 AAA 0 A_SpawnItemEx("Kaboom4",0,0,0,Random(5,10)*0.1,Random(-10,10)*0.1,Random(-10,10)*0.1,180,SXF_NOCHECKPOSITION)
		TNT1 AAA 0 A_SpawnItemEx("SmokeFX5",0,0,0,Random(5,10)*0.1,Random(-10,10)*0.1,Random(-10,10)*0.1,180,SXF_NOCHECKPOSITION)
		Stop
	}
}
