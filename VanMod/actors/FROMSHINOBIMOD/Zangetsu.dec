	AerialKickLand:
		TNT1 A 0 A_PlaySound("sfx/hardLand")//,8)
		TNT1 A 0 A_TakeInventory("AerialKick",1)	
		TNT1 A 0 A_TakeInventory("isJumping",2)
	    TNT1 A 0 ACS_NamedExecuteAlways("CameraYawCheck",0,0,0)
		TNT1 A 0 A_CustomMissile("SmokeCircleGenerator", 24, 0, 30, 2, 0)
		TNT1 A 0 A_SpawnItemEx("ShockWave2",0,0,0,0,0,0,0,128,0)
		NJKB U 1 ACS_NamedExecuteAlways("ZangetsuStates",0,6,0)
		NJKB VWXYZ 1
		NJKB [ 1
		NJKB ] 1
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Ready
	AerialApproachAttack:
		NJA1 L 1 ACS_NamedExecuteAlways("ZangetsuStates",0,57,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_SetGravity(0)
		TNT1 A 0 A_TakeInventory("WallRunLeftAction",1)
		TNT1 A 0 A_TakeInventory("WallRunRightAction",1)
		TNT1 A 0 A_TakeInventory("AerialApproachAttack",1)
		NJA1 L 1 ACS_NamedExecuteAlways("ZangetsuStates",0,57,0)
		TNT1 A 0 A_PlayWeaponSound("ninja/attack")
		NJA1 M 2
		TNT1 A 0 A_SpawnItemEx("ShockWave3",0,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("ShockWave4",0,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		NJA1 N 2 A_ChangeVelocity (Cos(Pitch)*50, 0, Sin(Pitch) * -50, CVF_Relative)
		NJA1 O 2 A_ChangeVelocity (Cos(Pitch)*50, 0, Sin(Pitch) * -50, CVF_Relative)
		NJA1 P 1 A_Stop
		TNT1 A 0 A_FireCustomMissile("AerialAttackHitBox1",0,0,0,0,FPF_NOAUTOAIM)
		TNT1 A 0 A_CustomPunch(0,TRUE,0 ,"AerialAttack2Screech",64)
		TNT1 A 0 A_SpawnItemEx("AerialSlash2FX",16,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		NJA1 QRSTUV 1 A_Recoil(-0.3)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJA1 WX 1 A_Recoil(-0.3)
		NJA1 Y 1 A_Recoil(-0.3)
		TNT1 A 0 A_SetGravity(1)
		NJA1 Z 1 A_WeaponReady
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Falling
