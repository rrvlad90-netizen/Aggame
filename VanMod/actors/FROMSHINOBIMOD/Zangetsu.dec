		TNT1 A 0 A_GiveInventory("FreezeTimeGiver",1)
		NJA5 BCDEFGHIJK 2
		TNT1 A 0 A_TakeInventory("SpellOrb",1)
		TNT1 A 0 A_SpawnItemEx("SpecialFX",0,0,32,0,0,0,0,128,0)
		TNT1 A 0 A_SpawnItemEx("ShockWave3",0,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("ShockWave4",0,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_ChangeFlag(THRUACTORS,TRUE)
		NJA5 L 14
		TNT1 A 0 A_PlayWeaponSound("ninja/attack_5")
		TNT1 A 0 A_PlaySound("ninja/KatanaChargeSlash")
		NJA5 MNO 2
		TNT1 A 0 A_SpawnItemEx("ShockWave2",0,0,0,0,0,0,0,128,0)
		TNT1 A 0 A_CustomMissile("SmokeCircleGenerator", 24, 0, 30, 2, 0)
		TNT1 A 0 A_PlaySound("ninja/jump",8)
		TNT1 A 16
		TNT1 A 0 ThrustThingZ(0,600,0,0)
		NJK5 ABCDEFGHIJKL 1
		TNT1 A 0 A_SetGravity(1)
		TNT1 A 0 ThrustThingZ(0,-600,0,0)
	ThunderBlowFalling:
		NJK5 M 1 A_CheckFloor(1)
		Goto ThunderBlowFalling
		TNT1 A 0 A_PlaySound("skill/Thunder1")
		TNT1 A 0 A_Explode(1,256,XF_EXPLICITDAMAGETYPE,true,256,0,0,"NullPuff","ThunderBlow1")
		TNT1 A 0 A_SpawnItemEx("Lightning1",0,0,0,0,0,0,0,128,0)
		TNT1 A 0 A_SpawnItemEx("ShockWave2",0,0,0,0,0,0,0,128,0)
		TNT1 A 0 A_CustomMissile("SmokeCircleGenerator", 24, 0, 30, 2, 0)
		TNT1 A 0 A_SpawnItemEx("ShockWave",0,0,0,0,0,0,0,128,0)
		TNT1 A 0 Radius_Quake(2,4,0,32,0)
		NJK5 M 35
		TNT1 A 0 A_TakeInventory("PowerTimeFreezerSound",1)
		TNT1 A 0 Radius_Quake(8,10,0,32,0)
		TNT1 A 0 A_Explode(128,256,XF_EXPLICITDAMAGETYPE,true,256,0,0,"NullPuff","ThunderBlow2")
		TNT1 A 0 A_SpawnItemEx("Lightning2",0,0,0,0,0,0,0,128,0)
		TNT1 A 0 A_SpawnItemEx("BigElectric",0,0,0,0,0,0,0,128,0)
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("SmallLightning",Random(-64,64),Random(-64,64),0,0,0,0,0,128,0)
		TNT1 A 0 A_SpawnItemEx("ShockWave",0,0,0,0,0,0,0,128,0)
		TNT1 A 0 A_PlaySound("skill/Thunder2")
		NJK5 NOPQR 1
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("SmallLightning",Random(-64,64),Random(-64,64),0,0,0,0,0,128,0)
		TNT1 A 0 A_SpawnItemEx("ShockWave",0,0,0,0,0,0,0,128,0)
		NJK5 STUVW 1
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("SmallLightning",Random(-64,64),Random(-64,64),0,0,0,0,0,128,0)
		TNT1 A 0 A_SpawnItemEx("ShockWave",0,0,0,0,0,0,0,128,0)
		NJK5 NOPQRSTUVWXYZ 1
		TNT1 A 0 A_ChangeFlag(THRUACTORS,FALSE)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Ready
	EvadeCheck:
		TNT1 A 0 A_PlaySound("ninja/attack")
		TNT1 A 0 A_ChangeFlag(NOPAIN,TRUE)
		TNT1 A 0 A_ChangeFlag(GHOST,TRUE)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_JumpIfInventory("EvadeForward",1,"EvadeForward")
		TNT1 A 0 A_JumpIfInventory("EvadeBack",1,"EvadeBack")
		TNT1 A 0 A_JumpIfInventory("EvadeLeft",1,"EvadeLeft")
		TNT1 A 0 A_JumpIfInventory("EvadeRight",1,"EvadeRight")
		Goto Ready
	EvadeForward:
	    NJKB A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,4,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_GiveInventory("ApproachAttack",1)
	    NJKB A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,4,0)
		TNT1 A 0 A_PlaySound("ninja/jump",8)
		TNT1 A 0 A_Recoil(-6)
		TNT1 A 0 ThrustThingZ(0,24,0,0)
		NJKB B 1 A_Recoil(-6)
		NJKB C 1 ThrustThingZ(0,16,0,0)
		NJKB D 1 A_Recoil(-6)
		NJKB E 1 ThrustThingZ(0,8,0,0)
		NJKB FGHIJ 1 A_TakeInventory("EvadeForward",1)
		TNT1 A 0 A_ChangeFlag(GHOST,FALSE)
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKB KL 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		TNT1 A 0 A_TakeInventory("ApproachAttack",1)
		NJKB MNO 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Guard
	EvadeBack:
		TNT1 A 0 A_TakeInventory("LightAttack1",1)
		TNT1 A 0 A_TakeInventory("LightAttack2",1)
		TNT1 A 0 A_TakeInventory("LightAttack3",1)
		TNT1 A 0 A_TakeInventory("LightAttack4",1)
		TNT1 A 0 A_TakeInventory("LightAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack1",1)
		TNT1 A 0 A_TakeInventory("HardAttack2",1)
		TNT1 A 0 A_TakeInventory("HardAttack3",1)
		TNT1 A 0 A_TakeInventory("HardAttack4",1)
		TNT1 A 0 A_TakeInventory("HardAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack6",1)
		TNT1 A 0 A_TakeInventory("HardAttack7",1)
		TNT1 A 0 A_TakeInventory("HardAttack8",1)
		TNT1 A 0 A_TakeInventory("HardAttack9",1)
		TNT1 A 0 A_TakeInventory("RoundKick",1)
		NJA0 A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,51,0)
		TNT1 A 0 ACS_NamedExecuteAlways("Evading",0,1,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		NJA0 AA 1 ACS_NamedExecuteAlways("ZangetsuStates",0,51,0)
		NJA0 BCD 2 A_TakeInventory("EvadeBack",1)
		TNT1 A 0 A_GiveInventory("ApproachAttack",1)
		TNT1 A 0 A_ChangeFlag(GHOST,FALSE)
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJA0 EFGH 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("EvadeBack",1,"EvadeBack")
		TNT1 A 0 A_TakeInventory("ApproachAttack",1)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Guard
	EvadeLeft:
		NJKB I 1 ACS_NamedExecuteAlways("ZangetsuStates",0,52,0)
		TNT1 A 0 ACS_NamedExecuteAlways("Evading",0,2,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		NJKB IJ 1 ACS_NamedExecuteAlways("ZangetsuStates",0,52,0)
		NJKB KLM 3 A_TakeInventory("EvadeLeft",1)
		TNT1 A 0 A_ChangeFlag(GHOST,FALSE)
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKB NOP 1 A_WeaponReady
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Guard
	EvadeRight:
		NJKB Q 1 ACS_NamedExecuteAlways("ZangetsuStates",0,53,0)
		TNT1 A 0 ACS_NamedExecuteAlways("Evading",0,3,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		NJKB QR 1 ACS_NamedExecuteAlways("ZangetsuStates",0,53,0)
		NJKB STU 3 A_TakeInventory("EvadeRight",1)
		TNT1 A 0 A_ChangeFlag(GHOST,FALSE)
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKB VWX 1 A_WeaponReady
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Guard
	Hurt:
	    NJK6 A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,Random(43,46),0)
		TNT1 A 0 A_GiveInventory("FreezeTimeGiver",1)
		TNT1 A 0 Radius_Quake(2,2,0,32,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_Gravity
		TNT1 A 0 A_TakeInventory("WallRunLeftAction",1)
		TNT1 A 0 A_TakeInventory("WallRunRightAction",1)
		TNT1 A 0 A_TakeInventory("PlayerGuarding",1)
		TNT1 A 0 A_TakeInventory("isAttacking",1)
		NJKA A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_TakeInventory("LightAttack1",1)
		TNT1 A 0 A_TakeInventory("LightAttack2",1)
		TNT1 A 0 A_TakeInventory("LightAttack3",1)
		TNT1 A 0 A_TakeInventory("LightAttack4",1)
		TNT1 A 0 A_TakeInventory("LightAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack1",1)
		TNT1 A 0 A_TakeInventory("HardAttack2",1)
		TNT1 A 0 A_TakeInventory("HardAttack3",1)
		TNT1 A 0 A_TakeInventory("HardAttack4",1)
		TNT1 A 0 A_TakeInventory("HardAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack6",1)
		TNT1 A 0 A_TakeInventory("HardAttack7",1)
		TNT1 A 0 A_TakeInventory("HardAttack8",1)
		TNT1 A 0 A_TakeInventory("HardAttack9",1)
		TNT1 A 0 A_TakeInventory("RoundKick",1)
		TNT1 A 0 A_TakeInventory("AerialAttack1",1)
		TNT1 A 0 A_TakeInventory("AerialAttack2",1)
		TNT1 A 0 A_TakeInventory("AerialAttack3",1)
		TNT1 A 0 A_TakeInventory("AerialKick",1)
		TNT1 A 0 A_TakeInventory("AerialHardAttack",1)
	    NJK6 A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,Random(43,46),0)
		NJK6 BCD 2
		TNT1 A 0 A_TakeInventory("PowerTimeFreezerSound",1)
		NJK6 EF 2
		TNT1 A 0 A_TakeInventory("Hurt",1)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Ready
	KnockDown:
		NJK7 A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,47,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_Gravity
		TNT1 A 0 A_ChangeFlag(NOPAIN,TRUE)
		TNT1 A 0 A_ChangeFlag(NOBLOOD,FALSE)
		TNT1 A 0 A_ChangeFlag(GHOST,TRUE)
		TNT1 A 0 A_TakeInventory("WallRunLeftAction",1)
		TNT1 A 0 A_TakeInventory("WallRunRightAction",1)
		TNT1 A 0 A_TakeInventory("PlayerGuarding",1)
		TNT1 A 0 A_TakeInventory("isAttacking",1)
		NJKA A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_TakeInventory("LightAttack1",1)
		TNT1 A 0 A_TakeInventory("LightAttack2",1)
		TNT1 A 0 A_TakeInventory("LightAttack3",1)
		TNT1 A 0 A_TakeInventory("LightAttack4",1)
		TNT1 A 0 A_TakeInventory("LightAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack1",1)
		TNT1 A 0 A_TakeInventory("HardAttack2",1)
		TNT1 A 0 A_TakeInventory("HardAttack3",1)
		TNT1 A 0 A_TakeInventory("HardAttack4",1)
		TNT1 A 0 A_TakeInventory("HardAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack6",1)
		TNT1 A 0 A_TakeInventory("HardAttack7",1)
		TNT1 A 0 A_TakeInventory("HardAttack8",1)
		TNT1 A 0 A_TakeInventory("HardAttack9",1)
		TNT1 A 0 A_TakeInventory("RoundKick",1)
		TNT1 A 0 A_TakeInventory("AerialAttack1",1)
		TNT1 A 0 A_TakeInventory("AerialAttack2",1)
		TNT1 A 0 A_TakeInventory("AerialAttack3",1)
		TNT1 A 0 A_TakeInventory("AerialKick",1)
		TNT1 A 0 A_TakeInventory("AerialHardAttack",1)
		NJK7 B 1 ACS_NamedExecuteAlways("ZangetsuStates",0,47,0)
		TNT1 A 0 ThrustThingZ(0,40,0,0)
		NJK7 C 1 A_FaceTarget
		TNT1 A 0 A_Recoil(10)
		NJK7 DEFGHIJKLMN 2
	ZangetsuKnockdownFalling:
		NJK7 O 1
		TNT1 A 0 A_CheckFloor(2)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Loop
		TNT1 A 0 A_PlaySound("sfx/hardLand",8)
		TNT1 A 0 A_CustomMissile("SmokeCircleGenerator", 24, 0, 30, 2, 0)
		TNT1 A 0 A_SpawnItemEx("ShockWave2",0,0,0,0,0,0,0,128,0)
		NJK7 P 2 A_SetInvulnerable
		NJK7 P 35 
	ZangetsuKikup:
		TNT1 A 0 A_PlaySound("ninja/attack")
		NJK7 A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,48,0)
		NJK7 B 1 ACS_NamedExecuteAlways("ZangetsuStates",0,48,0)
		NJK8 CD 1
		TNT1 A 0 A_PlaySound("ninja/jump",5)
		NJK8 EFGHIJ 1
		TNT1 A 0 A_ChangeFlag(GHOST,FALSE)
		TNT1 A 0 A_ChangeFlag(NOPAIN,FALSE)
		TNT1 A 0 A_ChangeFlag(NOBLOOD,TRUE)
		TNT1 A 0 A_TakeInventory("KnockDown",1)
		TNT1 A 0 A_JumpIfInventory("EvadeCheck",1,"EvadeCheck")
		NJK8 KLMNO 1
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		TNT1 A 0 A_UnSetInvulnerable
		Goto Ready
	Spawn:
		KTNA A 3 A_SpawnItemEx("WhiteStar",Random(-50,50)*.1,Random(-50,50)*.1,0,0,0,Random(3,5)*.1)
		Loop
	}
}

