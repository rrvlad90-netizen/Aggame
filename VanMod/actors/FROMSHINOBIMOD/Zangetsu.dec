	AerialShurikensStart:
		NJKB C 1 ACS_NamedExecuteAlways("ZangetsuStates",0,38,0)
		TNT1 A 0 ThrustThingZ(0,30,0,0)
		NJKB DEFJKL 1 A_SetGravity(0.6)
		Goto AerialShurikens
