		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB S 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB T 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		Goto Falling+3
	Land:
		NJKB U 1 ACS_NamedExecuteAlways("ZangetsuStates",0,6,0)
	    TNT1 A 0 ACS_NamedExecuteAlways("CameraYawCheck",0,0,0)
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,"Running")
	    TNT1 A 0 A_TakeInventory("isFalling",1)
		TNT1 A 0 A_PlaySound("sfx/hardLand",8)
		TNT1 A 0 A_SetGravity(1)
		NJKB VWXYZ 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		NJKB [ 1 A_WeaponReady
		NJKB ] 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Ready
	Guard:
	    NJKC A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,7,0)
		TNT1 A 0 A_ChangeFlag(NOPAIN,FALSE)
		TNT1 A 0 A_ChangeFlag(NOBLOOD,TRUE)
		TNT1 A 0 A_TakeInventory("AerialHardAttack",1)
		NJKC A 1 A_WeaponReady
		TNT1 A 0 A_GiveInventory("PlayerGuarding",1)
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		TNT1 A 0 A_JumpIfInventory("EvadeCheck",1,"EvadeCheck")
		TNT1 A 0 A_JumpIfInventory("GuardBreak",1,"GuardBreak")
		TNT1 A 0 A_JumpIfInventory("ReflectedBullet",1,"ReflectedBullet")
		TNT1 A 0 A_JumpIfInventory("ReflectedShuriken",1,"ReflectedShuriken")
		TNT1 A 0 A_JumpIfInventory("BlockAttack",1,"BlockAttack")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,1)
		Goto Ready
		TNT1 A 0
		Goto Guard+1
	BlockAttack:
		TNT1 A 0 A_PlaySound("katana/Screech")
		TNT1 A 0 A_SpawnItemEx("RicochetSparkSpawner",8,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("ShockWaveImpact",24,0,40,0,0,0,Random(-15,15),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_ChangeFlag(NOPAIN,TRUE)
	    NJKC F 1 ACS_NamedExecuteAlways("ZangetsuStates",0,8,0)
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_TakeInventory("BlockAttack",1)
		TNT1 A 0 A_GiveInventory("FreezeTimeGiver",1)
		NJKC GHIJ 1 
		TNT1 A 0 A_ChangeFlag(NOPAIN,FALSE)
		TNT1 A 0 A_TakeInventory("PowerTimeFreezerSound",1)
		Goto Guard
	ReflectedBullet:
		TNT1 A 0 A_FireCustomMissile("ReflectedBulletProjectile",Random(-4,4),0,Random(-4,4),Random(-4,4),0,Random(-4,4))
		TNT1 A 0 A_PlaySound("katana/Screech")
		TNT1 A 0 A_SpawnItemEx("RicochetSparkSpawner",8,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("ShockWaveImpact",24,0,40,0,0,0,Random(-15,15),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_TakeInventory("ReflectedBullet",1)
		TNT1 A 0 A_ChangeFlag(NOPAIN,TRUE)
	    NJKC K 1 ACS_NamedExecuteAlways("ZangetsuStates",0,Random(9,10),0)
		TNT1 A 0 A_GiveInventory("FreezeTimeGiver",1)
		NJKC LMNO 1
		TNT1 A 0 A_TakeInventory("PowerTimeFreezerSound",1)
		NJKC PQRS 1
		Goto Guard		
	ReflectedShuriken:
		TNT1 A 0 A_FireCustomMissile("ReflectedShurikenProjectile",Random(-4,4),0,Random(-4,4),Random(-4,4),0,Random(-4,4))
		TNT1 A 0 A_PlaySound("katana/Screech")
		TNT1 A 0 A_SpawnItemEx("RicochetSparkSpawner",8,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("ShockWaveImpact",24,0,40,0,0,0,Random(-15,15),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_TakeInventory("ReflectedShuriken",1)
		TNT1 A 0 A_ChangeFlag(NOPAIN,TRUE)
	    NJKC K 1 ACS_NamedExecuteAlways("ZangetsuStates",0,Random(9,10),0)
		TNT1 A 0 A_GiveInventory("FreezeTimeGiver",1)
		NJKC LMNO 1
		TNT1 A 0 A_TakeInventory("PowerTimeFreezerSound",1)
		NJKC PQRS 1
		Goto Guard		
	GuardBreak:
	    NJKD A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,11,0)
