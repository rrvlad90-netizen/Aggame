Actor ShurikenProjectile : FastProjectile {
	Radius 1
	Height 1
	Speed 200
	Scale 0.1
	RenderStyle Add
	Alpha 0.85
	+NOEXTREMEDEATH
	+BLOODSPLATTER
	Decal BulletChip
	DamageType "Shuriken"
	Damage (Random(5,8))
	Decal BulletHole
	States {
	Spawn:
		STRC A 1 A_Weave(1,1,0,0)
		Loop
	Death:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("katana/Screech")
		TNT1 A 1 A_SpawnItemEx("RicochetSparkSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 1 A_Jump(64,"SpawnShurikenItem")
		TNT1 A 1 A_Jump(256,"SpawnShuriken1","SpawnShuriken2","SpawnShuriken3")
	SpawnShuriken1:
		TNT1 A 0 A_SpawnItemEx("ShurikenSpawn1",0,0,0,0,0,0,0)
		Stop
	SpawnShuriken2:
		TNT1 A 0 A_SpawnItemEx("ShurikenSpawn2",0,0,0,0,0,0,0)
		Stop
	SpawnShuriken3:
		TNT1 A 0 A_SpawnItemEx("ShurikenSpawn3",0,0,0,0,0,0,0)
		Stop
	SpawnShurikenItem:
		TNT1 A 0 A_SpawnItemEx("ShurikenAmmo",0,0,12,Random(-4,0),Random(-4,4),Random(4,6))
		Stop
	XDeath:
		TNT1 A 0
		Stop
	}
}
Actor AerialShurikenProjectile : ShurikenProjectile {
	DamageType "AerialShuriken"
}
Actor KunaiProjectile : FastProjectile {
