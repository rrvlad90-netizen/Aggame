ACTOR ShurikenSpawn1 {
	Height 8
	Radius 6
	Speed 4
	Health 1
	Mass 1
	Scale 1
	PROJECTILE
    +CLIENTSIDEONLY
	+NOTELEPORT	
	+DOOMBOUNCE
	+NOBLOCKMAP
	+MOVEWITHSECTOR
