	AerialKick:
		NJKB C 1 ACS_NamedExecuteAlways("ZangetsuStates",0,34,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		NJKB C 1 ACS_NamedExecuteAlways("ZangetsuStates",0,34,0)
		TNT1 A 0 A_TakeInventory("AerialKick",1)
		TNT1 A 0 A_PlaySound("ninja/attack")
		TNT1 A 0 ThrustThingZ(0,35,0,0)
		NJKB DEFJKL 1 
		TNT1 A 0 A_Recoil(-5)
		TNT1 A 0 ThrustThingZ(0,-30,0,0)
		NJKZ ABCD 1
	AerialKickFalling:
		NJKZ E 1 A_Gravity
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		TNT1 A 0 A_FireCustomMissile("AerialKickHitBox",0,0,0,0,0,-65)
		TNT1 A 0 A_SpawnItemEx("AerialKickFX",16,4,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_JumpIfInventory("AerialKickBounce",1,"AerialKickBounce")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"AerialKickLand")
		Loop
	AerialKickBounce:
	    NJKB A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,4,0)
	    NJKB A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,4,0)
		TNT1 A 0 A_PlaySound("ninja/jump")//,8)
		TNT1 A 0 A_GiveInventory("isJumping",1)
