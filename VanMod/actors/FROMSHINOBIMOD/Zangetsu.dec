	Radius 16
	Height 16
	Speed 100
	FastSpeed 100
	Scale 1.25
	DamageType "ChargeSlash"
	Damage (20)
	Decal HardAttack1
	Projectile
	+RIPPER
	+NOGRAVITY
	+NOBLOCKMAP
	+NOEXTREMEDEATH
	+BLOODSPLATTER
	States {
	Spawn:
