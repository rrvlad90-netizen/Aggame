	JumpFire:
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("AerialKick",1,"AerialKick")
		TNT1 A 0 A_JumpIfInventory("AerialHardAttack",1,"AerialHardAttack")
		TNT1 A 0 A_JumpIfInventory("AerialAttack3",1,"AerialAttack3")
		TNT1 A 0 A_JumpIfInventory("AerialAttack2",1,"AerialAttack2")
		TNT1 A 0 A_JumpIfInventory("AerialApproachAttack",1,"PreAerialAttack2")
		Goto AerialAttack1
	AerialAttack1:
		NJKW A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,31,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_ChangeVelocity (Cos(Pitch)*50, 0, Sin(Pitch) * -50, CVF_Relative)
		NJKW A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,31,0)
		TNT1 A 0 A_TakeInventory("AerialAttack1",1)
		TNT1 A 0 A_PlaySound("ninja/attack")
		TNT1 A 0 A_Stop
		TNT1 A 0 A_LowGravity
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_CustomPunch(0,TRUE,0 ,"AerialAttack1Screech",64)
		TNT1 A 0 A_SpawnItemEx("AerialSlash1FX",16,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		NJKW CDF 1
		TNT1 A 0 A_FireCustomMissile("AerialAttackHitBox1",0,0,0,0,FPF_NOAUTOAIM)
		NJKW GIJ 2 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		TNT1 A 0 A_GiveInventory("AerialAttack2",1)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		NJKW LMNOPQRST 1 A_WeaponReady
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Falling
	PreAerialAttack2:
		TNT1 A 0 A_ChangeVelocity (Cos(Pitch)*100, 0, Sin(Pitch) * -100, CVF_Relative)
		TNT1 A 0 A_LowGravity
		TNT1 A 0 A_TakeInventory("AerialApproachAttack",1)
	AerialAttack2:
		NJKX A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,32,0)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_ChangeVelocity (Cos(Pitch)*50, 0, Sin(Pitch) * -50, CVF_Relative)
		NJKX A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,32,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_TakeInventory("AerialAttack2",1)
		TNT1 A 0 A_PlaySound("ninja/attack")
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_CustomPunch(0,TRUE,0 ,"AerialAttack2Screech",64)
		TNT1 A 0 A_SpawnItemEx("AerialSlash2FX",16,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		NJKX CDFG 1
		TNT1 A 0 A_FireCustomMissile("AerialAttackHitBox2",0,0,0,0,FPF_NOAUTOAIM)
		NJKX IJL 2 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		TNT1 A 0 A_GiveInventory("AerialAttack3",1)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		NJKX MNOPQR 1 A_WeaponReady
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		Goto Falling
	AerialAttack3:
		NJKY A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,33,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,0,0)
		TNT1 A 0 A_ChangeVelocity (Cos(Pitch)*50, 0, Sin(Pitch) * -50, CVF_Relative)
		NJKY A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,33,0)
		TNT1 A 0 A_TakeInventory("AerialAttack3",1)
		TNT1 A 0 A_PlaySound("ninja/attack")
		TNT1 A 0 A_Recoil(-1)
		NJKY CDFG 1
		TNT1 A 0 A_CustomPunch(0,TRUE,0 ,"AerialAttack3Screech",64)
		TNT1 A 0 A_SpawnItemEx("AerialSlash3FX",16,16,0,8,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_FireCustomMissile("AerialAttackHitBox3",0,0,0,0,FPF_NOAUTOAIM)
		NJKY IJL 2 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		TNT1 A 0 A_GiveInventory("AerialKick",1)	
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		NJKY MNOPQRST 1 A_WeaponReady
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
