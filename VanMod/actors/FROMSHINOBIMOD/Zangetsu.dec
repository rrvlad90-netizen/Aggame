		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ThrowablesCheck",0,0,0) == 1,"ThrowablesCheck")
		NJKT X 1 A_WeaponReady
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ThrowablesCheck",0,0,0) == 1,"ThrowablesCheck")
