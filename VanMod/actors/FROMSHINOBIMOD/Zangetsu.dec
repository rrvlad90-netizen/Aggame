	Falling:
		TNT1 A 0 A_GiveInventory("isJumping",1)
		TNT1 A 0 A_GiveInventory("isFalling",1)
		TNT1 A 0 A_TakeInventory("AerialApproachAttack",1)
		TNT1 A 0 A_TakeInventory("AerialAttack1",1)
		TNT1 A 0 A_TakeInventory("AerialAttack2",1)
		TNT1 A 0 A_TakeInventory("AerialAttack3",1)
		TNT1 A 0 A_TakeInventory("AerialKick",1)
		TNT1 A 0 A_Gravity
		TNT1 A 0 A_SetGravity(1)
	    TNT1 A 0 ACS_NamedExecuteAlways("ZangetsuStates",0,5,0)
		NJKB P 2 A_WeaponReady	
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB Q 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
