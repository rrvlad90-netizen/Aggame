ACTOR Zangetsu : Weapon replaces Fist {
	Tag "NinjaPlayer"
	+INVENTORY.UNDROPPABLE
	States {
	Deselect:
		TNT1 A 0 A_TakeInventory("ZangetsuEquipped",1)
		TNT1 AAAAAAAAAAAAAA 0 A_Lower
		Wait
	Select:
		TNT1 A 0 A_PlaySound("weaponChange",4)
		TNT1 A 0 A_SpawnItemEx("ShockWave3",0,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("ShockWave4",0,0,24,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveInventory("ZangetsuEquipped",1)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Falling")
		TNT1 AAAAAAAAAAAAAA 0 A_Raise
		Wait
	Ready:
		TNT1 A 0 ACS_NamedExecuteAlways("ZangetsuStates",0,1,0)
	    TNT1 A 0 ACS_NamedExecuteAlways("CameraYawCheck",0,0,0)
		TNT1 A 0 A_Gravity
		TNT1 A 0 A_ChangeFlag(NOPAIN,TRUE)
		TNT1 A 0 A_ChangeFlag(NOBLOOD,FALSE)
		TNT1 A 0 A_TakeInventory("WallRunLeftAction",1)
		TNT1 A 0 A_TakeInventory("WallRunRightAction",1)
		TNT1 A 0 A_TakeInventory("PlayerGuarding",1)
		TNT1 A 0 A_TakeInventory("isAttacking",1)
		NJKA A 1 A_WeaponReady
		TNT1 A 0 A_TakeInventory("LightAttack1",1)
		TNT1 A 0 A_TakeInventory("LightAttack2",1)
		TNT1 A 0 A_TakeInventory("LightAttack3",1)
		TNT1 A 0 A_TakeInventory("LightAttack4",1)
		TNT1 A 0 A_TakeInventory("LightAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack1",1)
		TNT1 A 0 A_TakeInventory("HardAttack2",1)
		TNT1 A 0 A_TakeInventory("HardAttack3",1)
		TNT1 A 0 A_TakeInventory("HardAttack4",1)
		TNT1 A 0 A_TakeInventory("HardAttack5",1)
		TNT1 A 0 A_TakeInventory("HardAttack6",1)
		TNT1 A 0 A_TakeInventory("HardAttack7",1)
		TNT1 A 0 A_TakeInventory("HardAttack8",1)
		TNT1 A 0 A_TakeInventory("HardAttack9",1)
		TNT1 A 0 A_TakeInventory("RoundKick",1)
		TNT1 A 0 A_TakeInventory("AerialAttack1",1)
		TNT1 A 0 A_TakeInventory("AerialAttack2",1)
		TNT1 A 0 A_TakeInventory("AerialAttack3",1)
		TNT1 A 0 A_TakeInventory("AerialKick",1)
		TNT1 A 0 A_TakeInventory("AerialHardAttack",1)
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,"Running")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ThrowablesCheck",0,0,0) == 1,"ThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		Goto Ready+1
	Running:
	    TNT1 A 0 ACS_NamedExecuteAlways("ZangetsuStates",0,2,0)
	    TNT1 A 0 ACS_NamedExecuteAlways("CameraYawCheck",0,0,0)
		TNT1 A 0 A_TakeInventory("WallRunLeftAction",1)
		TNT1 A 0 A_TakeInventory("WallRunRightAction",1)
		TNT1 A 0 A_TakeInventory("isAttacking",1)
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		NJKA E 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA E 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		NJKA F 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA F 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		NJKA G 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA G 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		NJKA H 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA H 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		NJKA I 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA I 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		TNT1 A 0 A_SpawnItemEx("Footstep",0,0,0,0,0,0,0,128,0)
		NJKA J 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA J 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		NJKA K 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA K 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		NJKA L 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIfInventory("Hurt",1,"Hurt")
		NJKA L 1 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,1)
		Goto Falling
		TNT1 A 0 A_JumpIfInventory("PlayerJump",1,"Jump1")
		TNT1 A 0 A_JumpIfInventory("PlayerUser1",1,"Guard")
		TNT1 A 0 A_JumpIfInventory("PlayerUser2",1,"CheckShurikens")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SkillUseCheck",0,0,0) == 1,"SkillUseCheck")
		TNT1 A 0 A_JumpIfInventory("PlayerRunning",1,1)
		Goto Ready
		TNT1 A 0
		Goto Running+1
	Jump1:
		TNT1 A 0 A_ChangeFlag(NOPAIN,TRUE)
	    NJKA M 1 ACS_NamedExecuteAlways("ZangetsuStates",0,3,0)
	    NJKA M 1 ACS_NamedExecuteAlways("ZangetsuStates",0,3,0)
		TNT1 A 0 A_PlaySound("ninja/jump",8)
		TNT1 A 0 A_Recoil(-3)
		TNT1 A 0 ThrustThingZ(0,32,0,0)
		NJKA N 1 A_FireBullets(90,0,-1,0,"WallRunLeftCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,-64)
		NJKA N 1 A_FireBullets(-90,0,-1,0,"WallRunRightCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,64)
		TNT1 A 0 ThrustThingZ(0,24,0,0)
		NJKA O 2
		TNT1 A 0 ThrustThingZ(0,16,0,0)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 1,"WallRunLeft")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 2,"WallRunRight")
		NJKA PQ 2
		TNT1 A 0 A_GiveInventory("isJumping",1)
		NJKA R 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_FireBullets(90,0,-1,0,"WallRunLeftCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,-64)
		TNT1 A 0 A_FireBullets(-90,0,-1,0,"WallRunRightCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,64)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 1,"WallRunLeft")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 2,"WallRunRight")
		NJKA S 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_FireBullets(90,0,-1,0,"WallRunLeftCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,-64)
		TNT1 A 0 A_FireBullets(-90,0,-1,0,"WallRunRightCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,64)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 1,"WallRunLeft")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 2,"WallRunRight")
		NJKA T 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_FireBullets(90,0,-1,0,"WallRunLeftCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,-64)
		TNT1 A 0 A_FireBullets(-90,0,-1,0,"WallRunRightCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,64)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 1,"WallRunLeft")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 2,"WallRunRight")
		NJKA U 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_FireBullets(90,0,-1,0,"WallRunLeftCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,-64)
		TNT1 A 0 A_FireBullets(-90,0,-1,0,"WallRunRightCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,64)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 1,"WallRunLeft")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 2,"WallRunRight")
		NJKA V 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("DoubleJump",1,"Jump2")
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_FireBullets(90,0,-1,0,"WallRunLeftCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,-64)
		TNT1 A 0 A_FireBullets(-90,0,-1,0,"WallRunRightCheckSpawner",FBF_EXPLICITANGLE|FBF_NOPITCH,32,"NullPuff",0,64)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 1,"WallRunLeft")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WallRunCheck",0,0,0) == 2,"WallRunRight")
		Goto Falling
	Jump2:
		TNT1 A 0 A_TakeInventory("WallRunLeftAction",1)
		TNT1 A 0 A_TakeInventory("WallRunRightAction",1)
		TNT1 A 0 A_CustomMissile("SmokeCircleGenerator", 24, 0, 30, 2, 0)
		TNT1 A 0 A_SpawnItemEx("ShockWave2",0,0,0,0,0,0,0,128,0)
	    NJKB A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,4,0)
	    NJKB A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,4,0)
		TNT1 A 0 A_PlaySound("ninja/jump",8)
		TNT1 A 0 A_GiveInventory("isJumping",1)
		TNT1 A 0 A_GiveInventory("AerialApproachAttack",1)
		TNT1 A 0 A_TakeInventory("DoubleJump",1)
		TNT1 A 0 A_Recoil(-3)
		TNT1 A 0 ThrustThingZ(0,32,0,0)
		NJKB B 1 
		NJKB C 1 ThrustThingZ(0,16,0,0)
		NJKB D 1
		NJKB E 1 ThrustThingZ(0,8,0,0)
		NJKB F 1
		NJKB G 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		NJKB H 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		NJKB I 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		NJKB J 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB K 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB L 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB K 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB J 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		NJKB O 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFeetCollision",0,1,0) == 1,"Land")
		Goto Falling
	WallRunLeft:
	    NJA2 A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,55,0)
		TNT1 A 0 A_TakeInventory("WallRunRightAction",1)
		TNT1 A 0 ACS_NamedExecuteAlways("PlayerMoving",0,1,0)
	    TNT1 A 0 ACS_NamedExecuteAlways("CameraYawCheck",0,0,0)
		TNT1 A 0 A_TakeInventory("isJumping",1)
	    NJA2 A 1 ACS_NamedExecuteAlways("ZangetsuStates",0,55,0)
		TNT1 A 0 A_TakeInventory("WallRunLeftAction",1)
		TNT1 A 0 A_SpawnItemEx("Footstep",0,0,0,0,0,0,0,128,0)
		TNT1 A 0 A_GiveInventory("AerialApproachAttack",1)
		TNT1 A 0 A_GiveInventory("isJumping",1)
		TNT1 A 0 A_Recoil(-3)
		TNT1 A 0 ThrustThingZ(0,50,0,0)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialThrowablesCheck",0,0,0) == 1,"AerialThrowablesCheck")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AerialSkillUseCheck",0,0,0) == 1,"AerialSkillUseCheck")
		NJA2 B 2 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("KnockDown",1,"KnockDown")
