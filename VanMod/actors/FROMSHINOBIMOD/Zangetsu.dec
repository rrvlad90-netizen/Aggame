		TNT1 AAAAA 0 A_SpawnItemEx("KatanaParticleSpawner2",0,Random(-16,16),0,Random(-16,16),Random(-16,16),Random(-16,16),0,0,128)
		SLFX E 1 A_SpawnItemEx("ChargeSlashTrail",-64,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop
	Death:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("katana/Screech")
		TNT1 A 1 A_SpawnItemEx("RicochetSparkSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	XDeath:
		TNT1 A 0 A_PlaySound("katana/Screech")
		TNT1 A 1 A_SpawnItemEx("RicochetSparkSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}
