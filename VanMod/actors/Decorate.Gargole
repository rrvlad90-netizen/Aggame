actor CursedGargole replaces Cacodemon
{
Health 120
	PainChance 164
	Speed 7
	Radius 25
	Height 48
	Mass 400
	MaxStepHeight 24
	MaxDropOffHeight 64
	MONSTER
	+SLIDESONWALLS
	+FLOORCLIP
	+NOBLOOD
	+FLOATBOB
	+FORCERADIUSDMG
  SeeSound "zombie_at"
  DeathSound "monster_zombie_warlord_death"
  HitObituary "Fallen by cursed gargole"
  //Scale 0.80
  states
  {
  Spawn:
    GRFL ABCD 7 A_Look//Ex(0,0,0,0,120,"See")
    loop
  See:
    GRFL ABCD 7 A_Chase
    loop
  Pain:
    GRFL EE 6 A_Pain
    goto See
  Missile:
    GRFL EFGHEFG 2 A_FaceTarget
	GRFL G 2 A_FaceTarget
	TNT1 A 0 A_HeadAttack
	GRFL GFE 2 A_FaceTarget
	GRFL ABCD 7 A_FaceTarget
	goto See
  Death:
	GRFL  E 2 A_Scream
	GRFL  F 2 A_Fall
	GRFL  G 2
	GRFL  GGGGGGGGGGG 2 A_FadeOut(0.2)
	stop
  }
}