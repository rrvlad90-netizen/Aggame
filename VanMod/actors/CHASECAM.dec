ACTOR ChaseCam {
	Species "Monster"
	Monster
	-CANPASS
	-COUNTKILL
	+NOTRIGGER
	+NODAMAGE
	+NOGRAVITY
	+NOBLOCKMAP
	+NOCLIP
	+NOTIMEFREEZE
	+THRUACTORS
	+NODECAL
	+MTHRUSPECIES
	+GHOST
	-SOLID
	States {
	Spawn:
		TNT1 A -1 A_NoBlocking
		Stop
	}
}
ACTOR ChaseCamWaypoint : ChaseCam {
	Species "Monster"
	+NOBLOCKMONST
	+BLOODLESSIMPACT
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+THRUACTORS
	+MTHRUSPECIES
	+GHOST
	-SOLID
	States {
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteAlways("WaypointSpawn", 0)
		Goto Spawn2
	Spawn2:
		TNT1 A -1 A_NoBlocking
		Stop
	}
}

ACTOR WarpToWaypoint : CustomInventory {
	Species "Monster"
	+MTHRUSPECIES
	+THRUACTORS
	-SOLID
	States {
	Pickup:
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Warp(AAPTR_MASTER, 0, -45, 0, 0, WARPF_WARPINTERPOLATION|WARPF_NOCHECKPOSITION|WARPF_STOP)
		Stop
	}
}