ACTOR LeperMonk replaces Archvile  //: PKM_Monster
{
	//$Angled
	//$Category "MUTILATOR Monsters"
	//$Color 12
	//$Title "Leper Monk"
	//Game Doom
	Health 200
	Radius 20
	Height 56
	Speed 6
	//PKM_Monster.PostSpeed 7.5
	//PKM_Monster.TurnSpeed 15.0
	Mass 9999
	//GibHealth -59
	PainChance 70
	//DamageType "Melee"
	BloodColor Black
	Monster
	MeleeRange 128
	//Species "Monsters"

	//Tag "Leper Monk"
	//PushFactor 0
	//RipLevelMin 999 // for stakegun and soulreaper death
	SeeSound "lepperm-halt"
	PainSound "lepperm-hit"
	DeathSound "lepperm-death"
	ActiveSound "lepperm-halt"
	//MeleeSound ""
	Obituary "was turned into a personal zombie slave by leper monk."
	DamageFactor "Ice", 255
	//DamageFactor "Stakegun", 2.5
	//DamageFactor "WitchScreamDMG", 0
	//DropItem "GrenadeAmmo" 15
	MaxTargetRange 2048
		//+QuickToRetaliate
		+FloorClip
		+NoTarget
		//+JumpDown
		+LookAllAround
		+InterpolateAngles
		//+DontHarmSpecies
		//+DontHarmClass
		+MissileMore
		+MissileEvenMore
		//+NoFear
		//+DontRip
	States
	{
	Spawn:
		IDLE A 1 A_Look //Ex(0,0,maxSeeDist,0,fov,"See")
		Loop

	See:
		WALK AABBCCDDEEFFGGHHIIJJK 1 A_Chase
		Loop

	Missile:
		//"####" "#" 0 A_VileTarget //("LeperMonkSummonerSparks")
			"####" "#" 0 {
			A_PlaySound("lepperm-corpsemagic",1);
			A_PlaySound("leper-tube_prepare",5);
			//A_CustomMissile("LeperMonkMagicPush",10,0,0,0);
			}
        SHOT AAA 2 A_FaceTarget
		SHOT AABBCCDD 2 A_FaceTarget // Light("RedSmallFlicker3DLS") {A_FaceTarget;  A_SpawnItemEx("LeperMonkHandSparks",0,0,35,frandom(0.1,2.0),frandom(3,-3),frandom(1,-1),0,SXF_NOCHECKPOSITION);}

			"####" "#" 0 A_PlaySound("lepper-charm-loop")
			"####" "#" 0 A_CustomMissile("LeperMonkMagicPush",10,0,0,0)


		SHOT DEFFFFFFFFFFFF 4 A_FaceTarget //Light("RedBigPoint1DLS") 
		"####" "#" 0
		Goto See

	Pain:
		TNT1 A 0 A_Pain
		PAIN ABCDE 5
		Goto See

	Death:
		"####" "#" 0 A_Scream
		THRW ABCDE 7 A_FaceTarget
		THRW EEEEEEEEEEEEEEEEE 2 A_FadeOut(0.2)
		Stop
		/*
		THRW EFGH 6 A_FaceTarget
		"####" "#" 0 A_Fall
		THRW HIJK 6 A_FaceTarget
		THRW KL 2
		THRW L 10
		THRW LLLLLLLLLLLLLLLLLLL 2 A_FadeOut(0.2)
		*/
	}
}


ACTOR LeperMonkMagicPush: BaronBall
{
	Radius 0.1
	Height 0.1
	//DamageType Rip
	Projectile
	+RANDOMIZE
    Damage (random(3,5))
	//+FORCEXYBILLBOARD
    //+THRUGHOST
    //-BLOODSPLATTER
    //+BLOODLESSIMPACT
	RenderStyle Add
	Alpha 0.6
	HitObituary "$OB_IMPHIT"
      Obituary "$OB_IMPHIT"
	//+DONTHURTSPECIES

	//SeeSound "None"
	//DeathSound "none"
	//Decal "none"
    Speed 60
	States
	{
	Spawn:
		LEYS A 1 BRIGHT
		Loop
		
	See:
		LEYS A 1 BRIGHT
		Loop
	Xdeath:
		LEYS A 1
		LEYS A 1
        LEYS A 1 A_PlaySound("lepper-odrzut")

		Stop
	Death:
		LEYS A 1
		LEYS A 1
		LEYS A 1 BRIGHT
		Stop
	}
}

