Actor LeperMonsterSpawner
{
	Speed 12
	Radius 32
	Height 4
	Damage 0
	Projectile
	+THRUACTORS
	+DONTSPLASH
	-NOGRAVITY
	+FORCEXYBILLBOARD
	+BOUNCEONWALLS
	+SKYEXPLODE
	+STEPMISSILE
	BounceFactor 1.0
	WallBounceFactor 1.0
	RenderStyle None
	States
	{
	Spawn:
		BAL1 A 8
		BAL1 A 0 A_Stop
		Goto Death
	Death:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx("LeperTeleportFog",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 1 A_SpawnItemEx("PKM_Monsters_SummonHenchmanSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
		Stop
	}
}


Actor LeperTeleportFog
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 0.99
	Scale 1.3
	States
	{
	Spawn:
		DB26 A 0
		DB26 A 0 A_PlaySound("Doom4/Monsters/ArchvilePortal",6,1.0,false,1.2)
		DB26 ABCDEFGHIIJJKKLLMMNNOO 1 Bright
		DB26 PQQRRSSTTUUVV 1 Bright A_FadeOut(0.035)
		Stop
	}
}


Actor LeperMonkHandSparks	//spawned in the hands of the LeperMonk
{
	+NOINTERACTION
	Scale 0.4
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[2.0,0.0,0.0]"
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,1,2,3,4,5,6,7,8)
		X079 ABCDEFGH 0	A_Jump(256,"Perform")
	Perform:
		"####" "#" 1 Bright A_FadeOut(0.05)
		Loop
	}
}


Actor LeperMonkSummonerSparks
{
	+NOINTERACTION
	+BRIGHT
	+FORCEXYBILLBOARD
	Translation "0:255=%[0,0,0]:[1.0,0.0,0.0]"
	Scale 0.4
	RenderStyle Add
	Alpha 0.99
	Height 1
	Radius 1
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_PlaySound("Doom4/Monsters/ArgentCharge",6,0.8,false,1.2)
		DB66 ABCDE 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 FGHIJ 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 LKMNO 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 PQRST 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 UVWXY 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 ABCDE 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 FGHIJ 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 LKMNO 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 PQRST 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		DB66 UVWXY 1 Light("RedMediumFlicker2") A_Fire(35)
		TNT1 A 0 A_SetScale(frandom(0.25,0.45))
		STOP

	}
}


ACTOR LeperMonkRessurectOthers
{
	Height 0
	Radius 0
	RenderStyle "None"
	RenderRadius -1
	FloatBobPhase 0
		+NOCLIP
		+NOGRAVITY
		+NOINTERACTION
		+CLIENTSIDEONLY
		+INVISIBLE
		+NOTONAUTOMAP
		+NOTRIGGER
		+CANNOTPUSH
		+NoGravity
		+NOTIMEFREEZE
		+NOTAUTOAIMED
		+NeverRespawn
		+SYNCHRONIZED
		+NOTELEPORT
		+NoBlockMap
		+DONTBLAST
		+DONTGIB
		+THRUACTORS
		+DONTTHRUST
		+CLIENTSIDEONLY
		+NONETID
	States
	{
	Spawn:
		TNT1 A 0 NoDelay
		TNT1 A 5 A_VileChase
		Stop
	}
}
