Actor CyberSpawn: RandomSpawner replaces Cyberdemon
{
DropItem "LeperMonk", 255, 255
}

Actor SpiderSpawn: RandomSpawner replaces SpiderMastermind
{
DropItem "LeperMonk", 255, 255
}