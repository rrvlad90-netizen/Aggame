//================================================================================================================
//================================================================================================================
//
//	Beast from Painkiller: Heavens got a Hitman [People Can Fly]
//	Code by me [Kill.Murphy]
//
//================================================================================================================
//================================================================================================================

ACTOR Beast666 replaces Spectre
{
	//$Angled
	//$Category "MUTILATOR Monsters"
	//$Color 12
	//$Title "Beast"

	+InterpolateAngles
	+FloorClip
	//+ForceRadiusDMG
	//+JumpDown
	//+DontHarmSpecies
	//+DontHarmClass

	Monster
	Health 120
	//scale 2.7
	Speed 6
	
	
	//TurnSpeed 15



	Radius 30
	Height 30
	Mass 800
	PainChance 150
	SeeSound		"beast_halt"
	PainSound		"beast_hit"
	DeathSound	"beast-death"
	ActiveSound	"beast_idle3"
	AttackSound	"beast_attack1"


	MeleeDamage 5
	MeleeRange 64
//	MeleeThreShold 96
	MaxTargetRange 256

	Obituary "%o has been devoured by a demonic dog."
	States
	{

	Spawn:
		0002 A 0 
		TNT1 A 0
		TNT1 A 0
		TNT1 A 0
	//	TNT1 A 0 a_SpawnItemEx("PK_FlameParticleMonster",0,0,48,0,0,0,0,SXF_SETMASTER) // spawn the headshot hitbox and set as master
	//StandStill:
	Idle:
		0002 MNOPQRSTUVWXYZ 1 A_Look
		0003 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_Look
		0004 ABCDEFGHIJK 1 A_Look
		Loop



	See:
		0001 HIJKLMNOPQRSTUVWXYZ 1 A_Chase
		0002 ABCDEFGHIJKL 1 A_Chase
		loop



	Pain:
		"####" "#" 0 A_Pain
		0004 LMNOPQRSTUVWXY 1
		0005 ABCDEFG 1
		Goto See


	Melee:
		"####" "#" 0 A_FaceTarget
		PATK A 0 A_PlaySound("beast_attackscream") //A_PlaySound("beast_attackscream",7,1.0,false,1.2)
		0000 BCDEF 1 A_FaceTarget
		0000 G 1 A_SargAttack
		0000 HIJKLMNOPQRSTUVWXYZ 1
		0001 ABCDEFG 1
		Goto See

	Missile:
		"####" "#" 0 A_FaceTarget
		0002 HIJKL 2 A_FaceTarget		"####" "#" 0  A_PlaySound("beast_to_ball")

		0000 A 0 A_Recoil(-2)
		// full acceleration round 1

		0009 A 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")

		0009 B 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")


		0009 C 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")

		0009 D 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")

		// full acceleration round 2

		0009 E 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
		0009 F 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")

		0009 G 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
		0009 H 1 A_Recoil(-5)			"####" "#" 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
		//slowing down

		0009 I 1 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")			"####" "#" 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
		0009 J 1 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")			"####" "#" 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)

		0009 K 1 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")			"####" "#" 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
		0009 K 1 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")			"####" "#" 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
		Goto See

		CrashedSomewhere:
			"####" "#" 0
			"####" "#" 0
			"####" "#" 0 A_PlaySound("beast_roll-hit")
			"####" "#" 0 //A_SpawnItemEx("PinkyDustCloud",20,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 0 //A_SetDamageType("BeastRam")
			"####" "#" 0 A_Explode(15,25,XF_NOTMISSILE,0,25)
			"####" "#" 0 //A_SetDamageType("Normal")
            0000 B 40
			Goto See



	Death:
		"####" "#" 0 A_UnsetSolid
		"####" "#" 0 A_KillChildren
		OFCR H 0 A_Scream
		OFCR I 0 A_Fall
		0005 HIJKLMNOPQRSTUVWXYZ 1
		0006 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1
		0007 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1
		0008 ABC 1
		"####" "#" 0 //A_ChangeFlag("CORPSE",1)
		0008 c 600
		0008 cccccccccccc 2 A_Fadeout(0.2)
		Stop

	
	Raise:
		TNT1 A 0 //A_CheckFlag("FRIENDLY", "RaiseFriendly")
		"####" "#" 0 //A_SetTranslation("MonsterRessurectedRed")

		Goto RaiseUp

	RaiseUp:
		TNT1 AAAAA 4
		"####" "#" 0 //A_SpawnItem("TeleportFog",5)
		Goto See
	}
}




