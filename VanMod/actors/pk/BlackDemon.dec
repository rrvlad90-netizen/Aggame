ACTOR BlackDemon  //: PKM_Monster
{
	//$Angled
	//$Category "MUTILATOR Monsters"
	//$Color 12
	//$Title "Black Demon"
	Game Doom
	Health 600
	Radius 24
	Height 64
	Speed 8

//	PKM_Monster.PostSpeed 8
//	PKM_Monster.TurnSpeed 15.0
//	MaxStepHeight 128

	Mass 9999
	PainThreshold 100
	PainChance 15
	damagetype "Melee"
	DeathHeight 4
	BurnHeight 4
	Monster
	//scale 1.0
	Species "Monsters"
	damagefactor "Ice", 0
//	DamageFactor "WitchScreamDMG", 0
	SeeSound "bdemon_halt"
	ActiveSound "bdemon_attackscream"
	PainSound "bdemon_hit"
	DeathSound "bdemon_death"
//	Tag "Demon Leader"
//	MeleeRange 110
//	MeleeThreshold 240
// DropItem "Clip"
//	DropItem "PKM_Soul_Red"
	Obituary "%o was gutted by a Black Demon"
	HitObituary "%o was gutted by a Black Demon"

	//+InterpolateAngles
	+Boss
	+FloorClip
	//-LookAllAround
	//+JumpDown
	//+DontHarmSpecies
	//+DontHarmClass
	//+NoFear
	//+DontRip
	//+DontGib

	States
	{

	Spawn:
		IDLE AABBCCDDEEF 3 A_Look
		Loop
	See:
		"####" "#" 0 A_PlaySound("bdemon_krokl",6)
		WALK ABCDEFGHIJKLMNOP 1 A_Chase
		"####" "#" 0 A_PlaySound("bdemon_krokp",6)
		WALK QRSTUVWXYZ 1 A_Chase
		WA1K ABCDE 1 A_Chase
		Loop

	Melee:
		"####" "#" 0 A_FaceTarget
		"####" "#" 0 A_PlaySound("bdemon-angry",5)
		MELE ABCDEFGHIJKLMNO 1 A_FaceTarget
		"####" "#" 0 A_CustomMeleeAttack(70,"bdemon-hand-hit")
		MELE PQRSTUVWXYZ 1 A_FaceTarget
		Goto See

	Missile:
		"####" "#" 0 A_FaceTarget
		"####" "#" 0 A_Jump(128,2)
		SPEL ABCDEFGHIJKLMNO 1 A_FaceTarget
		"####" "#" 0 {
			A_PlaySound("nun-charm-shoot",5);
			A_PlaySound("nun_fireball_sight",1);
			A_CustomMissile ("PKM_BlackDemonWeakBall", 56, 0, 0, 0, 0);
			A_CustomMissile ("PKM_BlackDemonWeakBall", 76, 0, 0, 0, 0);
			}
		SPEL PQRSTUVWXYZ 1 A_FaceTarget
		Goto See

	Pain:
		"####" "#" 0 A_Pain
		pain ABCDEFGHIJK 4
		Goto See

	Death:
		"####" "#" 0 A_Scream
		DIE0 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2
		DIE1 ABCDEFG 2
			"####" "#" 0 {
			A_PlaySound("general_bodyfalls");
			A_SpawnItem ("GrowingBloodPool");
		}
		DIE1 GHIJKLMNOP 2
		DIE1 P 600
		DIE1 PPPPPPPPPPPP 8 A_FadeOut(0.2)
		Stop

	Raise:
		TNT1 A 0 //A_CheckFlag("FRIENDLY", "RaiseFriendly")
		"####" "#" 0 //A_SetTranslation("MonsterRessurectedRed")

		Goto RaiseUp

		RaiseUp:
			TNT1 AAAAA 4
			"####" "#" 0 //A_SpawnItem("TeleportFog",5)
			Goto See
	}
}

