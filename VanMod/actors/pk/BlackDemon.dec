ACTOR FatsoSapwn: randomspawner replaces Fatso
{
DropItem "BlackDemon", 255, 255
DropItem "GladiatorBoss", 255, 255
}



Actor PKM_BlackDemonNormalBall
{
	radius 3
	height 3
	speed 21
	renderstyle add
	scale 1.75
	damage (random(38,44))
	PROJECTILE
	SeeSound "fireball/fire"
	DeathSound "fireball/explode"
	+FORCEXYBILLBOARD
	states{
		Spawn:
			TNT1 A 0 NoDelay
		SpawnLooper:
			FVN1 ABCD 1 bright A_SpawnItemEx("PKM_BlackDemon_NormBallTrailSpawner",0,0,0, 0,0,0)
			loop
		death:
			TNT1 AAAA 0 A_SpawnItemEx("PKM_BlackDemon_BoomFire",0,0,0, 0,frandom(-1.2,1.2),frandom(-1.2,1.2))
			TNT1 AAAA 0 A_SpawnItemEx ("PKM_BlackDemon_BoomFireSpark", 0, 0, 0, frandom(0.7,1.3), random(3,5) , random(0,4) , random(180,360))
			FVN1 EFGHIJ 2 bright
			stop
	}
}

actor PKM_BlackDemonWeakBall : PKM_BlackDemonNormalBall
{
	Gravity 0.1
	scale 1.4
	speed 24
	-NOGRAVITY
	damage (random(28,34))
	states {
		spawn:
			TNT1 A 0 NoDelay
		SpawnLooper:
			//NULL A 0 A_PlaySound("fireball/loop",5,1,0,ATTN_NORM)
			FVN1 ABCD 1 bright A_SpawnItemEx("PKM_BlackDemon_WeakBallTrailSpawner",0,0,0, 0,0,0)
			loop
		death:
			TNT1 AAA 0 A_SpawnItemEx("PKM_BlackDemon_BoomFire",0,0,0, 0,frandom(-1.1,1.1),frandom(-1.1,1.1))
			FVN1 EFGHIJ 2 bright
			stop
	}
}

actor PKM_BlackDemonStrongBall : PKM_BlackDemonNormalBall
{
	speed 28
	renderstyle translucent
	scale 0.7
	alpha 1.0
	damage (random(48,62))
	PROJECTILE
	SeeSound "fireball/fire"
	DeathSound "weapons/firex3"
	states{
		spawn:
			TNT1 A 0
		SpawnLooper:
			ARCB ABC 1 bright A_SpawnItemEx("PKM_BlackDemon_StrongBallTrailSpawner",0,0,0, 0,0,0)
			loop
		death:
			TNT1 AAAA 0 A_SpawnItemEx("PKM_BlackDemon_StrongBoom",0,0,0, 0,0,0)
			TNT1 AAAAAA 0 A_SpawnItemEx("PKM_BlackDemon_BoomFire",0,0,0, 0,frandom(-2.6,2.6),frandom(-2.6,2.6))
			TNT1 AAAAAA 0 A_SpawnItemEx ("PKM_BlackDemon_BoomFireSpark", 0, 0, 0, frandom(1.6,2.2), random(4,6) , random(0,5) , random(180,360))
			TNT1 A 1 A_Explode(30,90,0)
			stop
	}
}

//
actor PKM_BlackDemon_NormBallTrailSpawner
{
	+NOINTERACTION
	States
	{
		spawn:
			TNT1 A 0 NoDelay
			TNT1 A 0 A_SpawnItemEx("PKM_BlackDemon_NormBallFlare",0,0,0, 0,0,0)
			TNT1 AAA 0 A_SpawnItemEx("PKM_BlackDemon_NormBallTrail",-7,0,0, 0,frandom(-1.2,1.2),frandom(-1.2,1.2))
			stop
	}
}

actor PKM_BlackDemon_WeakBallTrailSpawner
{
	+NOINTERACTION
	States
	{
		spawn:
			TNT1 A 0 NoDelay
			TNT1 A 0 A_SpawnItemEx("PKM_BlackDemon_WeakBallFlare",0,0,0, 0,0,0)
			TNT1 AAA 0 A_SpawnItemEx("PKM_BlackDemon_WeakBallTrail",-7,0,0, 0,frandom(-1.2,1.2),frandom(-1.2,1.2))
			stop
	}
}

actor PKM_BlackDemon_StrongBallTrailSpawner
{
	+NOINTERACTION
	states {
		spawn:
			TNT1 A 0 NoDelay
			TNT1 A 0 A_SpawnItemEx("PKM_BlackDemon_StrongBallFlare",-1,0,0, 0,0,0)
			TNT1 A 0 A_SpawnItemEx("PKM_BlackDemon_StrongBallTrail2",-2,0,0, 0,frandom(-1.2,1.2),frandom(-1.2,1.2))
			TNT1 AAA 0 A_SpawnItemEx("PKM_BlackDemon_StrongBallTrail",-7,0,0, 0,frandom(-1.8,1.8),frandom(-1.8,1.8))
			stop
	}
}

//
actor PKM_BlackDemon_NormBallFlare
{
	alpha 0.7
	scale 0.3
	renderstyle add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+NOTELEPORT
	states{
		spawn:
			TNT1 A 0
			LEYS G 1 bright
			stop
	}
}

actor PKM_BlackDemon_WeakBallFlare : PKM_BlackDemon_NormBallFlare
{
	alpha 0.5
	scale 0.2
}

actor PKM_BlackDemon_StrongBallFlare : PKM_BlackDemon_NormBallFlare
{
	alpha 0.5
	scale 0.4
}

actor PKM_BlackDemon_NormBallTrail
{
	scale 0.26
	alpha 1.0
	renderstyle add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+NOTELEPORT
	states
	{
		spawn:
			PFGR ABCDEFGHIJKL 1 bright A_FadeOut(0.08)
			stop
	}
}

actor PKM_BlackDemon_WeakBallTrail : PKM_BlackDemon_NormBallTrail { scale 0.16 }
actor PKM_BlackDemon_AtckChrgTrail : PKM_BlackDemon_NormBallTrail { scale 0.5 }
actor PKM_BlackDemon_StrongBallTrail : PKM_BlackDemon_NormBallTrail { scale 0.32 }

actor PKM_BlackDemon_StrongBallTrail2
{
	scale 0.5
	alpha 0.8
	renderstyle add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+NOTELEPORT
	states
	{
		spawn:
			ARBE ABCDEF 2 bright A_FadeOut(0.08)
			stop
	}
}


actor PKM_BlackDemon_BoomFire
{
	scale 0.95
	alpha 1.0
	renderstyle add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+NOTELEPORT
	States
	{
		spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump(255,"sp1","sp2","sp3")
		sp1:
			PFGR A 1 bright A_FadeOut(0.06)
			loop
		sp2:
			PFGR B 1 bright A_FadeOut(0.06)
			loop
		sp3:
			PFGR C 1 bright A_FadeOut(0.06)
			loop
	}
}

actor PKM_BlackDemon_StrongFireShot : PKM_BlackDemon_BoomFire { scale 0.8 }

actor PKM_BlackDemon_BoomFireSpark
{
	radius 2
	height 2
	scale 0.35
	alpha 1.0
	gravity 0.3
	renderstyle add
	+FORCEXYBILLBOARD
	+NOTELEPORT
	+FLOORCLIP
	States
	{
		spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump(255,"sp1","sp2","sp3")
		sp1:
			TNT1 A 0 A_SpawnItemEx("PKM_BlackDemon_BoomFireSparkTrail",0,0,0, 0,0,0)
			PFGR A 1 bright A_FadeOut(0.08)
			loop
		sp2:
			TNT1 A 0 A_SpawnItemEx("PKM_BlackDemon_BoomFireSparkTrail",0,0,0, 0,0,0)
			PFGR B 1 bright A_FadeOut(0.08)
			loop
		sp3:
			TNT1 A 0 A_SpawnItemEx("PKM_BlackDemon_BoomFireSparkTrail",0,0,0, 0,0,0)
			PFGR C 1 bright A_FadeOut(0.08)
			loop
	}
}

actor PKM_BlackDemon_BoomFireSparkTrail : PKM_BlackDemon_NormBallTrail { scale 0.25 alpha 1.0 }

actor PKM_BlackDemon_StrongBoom
{
	scale 0.9
	alpha 1.0
	renderstyle add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+NOTELEPORT
	states
	{
		Spawn:
			ARBX ABCDE 2 bright
			stop
	}
}

