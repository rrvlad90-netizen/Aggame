ACTOR Shotgun2 : Shotgun replaces Shotgun
{
	Weapon.KickBack 100
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "Shell"

	Inventory.PickupMessage "$GOTSHOTGUN"
	Obituary "$OB_MPSHOTGUN"
	Tag "$TAG_SHOTGUN"

	+WEAPON.WIMPY_WEAPON

	DamageType "kickb"

	States
	{
	Ready:
		// Проверка выполняется до A_WeaponReady.
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"JumpLocked"
		)
		SHTG A 1 A_WeaponReady
		Loop

	JumpLocked:
		// Атаки полностью игнорируются в прыжке.
		SHTG A 1
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"JumpLocked"
		)
		Goto Ready

	Deselect:
		SHTG A 1 A_Lower
		Loop

	Select:
		SHTG A 1 A_Raise
		Loop

	Fire:
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"CancelFire"
		)

		TNT1 A 0 A_JumpIfInventory(
			"Shell",
			2,
			"RealFire"
		)

		Goto CancelFire

	RealFire:
		// Блокируем движение на весь цикл оружия.
		TNT1 A 0 A_GiveInventory(
			"VanFireLock",
			1
		)

		SHTG A 3

		// Прыжок может отменить ещё не сделанный выстрел.
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"CancelFire"
		)

		TNT1 A 0 A_SpawnItemEx(
			"YellowFlareSmall",
			45,
			10,
			38,
			0
		)

		TNT1 AAAAA 0 A_FireCustomMissile(
			"Tracer",
			random(-12, 12),
			0,
			4,
			20
		)

		TNT1 A 0 A_PlaySound(
			"weapons/shotgf",
			CHAN_WEAPON
		)

		TNT1 A 0 A_TakeInventory(
			"Shell",
			2
		)

		SHTG A 3
		SHTG BC 3
		SHTG D 4
		SHTG CB 3
		SHTG A 10

		/*
		 * При удержании огня A_ReFire перейдёт
		 * обратно в Fire, сохранив блокировку.
		 */
		TNT1 A 0 A_ReFire

		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		)

		Goto Ready

	CancelFire:
		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		)
		Goto Ready

	AltFire:
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"CancelMelee"
		)

		TNT1 A 0 A_GiveInventory(
			"Kinv",
			1
		)

		SHTG AAAAAAAAAA 1 Fast

		SHTG A 1 Fast A_CustomPunch(
			2,
			FALSE,
			0,
			BulletPuff,
			28
		)

		SHTG AAAAAAAAAAAAAAAA 1 Fast

		TNT1 A 0 A_ReFire

		TNT1 A 0 A_TakeInventory(
			"Kinv",
			1
		)

		Goto Ready

	CancelMelee:
		TNT1 A 0 A_TakeInventory(
			"Kinv",
			1
		)
		Goto Ready

	Flash:
		SHTF A 4 Bright A_Light1
		SHTF B 3 Bright A_Light2
		Goto LightDone

	Spawn:
		SHOT A -1
		Stop
	}
}


Actor Tracer: FastProjectile
{
	Projectile
	+RANDOMIZE
+FORCEXYBILLBOARD
+DONTSPLASH
   // +BLOODSPLATTER 
   +NOEXTREMEDEATH
damage 3
radius 4
height 4
speed 120
renderstyle ADD
alpha 0.9
scale .15
states
	{
	Spawn:
		TRAC A 1 BRIGHT
		Loop
Death:
    Stop
XDeath:
TNT1 A 0
Stop
	}
}


Actor YellowFlareSmall
{
//+NOCLIP
+NOINTERACTION
+NOGRAVITY
+CLIENTSIDEONLY
renderstyle Add
radius 1
height 1
+FORCEXYBILLBOARD
scale 0.15
Alpha 0.3
states
	{
	Spawn:
		TNT1 A 0
		//TNT1 A 0 A_Jump(128,2)
		LENY A 1 bright
		stop
		TNT1 A 0
		LENY B 1 bright
		stop
	}
}