ACTOR Shotgun2 : Shotgun replaces Shotgun
{
	Weapon.KickBack 100
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "Shell"

	Inventory.PickupMessage "$GOTSHOTGUN"
	Tag "$TAG_SHOTGUN"

	+WEAPON.WIMPY_WEAPON

	States
	{
	Ready:
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"JumpLocked"
		)
		SHTG A 1 A_WeaponReady
		Loop

	JumpLocked:
		SHTG A 1
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"JumpLocked"
		)
		Goto Ready

	Deselect:
		SHTG A 1 A_Lower
		Loop

	Select:
		SHTG A 1 A_Raise
		Loop


	Fire:
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"CancelFire"
		)

		TNT1 A 0 A_JumpIfInventory(
			"Shell",
			2,
			"RealFire"
		)

		Goto CancelFire

	RealFire:
		TNT1 A 0 A_GiveInventory(
			"VanFireLock",
			1
		)

		SHTG A 3

		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"CancelFire"
		)

		TNT1 A 0 A_SpawnItemEx(
			"YellowFlareSmall",
			45,
			10,
			38,
			0
		)

		TNT1 AAAAA 0 A_FireCustomMissile(
			"Tracer",
			random(-12, 12),
			0,
			4,
			20
		)

		TNT1 A 0 A_PlaySound(
			"weapons/shotgf",
			CHAN_WEAPON
		)

		TNT1 A 0 A_TakeInventory(
			"Shell",
			2
		)

		SHTG A 3
		SHTG BC 3
		SHTG D 4
		SHTG CB 3
		SHTG A 10

		TNT1 A 0 A_ReFire

		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		)

		Goto Ready

	CancelFire:
		TNT1 A 0 A_TakeInventory(
			"VanFireLock",
			1
		)
		Goto Ready


	AltFire:
		TNT1 A 0 A_JumpIfInventory(
			"Jmp2",
			1,
			"CancelMelee"
		)

		TNT1 A 0 A_GiveInventory(
			"Kinv",
			1
		)

		SHTG AAAAAAAAAA 1 Fast

		SHTG A 1 Fast A_CustomPunch(
			2,
			FALSE,
			0,
			BulletPuff,
			28
		)

		SHTG AAAAAAAAAAAAAAAA 1 Fast

		TNT1 A 0 A_ReFire

		TNT1 A 0 A_TakeInventory(
			"Kinv",
			1
		)

		Goto Ready

	CancelMelee:
		TNT1 A 0 A_TakeInventory(
			"Kinv",
			1
		)
		Goto Ready


	Flash:
		SHTF A 4 Bright A_Light1
		SHTF B 3 Bright A_Light2
		Goto LightDone

	Spawn:
		SHOT A -1
		Stop
	}
}


Actor Tracer : FastProjectile
{
	Projectile

	+RANDOMIZE
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+NOEXTREMEDEATH

	Damage 3
	Radius 4
	Height 4
	Speed 120

	RenderStyle Add
	Alpha 0.9
	Scale 0.15

	States
	{
	Spawn:
		TRAC A 1 Bright
		Loop

	Death:
		Stop

	XDeath:
		Stop
	}
}


Actor YellowFlareSmall
{
	+NOINTERACTION
	+NOGRAVITY
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD

	RenderStyle Add

	Radius 1
	Height 1
	Scale 0.15
	Alpha 0.3

	States
	{
	Spawn:
		LENY A 1 Bright
		Stop
	}
}