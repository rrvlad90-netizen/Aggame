pointlight 24SHADOW
{
    color 0.5 0.5 0.5
    size 17
    subtractive 1
    dontlightself 1

}

pointlight PlayerSHADOW
{
	color 0.5 0.5 0.5
	size 17
	subtractive 1

	dontlightself 1
	dontlightactors 1
}

pointlight 32SHADOW
{
    color 0.5 0.5 0.5
    size 21
    subtractive 1
    dontlightself 1

}

pointlight 64SHADOW
{
    color 0.5 0.5 0.5
    size 49
    subtractive 1
    dontlightself 1

}


object VanVisualLegs
{
	// Обычное движение
	frame VLST { light PlayerSHADOW }
	frame VLFW { light PlayerSHADOW }
	frame VLBK { light PlayerSHADOW }
	frame VLLF { light PlayerSHADOW }
	frame VLRT { light PlayerSHADOW }
	frame VLLB { light PlayerSHADOW }
	frame VLRB { light PlayerSHADOW }

	// Присед
	frame VCST { light PlayerSHADOW }
	frame VCFW { light PlayerSHADOW }
	frame VCBK { light PlayerSHADOW }
	frame VCLF { light PlayerSHADOW }
	frame VCRT { light PlayerSHADOW }
	frame VCLB { light PlayerSHADOW }
	frame VCRB { light PlayerSHADOW }

	// Удар
	frame VANK { light PlayerSHADOW }
	frame VKAN { light PlayerSHADOW }

	// Прыжки и приземления
	frame VJNK { light PlayerSHADOW }
	frame VAJK { light PlayerSHADOW }
	frame VJBK { light PlayerSHADOW }
	frame VBJL { light PlayerSHADOW }

	// Воздушный Pain и смерть
	frame VAPN { light PlayerSHADOW }
	frame VNDD { light PlayerSHADOW }
}

object Cursedskeleton
{
    frame VSKL { light 32SHADOW  }
	frame PPKL { light 32SHADOW  }
    frame VSKA { light 32SHADOW  }
	frame VAKL { light 32SHADOW  }	
	frame VSKD { light 32SHADOW  }
	frame VSDD { light 32SHADOW  }	
}

object Cursedskeleton2
{
    frame VSKL { light 32SHADOW  }
	frame PPKL { light 32SHADOW  }
    frame VSKA { light 32SHADOW  }
	frame VAKL { light 32SHADOW  }	
	frame VSKD { light 32SHADOW  }
	frame VSDD { light 32SHADOW  }	
}


