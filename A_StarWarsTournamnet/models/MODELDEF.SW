Model VehicleRedBolt
{
   Path "models\tracer"
   Model 0 "tracer.md3"
   Skin 0 "tracer2.png"

   Scale 2.20 2.20 2.20

 PITCHFROMMOMENTUM // A flag that will fix the model pitch for projectiles  

   FrameIndex PRBT A 0 0
}


