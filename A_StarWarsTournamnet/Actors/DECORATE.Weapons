    Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR ASpan2 : Inventory {
    Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}


////items
ACTOR Medikit2 : Medikit replaces Medikit
{
	+INVENTORY.ALWAYSRESPAWN
	Inventory.RespawnTics 500
	scale 0.25
}

Actor RedSpark3
{
+NOGRAVITY
Scale 0.5
States
{
  	Spawn:
	TNT1 A 0
  	Goto Death

	Death:
	SAPR ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
	Stop
}
}

Actor BlueSpark3
{
+NOGRAVITY
Scale 0.5
States
{
  	Spawn:
	TNT1 A 0
  	Goto Death

	Death:
	BAPR ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
	Stop
}
}

//-------------Standart--------------//
Actor StandartRedBolt //: FastProjectile
{
	Radius 2
	Height 2
	Speed 85  //65
	Projectile
	+NOGRAVITY
	+FORCEPAIN 
	renderstyle add
	Decal "Bullet"
	DeathSound "BoltExplode"
	States
	{
	Spawn:

		PRBT A 1 Bright 
		Loop
	Death:
   		TNT1 A 0 A_SpawnItemEx("RedSpark3")
		SPRK ABCDEFGHIJKLMNOPQRSTUVW 1 Bright
		Stop
	}
}
