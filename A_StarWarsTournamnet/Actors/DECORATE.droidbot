ACTOR bd1 : StrictRoutePawn replaces BaronofHell
{
  Health 90
  Radius 18
  Height 44   //56!! bilo
  Speed 9    //11
  PainChance 255
  Monster
  +SLIDESONWALLS
  +FLOORCLIP
  -FRIENDLY
  //+BOSS
  +NOBLOOD
  +NOPAIN
  Mass 9999
	SeeSound	"DroidSee"
	PainSound	"DroidPain"
	DeathSound	"DroidDeath"
  Obituary "You was shooted by CIS battledroid"
  
	Damagefactor "RedBolt", 0
	Damagefactor "RedBolt2", 0
	DamageFactor "VehicleRedBolt", 0
	
  //DamageFactor "EnemyBolt", 0.0
  //Damagefactor "EnemyVehicleBolt", 0
  States
  {
	Spawn:
		HET1 A 0
		HET1 A 0 Thing_ChangeTID(0, 550)
		HET1 A 0 Thing_Hate(0, 88, 3)

		HET1 A 1 A_JumpIfInventory(
			"ASpan", 1, "Spn"
		)

		HET1 A 0
		{
			StartStrictRoute(40);
		}
		Goto Diss

	Spn:
		TNT1 A 0
		Goto Route

	Route:
		HEV1 ABCDEFGHIJKLMNOPQ 1 A_Look
		TNT1 A 0 A_JumpIfInventory(
			"StrictRouteFinished", 1, "Spn2"
		)
		Loop

	Spn2:
		TNT1 A 0 A_ChangeFlag("NOPAIN",false)
		HET1 A 0
		HET1 A 1 A_Look
		Loop

	See:
		TNT1 A 0 A_ChangeFlag("NOPAIN",false)
		HEV1 ABCDEFGHIJKLMNOPQ 1 A_Chase
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_JumpIfInventory(
			"StrictRouteFinished", 1, "Spn2"
		)
		Goto Route
	
  Missile:
  TNT1 A 0 A_jump(120, "StrifeRight")
  TNT1 A 0 A_jump(120, "StrifeLeft")  
  StrifeLeft:
	TNT1 A 0 
	HEL1 ABCD 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HEL1 EFGH 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	HEL1 IJKL 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HEL1 MNOP 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_CPosRefire	
	HEL1 ABCD 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");	
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HEL1 EFGH 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	HEL1 IJKL 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");	
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HEL1 MNOP 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
    Goto See
   
  StrifeRight:
	HER1 ABCD 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");	
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HER1 EFGH 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	HER1 IJKL 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");	
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HER1 MNOP 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_CPosRefire	
	HER1 ABCD 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");	
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HER1 EFGH 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	HER1 IJKL 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 
	{
	A_PlaySoundEx("weapon/blaster/fire","SoundSlot5");	
	A_CustomMissile("InfantrymanRedBolt", 34, 0, random(-5,5));
	}
	TNT1 A 0 A_Stop 
	HER1 MNOP 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}	
    Goto See
	
 Pain:
  TNT1 A 0 A_ChangeFlag("NOPAIN",true) 
  //POSS A 0 Thing_Hate(0, 88, 3)
  HEV1 A 0 A_FaceTarget
  //POSS RQPONMLKJIHGFEDCBA 1 A_Recoil(1)
  TNT1 A 0 A_Stop
  TNT1 A 0 A_Jump(120, "StrifeRight")
  TNT1 A 0 A_Jump(120, "StrifeLeft")
  Goto See
  
    Death:
	TNT1 A 0 TakeInventory("ASpan2",1)
    TNT1 A 0 ACS_Execute(1, 0, 0)
	Death2:
    //TNT1 A 0 A_KillChildren
	TNT1 A 0 A_ClearTarget
    HED1 A 1
    HED1 B 1 A_Scream
    HED1 C 1 A_NoBlocking
    HED1 DEFGHIJKLMNOPQRSTUVWXYZ 1 Fast
	HDD1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Fast
	DDH1 ABCDEFGHIJ 1 Fast
	TNT1 A 0
    DDH1 J 180
    DDH1 J 5 A_Respawn
    Stop
		
   Diss: 
    TNT1 A 0 GiveInventory("ASpan",1)
    TNT1 A 5 A_ClearTarget
    TNT1 A 5 A_Respawn
    Stop	
	}
}


