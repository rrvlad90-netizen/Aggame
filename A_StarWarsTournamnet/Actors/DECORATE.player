ACTOR PlayerSWBF: PlayerPawn
{
  Health 100
  Radius 16
  Height 56
  Mass 100
  PainChance 255
  Speed 0.70 //0.55
  +NOBLOOD
  //	Player.RunHealth 15
	//Player.ViewHeight 56
	
  Player.DisplayName "Clone"
  Player.StartItem "CBlaster"
  Player.StartItem "Clip", 50
  Player.StartItem "RocketAmmo", 3
  Player.WeaponSlot 1, CBlaster
  
  Player.ColorRange 225, 240
  Player.ColorSet 0, "Green",         225, 240,  238
  Player.ColorSet 1, "Yellow",        114, 129,  127
  Player.ColorSet 2, "Red",           145, 160,  158
  Player.ColorSet 3, "Blue",          190, 205,  203
  
	Damagefactor "BlueBolt", 0
	Damagefactor "BlueBolt2", 0
	Damagefactor "BlueBolt3", 0

  States
  {
  Spawn:
//	HEF1 A 1 A_GiveInventory("clip",100)
//	HEF1 A 1 A_GiveInventory("RocketAmmo",2)
	HEF1 A -1
    Stop
  See:
    HEW1 ABCDEFGHIJKLMNOPQ 1 Fast
    Loop
  Melee:
  Missile:
    HEW1 HIJKLMNOPQABCDEFG 1 Fast
    Goto Spawn
  Pain:
	HEW1 A 1
    Goto Spawn
  Death:
  	TNT1 A 0 ACS_Execute(2, 0, 0)
    HDD1 B 0 A_PlayerSkinCheck("AltSkinDeath")
    HDD1 B 2 A_PlayerScream
	HDD1 B 1 A_NoBlocking
	HDD1 BCDEFGHIJKLMNOPQR 1
	TNT1 A 0
	HDF1 ABCDEFGHIJKLMNOPQ 1 
	TNT1 A 0
    HDD1 S 100  //-1
	TFOG A -1	
    Stop
  XDeath:
  	TNT1 A 0 ACS_Execute(2, 0, 0)
    HDD1 B 0 A_PlayerSkinCheck("AltSkinXDeath")
    HDD1 B 2 A_PlayerScream
	HDD1 B 1 A_NoBlocking
	HDD1 BCDEFGHIJKLMNOPQR 1
	TNT1 A 0
	HDF1 ABCDEFGHIJKLMNOPQ 1 
	TNT1 A 0
    HDD1 S 100  //-1
	TFOG A -1	
    Stop
  Burn:
  	TNT1 A 0 ACS_Execute(2, 0, 0)
    FDTH A 5 BRIGHT A_PlaySound("*burndeath")
    FDTH B 4 BRIGHT
    FDTH C 5 BRIGHT
    FDTH D 4 BRIGHT A_PlayerScream
    FDTH E 5 BRIGHT
    FDTH F 4 BRIGHT
    FDTH G 5 BRIGHT A_PlaySound("*burndeath")
    FDTH H 4 BRIGHT
    FDTH I 5 BRIGHT
    FDTH J 4 BRIGHT
    FDTH K 5 BRIGHT
    FDTH L 4 BRIGHT
    FDTH M 5 BRIGHT
    FDTH N 4 BRIGHT
    FDTH O 5 BRIGHT A_NoBlocking
    FDTH P 4 BRIGHT
    FDTH Q 5 BRIGHT
    FDTH R 4 BRIGHT
    ACLO E 35 A_CheckPlayerDone
    Wait
  AltSkinDeath:	
    HDD1 B 1 A_PlayerScream
	HDD1 B 1 A_NoBlocking
	HDD1 BCDEFGHIJKLMNOPQR 1
	TNT1 A 0
	HDF1 ABCDEFGHIJKLMNOPQ 1 
	TNT1 A 0
    HDD1 S 100  //-1
	TFOG A -1	
    Stop
  AltSkinXDeath:
    HDD1 B 1 A_PlayerScream
	HDD1 B 1 A_NoBlocking
	HDD1 BCDEFGHIJKLMNOPQR 1
	TNT1 A 0
	HDF1 ABCDEFGHIJKLMNOPQ 1
	TNT1 A 0	
    HDD1 S 100  //-1
	TFOG A -1		
    Stop
  }
}