//"Regular" trees
Model Tree2
{
	Path "models/trees"
	Model 0 "tree2.md3"
	ZOffset -16
	USEACTORPITCH
	USEACTORROLL

	FrameIndex PLAY K 0 0
}

Model Tree2_Burnt
{
	USEACTORPITCH
	USEACTORROLL

	Path "models/trees"
	Model 0 "tree2_burnt.md3"
	Model 1 "roots_large.md3"
	ZOffset -16

	FrameIndex PLAY K 0 0
//	FrameIndex MDLA A 1 0
}

