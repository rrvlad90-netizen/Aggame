	POSS A 1 ClearInventory()
    POSS A 1 A_PlayerScream
    POSS A 1 A_NoBlocking
    TNT1 AAAAAAAAAAAAAAAAAAAAAA 1
	TNT1 A 140
	TNT1 A 1 A_FadeOut
	//PLAY N -1
    Stop
  XDeath:
    TNT1 A 0 ACS_Execute(1, 0, 0)
    POSS A 0 A_PlayerSkinCheck("AltSkinXDeath")
