class ElfCrossbowFollower : Actor
{
    double JumpOffset;

    Default
    {
        Radius 0;
        Height 0;

        +NOBLOCKMAP
        +NOINTERACTION
        +NOGRAVITY
    }

    override void Tick()
    {
        Super.Tick();

        WarriorElf pawn =
            WarriorElf(Master);

        if (pawn == null ||
            pawn.player == null ||
            pawn.Health <= 0)
        {
            Destroy();
            return;
        }

        // Отображаем только при chase-камере.
        //bool showCrossbow =
        //    (pawn.player.cheats & CF_CHASECAM) != 0;
		
        // Отображаем только при chase-камере и если не прыжок назад!!!!	
		bool backwardJump =
			pawn.ElfJumpType == 1 &&
			pawn.ElfJumpPhase != 0;

		bool showCrossbow =
			(pawn.player.cheats & CF_CHASECAM) != 0 &&
			!backwardJump;
		//
		
        bInvisible = !showCrossbow;

        double wantedOffset = 0;

        // Только обычный прыжок.
        if (pawn.ElfJumpType == 2 &&
            (pawn.ElfJumpPhase == 1 ||
             pawn.ElfJumpPhase == 2))
        {
            wantedOffset = 12;   //максимальная высота подьема арбалета
        }

        if (JumpOffset < wantedOffset)
        {
            JumpOffset += 6;  //скорость поднятия абралета при прыжке 

            if (JumpOffset > wantedOffset)
                JumpOffset = wantedOffset;
        }
        else if (JumpOffset > wantedOffset)
        {
            JumpOffset -= 6; //скорость опускания абралета при прыжке 

            if (JumpOffset < wantedOffset)
                JumpOffset = wantedOffset;
        }

        A_Warp(
            AAPTR_MASTER,
            0, 0, JumpOffset,
            0,
            WARPF_NOCHECKPOSITION |
            WARPF_INTERPOLATE
        );

        Angle = pawn.Angle;
    }

    States
    {
    Spawn:
        ECBW A -1;
        Stop;
    }
}


class DoubleJumpWarriorElf : WarriorElf
{
    int JumpCount;
    bool DoubleJumpButtonWasPressed;
    bool DoubleJumpActive;

//Это отключит одиночную систему родителя у двойного эльфа, поскольку у него уже есть 
	override bool UseBotAutoJump()
	{
		return false;
	}

    override void Tick()
    {
        bool requestDoubleJump = false;
        bool jumpPressed = false;

        if (player != null)
        {
            jumpPressed =
                (player.cmd.buttons & BT_JUMP) != 0;

            bool newJumpPress =
                jumpPressed &&
                !DoubleJumpButtonWasPressed;

            // Прыжки человека.
            if (newJumpPress)
            {
                if (player.onground)
                {
                    JumpCount = 1;
                    DoubleJumpActive = false;
                }
                else if (JumpCount == 1)
                {
                    requestDoubleJump = true;
                }
            }

            DoubleJumpButtonWasPressed =
                jumpPressed;
        }

        Super.Tick();

        if (player == null || Health <= 0)
            return;

        // Сбрасываем прыжки после приземления.
        if (player.onground && !jumpPressed)
        {
            JumpCount = 0;
            DoubleJumpActive = false;
        }

        // Автоматические прыжки только для бота.
        if (player.Bot != null)
        {
            // Первый случайный прыжок с земли.
            if (player.onground && JumpCount == 0)
            {
                // 2 — примерно один прыжок
                // за несколько секунд.
                if (Random(0, 255) < 64)
                {
                    JumpCount = 1;
                    DoubleJumpActive = false;

                    // Сила первого прыжка.
                    Vel.Z = 8.0;

                    QueuedJumpType = 0;
                    ElfJumpType = 2;
                    ElfJumpPhase = 1;

                    SetStateLabel(
                        "NormalJumpStart"
                    );
                }
            }
            // Случайный второй прыжок в воздухе.
            else if (!player.onground &&
                     JumpCount == 1 &&
                     !DoubleJumpActive)
            {
                if (Random(0, 255) < 128)
                    requestDoubleJump = true;
            }
        }

        if (requestDoubleJump)
        {
            // Именно номер прыжка, не частота.
            JumpCount = 2;
            DoubleJumpActive = true;

            // Сила второго прыжка.
            Vel.Z = 11.0;

            QueuedJumpType = 0;
            ElfJumpPhase = 2;

            if (ElfJumpType == 1)
                SetStateLabel("BackJumpAir");
            else
                SetStateLabel("NormalJumpAir");
        }
    }

    override Class<Actor> GetCrossbowFollowerClass()
    {
        return "ElfDoubleCrossbowFollower";
    }
}

///Арбалет для персонажа который прыгает дважды 
class ElfDoubleCrossbowFollower : Actor
{
    double JumpOffset;

    Default
    {
        Radius 0;
        Height 0;

        +NOBLOCKMAP
        +NOINTERACTION
        +NOGRAVITY
    }

    override void Tick()
    {
        Super.Tick();

        DoubleJumpWarriorElf pawn =
            DoubleJumpWarriorElf(Master);

        if (pawn == null ||
            pawn.player == null ||
            pawn.Health <= 0)
        {
            Destroy();
            return;
        }

        bool backwardJump =
            pawn.ElfJumpType == 1 &&
            pawn.ElfJumpPhase != 0;

        bool showCrossbow =
            (pawn.player.cheats & CF_CHASECAM) != 0 &&
            !backwardJump;

        bInvisible = !showCrossbow;

        double wantedOffset = 0;

        // Обычный прыжок.
        if (pawn.ElfJumpType == 2 &&
            (pawn.ElfJumpPhase == 1 ||
             pawn.ElfJumpPhase == 2))
        {
            wantedOffset = 12;

            // Второй прыжок добавляет ещё 6.
            if (pawn.DoubleJumpActive &&
                pawn.ElfJumpPhase == 2)
            {
                wantedOffset = 13;
            }
        }

        // Скорость подъёма — 6 единиц за тик.
        if (JumpOffset < wantedOffset)
        {
            JumpOffset += 6;

            if (JumpOffset > wantedOffset)
                JumpOffset = wantedOffset;
        }
        else if (JumpOffset > wantedOffset)
        {
            JumpOffset -= 6;

            if (JumpOffset < wantedOffset)
                JumpOffset = wantedOffset;
        }

        A_Warp(
            AAPTR_MASTER,
            0, 0, JumpOffset,
            0,
            WARPF_NOCHECKPOSITION |
            WARPF_INTERPOLATE
        );

        Angle = pawn.Angle;
    }

    States
    {
    Spawn:
        ECDW A -1;
        Stop;
    }
}