    }
}

// Ноги дополнительно страйфятся на маршруте.
class StrictRouteStrafingChassis
    : StrictRouteChassis
{
    int StrafeTimer;
    int StrafeDirection;

    override void Tick()
    {
        Super.Tick();

        if (!RouteActive ||
            CurrentWaypoint == null ||
            Health <= 0)
        {
            StrafeTimer = 0;
            return;
        }

        StrafeTimer--;

        if (StrafeTimer <= 0)
        {
            // Новое направление через 15–40 тиков.
            StrafeTimer = Random(15, 40);

            if (Random(0, 1) == 0)
                StrafeDirection = -1;
            else
                StrafeDirection = 1;
        }

        double sideAngle = Angle + 90;

        // Сила страйфа.
        double strafeSpeed = 6.0;

        Vel.X += Cos(sideAngle) *
                 strafeSpeed *
                 StrafeDirection;

        Vel.Y += Sin(sideAngle) *
                 strafeSpeed *
                 StrafeDirection;
    }
}


//Player
class WarriorElf : PlayerPawn
{
    // Тип прыжка:
    // 0 — нет;
    // 1 — прыжок назад;
    // 2 — обычный прыжок.
    int ElfJumpType;

    // Фаза прыжка:
    // 0 — нет;
    // 1 — начало;
    // 2 — полёт;
    // 3 — приземление.
    int ElfJumpPhase;

    int QueuedJumpType;
    bool JumpWasPressed;
	
	
	int BotJumpCooldown;

	virtual bool UseBotAutoJump()
	{
		return true;
	}

	virtual int GetBotJumpChance()
	{
		return 64; // Частота: 2 редко, 6 чаще, 12 часто, 64 очень часто.
	}

	virtual double GetBotJumpStrength()
	{
		return 8.0; // Высота прыжка.
	}

	override void Tick()
	{
		bool stopOnFloor = false;

		if (player != null)
		{
			bool jumpPressed =
				(player.cmd.buttons & BT_JUMP) != 0;

			if (jumpPressed && !JumpWasPressed)
			{
				if (player.cmd.forwardmove < 0 &&
					player.cmd.sidemove == 0)
				{
					QueuedJumpType = 1;
				}
				else
				{
					QueuedJumpType = 2;
				}
			}

			JumpWasPressed = jumpPressed;

			stopOnFloor =
				player.onground &&
				player.cmd.forwardmove == 0 &&
				player.cmd.sidemove == 0;

			if (stopOnFloor)
			{
				Vel.X = 0;
				Vel.Y = 0;
			}
		}

		Super.Tick();

		// Принудительно запускаем прыжковую анимацию.
		if (player != null &&
			Health > 0 &&
			QueuedJumpType != 0 &&
			ElfJumpPhase == 0)
		{
			// Прыжок действительно начался.
			if (player.onground || Vel.Z > 0)
			{
				ElfJumpType = QueuedJumpType;
				QueuedJumpType = 0;
				ElfJumpPhase = 1;

				if (ElfJumpType == 1)
					SetStateLabel("BackJumpStart");
				else
					SetStateLabel("NormalJumpStart");
			}
			else
			{
				// Нажатие в воздухе не запускает анимацию.
				QueuedJumpType = 0;
			}
		}

		if (stopOnFloor &&
			player != null &&
			player.onground)
		{
			Vel.X = 0;
			Vel.Y = 0;
		}
//ЕСЛИ УПРАВЛЯЕТ БОТ ТО ПРЫГУЧЕСТЬ ПОВЫШЕНА		
		if (player != null &&
			player.Bot != null &&
			Health > 0 &&
			UseBotAutoJump())
		{
			if (BotJumpCooldown > 0)
				BotJumpCooldown--;

			if (player.onground &&
				BotJumpCooldown <= 0 &&
				Random(0, 255) < GetBotJumpChance())
			{
				Vel.Z = GetBotJumpStrength();

				QueuedJumpType = 0;
				ElfJumpType = 2;
				ElfJumpPhase = 1;

				SetStateLabel("NormalJumpStart");

				// Не позволяет боту прыгать слишком часто.
				//BotJumpCooldown = 35; 
				
				//прыгает часто
				BotJumpCooldown = 15;
			}
		}
	}
	
	
	
	
///
    action State A_SelectElfAnimation()
    {
        // Стрельба не прерывает активный прыжок.
        if (invoker.ElfJumpPhase == 1)
        {
            if (invoker.ElfJumpType == 1)
                return invoker.ResolveState(
                    "BackJumpStart"
                );

            return invoker.ResolveState(
                "NormalJumpStart"
            );
        }

        if (invoker.ElfJumpPhase == 2)
        {
            if (invoker.ElfJumpType == 1)
                return invoker.ResolveState(
                    "BackJumpAir"
                );

            return invoker.ResolveState(
                "NormalJumpAir"
            );
        }

        if (invoker.ElfJumpPhase == 3)
        {
            if (invoker.ElfJumpType == 1)
                return invoker.ResolveState(
                    "BackJumpLand"
                );

            return invoker.ResolveState(
                "NormalJumpLand"
            );
        }

        // Запускаем ожидающий прыжок.
        if (invoker.QueuedJumpType != 0)
        {
            invoker.ElfJumpType =
                invoker.QueuedJumpType;

            invoker.QueuedJumpType = 0;
            invoker.ElfJumpPhase = 1;

            if (invoker.ElfJumpType == 1)
                return invoker.ResolveState(
                    "BackJumpStart"
                );

            return invoker.ResolveState(
                "NormalJumpStart"
            );
        }

        if (invoker.player == null)
            return null;

        // Движение назад и по диагонали назад.
        if (invoker.player.cmd.forwardmove < 0)
        {
            if (invoker.player.cmd.sidemove < 0)
                return invoker.ResolveState(
                    "MoveBackLeft"
                );

            if (invoker.player.cmd.sidemove > 0)
                return invoker.ResolveState(
                    "MoveBackRight"
                );

            return invoker.ResolveState(
                "Backpedal"
            );
        }

        // Боковое движение вперёд или без forwardmove.
        if (invoker.player.cmd.sidemove < 0)
            return invoker.ResolveState("MoveLeft");

        if (invoker.player.cmd.sidemove > 0)
            return invoker.ResolveState("MoveRight");

        return null;
    }

    action State A_UpdateElfMovement(
        int currentMovement
    )
    {
        // Прыжок во время любой анимации движения.
        if (invoker.QueuedJumpType != 0)
        {
            invoker.ElfJumpType =
                invoker.QueuedJumpType;

            invoker.QueuedJumpType = 0;
            invoker.ElfJumpPhase = 1;

            if (invoker.ElfJumpType == 1)
                return invoker.ResolveState(
                    "BackJumpStart"
                );

            return invoker.ResolveState(
                "NormalJumpStart"
            );
        }

        if (invoker.player == null)
            return invoker.ResolveState("Spawn");

        // Типы движения:
        // 0 — вперёд/покой;
        // 1 — назад;
        // 2 — влево;
        // 3 — вправо;
        // 4 — назад-влево;
        // 5 — назад-вправо.
        int wantedMovement;

        if (invoker.player.cmd.forwardmove < 0)
        {
            if (invoker.player.cmd.sidemove < 0)
                wantedMovement = 4;
            else if (invoker.player.cmd.sidemove > 0)
                wantedMovement = 5;
            else
                wantedMovement = 1;
        }
        else if (invoker.player.cmd.sidemove < 0)
        {
            wantedMovement = 2;
        }
        else if (invoker.player.cmd.sidemove > 0)
        {
            wantedMovement = 3;
        }
        else
        {
            wantedMovement = 0;
        }

        if (wantedMovement == currentMovement)
            return null;

        if (wantedMovement == 1)
            return invoker.ResolveState(
                "Backpedal"
            );

        if (wantedMovement == 2)
            return invoker.ResolveState(
                "MoveLeft"
            );

        if (wantedMovement == 3)
            return invoker.ResolveState(
                "MoveRight"
            );

        if (wantedMovement == 4)
            return invoker.ResolveState(
                "MoveBackLeft"
            );

        if (wantedMovement == 5)
            return invoker.ResolveState(
                "MoveBackRight"
            );

        return invoker.ResolveState("Spawn");
    }

    action void A_SetElfJumpPhase(int phase)
    {
        invoker.ElfJumpPhase = phase;
    }

    action State A_CheckElfLanding()
    {
        if (invoker.player != null &&
            invoker.player.onground)
        {
            invoker.ElfJumpPhase = 3;

            if (invoker.ElfJumpType == 1)
                return invoker.ResolveState(
                    "BackJumpLand"
                );

            return invoker.ResolveState(
                "NormalJumpLand"
            );
        }

        return null;
    }

    action void A_FinishElfJump()
    {
        invoker.ElfJumpPhase = 0;
        invoker.ElfJumpType = 0;
    }



