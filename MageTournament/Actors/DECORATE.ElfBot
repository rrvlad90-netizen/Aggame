  {
	Spawn:
		POSS A 0 Thing_ChangeTID(0, 88)

		// Не сбрасываем маршрут при возврате в Spawn.
		POSS A 1 A_JumpIfInventory(
			"ASpan", 1, "Spn"
		)

		POSS A 0
		{
			StartStrictRoute(11);
		}
		Goto Diss

	Spn:
		TNT1 A 0
		Goto Route

	Route:
		POSS AABBCCDDEEFFGGHHIIJJKKLL 1 A_Look

		TNT1 A 0 A_JumpIfInventory(
			"StrictRouteFinished", 1, "Spn2"
		)
		Loop

	Spn2:
		TNT1 A 0 A_ChangeFlag("NOPAIN",false)
		POSS A 0 A_Look
		POSW ABCD 1 A_Wander
		POSS A 0 A_Look
		POSW EFGH 1 A_Wander
		Loop

	See:
		TNT1 A 0 A_ChangeFlag("NOPAIN",false)
		POSW ABCDEFGH 1 A_Chase
		POSW ABCDEFGH 1 A_Chase
		TNT1 A 0 A_ClearTarget

		TNT1 A 0 A_JumpIfInventory(
			"StrictRouteFinished", 1, "Spn2"
		)
		Goto Route
	
