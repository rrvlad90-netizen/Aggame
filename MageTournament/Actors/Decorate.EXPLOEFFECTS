ACTOR ExplosionParticleHeavy
{
 game Doom
 speed 9
 radius 8
 height 1
 Gravity 0.5
  RenderStyle Add
  Scale 0.06
   +MISSILE
   +CLIENTSIDEONLY
   +NOTELEPORT
   +NOBLOCKMAP
   -RIPPER
   +BLOODLESSIMPACT 
   +FORCEXYBILLBOARD
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +DOOMBOUNCE
    +DONTSPLASH
	+THRUACTORS
   +GHOST
   Damage 0
  BounceFactor 0.01
    States
    {
     Spawn:
       //SPKO AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_FadeOut(0.02)
        SPKO A 42 Bright A_FadeOut(0.02)
        stop
     Death:
       Stop
    }
}

ACTOR ExplosionParticleVeryFast: ExplosionParticleHeavy
