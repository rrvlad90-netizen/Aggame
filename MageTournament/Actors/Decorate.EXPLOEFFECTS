ACTOR FlameTrails
{
	Game Doom
	Radius 1
	Height 1
	Speed 3
	Damage 0 
    +NOBLOCKMAP
    +NOTELEPORT
    +DONTSPLASH
	+MISSILE
	+FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +NOINTERACTION
	+NOCLIP
	RenderStyle Add
    DamageType Flames
    Scale 0.5
	Alpha 1
	Gravity 0
	States
	{
    Spawn:
        TNT1 A 2
        FRDR ABCDEFGH 3 BRIGHT
        Stop
	}
}


