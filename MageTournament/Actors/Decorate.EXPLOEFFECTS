	TNT1 A 0
//TNT1 A 0 A_Explode(80,150)
TNT1 A 0 A_Explode(120,180)
        Stop}}

actor BarrelExplosion: RocketExplosion
{
States    {
    Spawn:
	TNT1 A 0
TNT1 A 0 A_Explode(150,200)
        Stop}}




