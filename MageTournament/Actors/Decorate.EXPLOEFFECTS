Actor Flare_General
{
+NOINTERACTION
+NOGRAVITY
+CLIENTSIDEONLY
renderstyle Add
radius 1
height 1
alpha 0.4
scale 0.4
}


Actor ExplosionFlareSpawner : Flare_General
{
states
	{
	Spawn:
	    TNT1 A 0
	    TNT1 A 0 A_SpawnItem("NewfagExplosionFlare") 
		L2NR AAA 1 BRIGHT //A_SpawnItem("RedFlareLarge1x")
		
		L2NR A 5
		stop
	}
}

Actor RedFlare : Flare_General
{
states
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(128,2)
		LENR A 2 bright
		stop
		TNT1 A 0
		LENR B 2 bright
		stop
	}
}


Actor RedFlareSmall : RedFlare
{
scale 0.15
}

