//ACTOR ElfWarrior : DoubleJumpWarriorElf
ACTOR ElfWarrior : WarriorElf
{
  Speed 1
  Health 100
  Radius 16
  Height 56
  Mass 100
  PainChance 255
  +NOBLOOD
  Player.DisplayName "ElfWarrior"
  Player.CrouchSprite "ELFC"
  Player.StartItem "CrossbowW"
  Player.StartItem "Clip", 100
  Player.WeaponSlot 1, CrossbowW
//  Player.WeaponSlot 2, Q3Shotgun
//  Player.WeaponSlot 3, Q3RocketLauncher
  Player.ColorRange 112, 127
  Player.ColorSet 0, "Green",         0x70, 0x7F,  0x72
  Player.ColorSet 1, "Gray",          0x60, 0x6F,  0x62 // Called "Indigo" originally so as to have a unique initial
  Player.ColorSet 2, "Brown",         0x40, 0x4F,  0x42
  Player.ColorSet 3, "Red",           0x20, 0x2F,  0x22
  // Doom Legacy additions
  Player.ColorSet 4, "Light Gray",    0x58, 0x67,  0x5A
  Player.ColorSet 5, "Light Brown",   0x38, 0x47,  0x3A
  Player.ColorSet 6, "Light Red",     0xB0, 0xBF,  0xB2
  Player.ColorSet 7, "Light Blue",    0xC0, 0xCF,  0xC2

  Damagefactor "MyBolt", 0
  States
  {
  Spawn:
  	ELFS A 1
  Spn:
	TNT1 A 0 A_Stop
    ELFS ABCDEFGHIJKL 2
	TNT1 A 0
    Loop
See:
    //TNT1 A 0 A_SelectElfAnimation
    //ELFW ABCDEFGH 2
	
    ELFW ABCDEFGH 2 A_SelectElfAnimation
    Goto Spawn

Backpedal:
    ELBB ABCDEFGHI 2 A_UpdateElfMovement(1)
    Loop

MoveLeft:
    ELLM ABCDEFGH 2 A_UpdateElfMovement(2)
    Loop

MoveRight:
    ELRM ABCDEFGH 2 A_UpdateElfMovement(3)
    Loop

MoveBackLeft:
    ELML ABCDEFGHI 2 A_UpdateElfMovement(4)
    Loop

MoveBackRight:
    ELMR ABCDEFGHI 2 A_UpdateElfMovement(5)
    Loop

BackJumpStart:
    ELJB ABCDEFGH 1
    TNT1 A 0 A_SetElfJumpPhase(2)
    Goto BackJumpAir

BackJumpAir:
    ELJB I 2 A_CheckElfLanding
    Loop

BackJumpLand:
    ELJB JKL 1
    TNT1 A 0 A_FinishElfJump
    Goto Spawn

NormalJumpStart:
    ELJU ABCDEFG 1
    TNT1 A 0 A_SetElfJumpPhase(2)
    Goto NormalJumpAir

NormalJumpAir:
    ELJU H 2 A_CheckElfLanding
    Loop

NormalJumpLand:
    ELJU IJKLMNO 1
    TNT1 A 0 A_FinishElfJump
    Goto Spawn

Missile:
    TNT1 A 0 A_SelectElfAnimation
    ELFS EFG 1
    Goto Spn

Melee:
    TNT1 A 0
    Goto Missile
	
  Death:
    TNT1 A 0 ACS_Execute(2, 0, 0)
    ELFD A 0 A_PlayerSkinCheck("AltSkinDeath")
  Death1:
    ELFD A 1 ClearInventory()
    ELFD B 1 A_PlayerScream
    ELFD C 1 A_NoBlocking
    ELFD DEFGHIJKLMNOPQRSTUVXWYZ 1
	ELDD ABCDE 1
    ELDD E 100
	ELDD E 1 A_FadeOut
	TNT1 A -1
	//PLAY N -1
    Stop
  XDeath:
    TNT1 A 0 ACS_Execute(2, 0, 0)
    ELFD A 0 A_PlayerSkinCheck("AltSkinXDeath")
  XDeath1:
    ELFD A 1 ClearInventory()
    ELFD B 1 A_XScream
    ELFD C 1 A_NoBlocking
    ELFD DEFGHIJKLMNOPQRSTUVXWYZ 1
	ELDD ABCDE 1
    ELDD E 100
	ELDD E 1 A_FadeOut
	TNT1 A -1
    Stop
  AltSkinDeath:
    ELFD A 1 ClearInventory()
    ELFD B 1 A_PlayerScream
    ELFD C 1 A_NoBlocking
    ELFD DEFGHIJKLMNOPQRSTUVXWYZ 1
	ELDD ABCDE 1
    ELDD E 100
	ELDD E 1 A_FadeOut
	TNT1 A -1
    Stop
  AltSkinXDeath:
    ELFD A 1 ClearInventory()
    ELFD B 1 A_PlayerScream
    ELFD C 1 A_NoBlocking
    ELFD DEFGHIJKLMNOPQRSTUVXWYZ 1
	ELDD ABCDE 1
    ELDD E 100
	ELDD E 1 A_FadeOut
	TNT1 A -1
    Stop
  }
}