ACTOR WizardBot : StrictRoutePawn 5090 //replaces Archvile
{
  Health 105
  Radius 20
  Height 46   //56!! bilo
  Speed 14
  PainChance 255
  Monster
  +SLIDESONWALLS
  +NOBLOOD
  +FLOORCLIP
  //-DROPOFF
  -FRIENDLY
  //+LOOKALLAROUND
  //+BOSS
  //+NOPAIN
  Mass 9999
  DeathSound "WDEAT"
  Obituary "You was shooted by desparil disiple"
  
  Damagefactor "EnemyBolt", 0
	//DamageFactor "EnemyBolt", 0.0
  //Damagefactor "EnemyVehicleBolt", 0
  States
  {
	Spawn:
		POSS A 0
		{
			A_SetRenderStyle(1.0, STYLE_Normal);
		}

		POSS A 0 Thing_ChangeTID(0, 552)
		POSS A 0 Thing_Hate(0, 88, 3)

		// Если бот уже инициализирован — продолжаем маршрут.
		POSS A 1 A_JumpIfInventory(
			"ASpan", 1, "Spn"
		)

		// Выполняется только при самом первом появлении.
		POSS A 0
		{
			StartStrictRoute(1);
		}

		Goto Diss

	Spn:
		TNT1 A 0 A_PlaySound("WSEE")
		Goto Route

	Route:
		POSS ABCDEFGHIJKLMNOPQR 1 A_Look

		TNT1 A 0 A_JumpIfInventory(
			"StrictRouteFinished",
			1,
			"Spn2"
		)
		Loop

	Spn2:
		TNT1 A 0 A_ChangeFlag("NOPAIN",false)
		POSS A 0 A_Look
		POSS AAAAA 1 A_Wander
		Loop

	See:
		TNT1 A 0 A_ChangeFlag("NOPAIN",false)
		POSS ABCDEFGHIJKLMNOPQR 1 A_Chase
		POSS ABCDEFGHIJKLMNOPQR 1 A_Chase
		TNT1 A 0 A_ClearTarget

		TNT1 A 0 A_JumpIfInventory(
			"StrictRouteFinished", 1, "Spn2"
		)
		Goto Route
	
  Missile:
  TNT1 A 0 A_jump(120, "StrifeLeft")
  TNT1 A 0 A_jump(120, "StrifeRight")
  StrifeLeft:
  	//RQPONMLKJIHGFEDCBA  1
	TNT1 A 0 
	{
	A_CustomMissile("CrosbowFire2", 52, 0, random(-8,8));
	}
	POSA ABCDE 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA FGHIJ 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA KLMNO 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA PQRSTU 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	
	TNT1 A 0 A_CPosRefire
	TNT1 A 0
	{
	A_CustomMissile("CrosbowFire2", 52, 0, random(-8,8));
	}
	POSA ABCDE 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA FGHIJ 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA KLMNO 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA PQRSTU 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	//	
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 
	{
	A_CustomMissile("CrosbowFire2", 52, 0, random(-8,8));
	}
	POSA ABCDE 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA FGHIJ 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA KLMNO 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA PQRSTU 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,2, 0, 0);
	}	
	Goto See

  StrifeRight:
 	TNT1 A 0 
	{
	A_CustomMissile("CrosbowFire2", 52, 0, random(-8,8));
	}
	POSA ABCDE 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA FGHIJ 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA KLMNO 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA PQRSTU 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 
	{
	A_CustomMissile("CrosbowFire2", 52, 0, random(-8,8));
	}
	POSA ABCDE 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA FGHIJ 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA KLMNO 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA PQRSTU 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	//
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 
	{
	A_CustomMissile("CrosbowFire2", 52, 0, random(-8,8));
	}
	POSA ABCDE 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA FGHIJ 1
	{  
	A_FaceTarget;
	A_Recoil(-1);
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA KLMNO 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSA PQRSTU 1
	{  
	A_FaceTarget;
	A_Recoil(-1);	
	ThrustThing(angle*256/360+210,-2, 0, 0);
	}
	Goto See
	
 Pain:
  TNT1 A 0 A_ChangeFlag("NOPAIN",true) 
  //POSS A 0 Thing_Hate(0, 88, 3)
  POSS A 1 A_PlaySound("WPAIN")
  POSS AAAAA 2 A_FaceTarget
  //POSS RQPONMLKJIHGFEDCBA 1 A_Recoil(-1)
  POSS A 1 A_Stop
  TNT1 A 0 A_Jump(120, "StrifeRight")
  TNT1 A 0 A_Jump(120, "StrifeLeft")
  Goto See
  
    Death:
	XDeath:
	TNT1 A 0 TakeInventory("ASpan2",1)
    TNT1 A 0 ACS_Execute(1, 0, 0)
	TNT1 A 0 A_ClearTarget
    POSS A 1
    POSS A 1 A_Scream
    POSS A 1 A_NoBlocking
    POSS AAAAAAAAAAAAA 1 A_FadeOut(0.2,0)
	TNT1 A 120
	TNT1 A 1 A_Respawn
    Stop
		
   Diss: 
    TNT1 A 0 GiveInventory("ASpan",1)
    TNT1 A 5 A_ClearTarget
    TNT1 A 5 A_Respawn
    Stop	
	}
}


//////HARD!!!!!
ACTOR WizardBot2 : WizardBot 5093
{
    States
    {
    Spawn:
        POSS A 0
        {
            A_SetRenderStyle(1.0, STYLE_Normal);
        }

        POSS A 0 Thing_ChangeTID(0, 554)
        POSS A 0 Thing_Hate(0, 88, 3)

        // После респавна продолжаем сохранённый маршрут.
        POSS A 1 A_JumpIfInventory(
            "ASpan", 1, "Spn"
        )

        // Первый запуск маршрута.
        POSS A 0
        {
            StartStrictRoute(1);
        }

        Goto Diss


    // Выбор боевого манёвра.
    Missile:
        TNT1 A 0 A_Jump(45, "CombatJump")
        TNT1 A 0 A_Jump(55, "JumpAndFire")
        TNT1 A 0 A_Jump(65, "StrafeFireLeft")
        TNT1 A 0 A_Jump(65, "StrafeFireRight")
        Goto Super::Missile


    // При получении урона вероятность манёвров выше.
    Pain:
        TNT1 A 0 A_ChangeFlag("NOPAIN", true)
        POSS A 0 A_PlaySound("WPAIN")

        TNT1 A 0 A_Jump(70, "CombatJump")
        TNT1 A 0 A_Jump(80, "JumpAndFire")
        TNT1 A 0 A_Jump(90, "StrafeFireLeft")
        TNT1 A 0 A_Jump(90, "StrafeFireRight")

        Goto Super::Pain


    // Обычный прыжок в сторону противника.
    CombatJump:
        TNT1 A 0 A_Stop
        POSS A 0 A_FaceTarget

		TNT1 A 0 A_ChangeVelocity(0, 0, 8, CVF_RELATIVE)//высота прыжка
		//TNT1 A 0 A_Recoil(-1)

        TNT1 A 0 
		{
		ThrustThing(
                angle * 256 / 360 + 210,
                3,
                0,
                0
            );
		}

        POSA ABCDEFGHI 1 A_FaceTarget
        POSA JKLMNOPQR 1 A_FaceTarget

        Goto See


    // Прыжок с выстрелами.
    JumpAndFire:
        TNT1 A 0 A_Stop
        POSS A 0 A_FaceTarget

		TNT1 A 0 A_ChangeVelocity(0, 0, 8, CVF_RELATIVE)//высота прыжка
		//TNT1 A 0 A_Recoil(-1)

        TNT1 A 0 
		{
		ThrustThing(
                angle * 256 / 360 + 210,
                -3,
                0,
                0
            );
		}

        POSA ABCD 1 A_FaceTarget

        TNT1 A 0
        {
            A_FaceTarget;
            A_CustomMissile(
                "CrosbowFire2",
                52,
                0,
                random(-8, 8)
            );
        }

        POSA EFGHIJKLM 1 A_FaceTarget

        TNT1 A 0
        {
            A_FaceTarget;
            A_CustomMissile(
                "CrosbowFire2",
                52,
                0,
                random(-8, 8)
            );
        }

        POSA NOPQRSTU 1 A_FaceTarget

        Goto See


    // Стрейф влево с огнём.
    StrafeFireLeft:
        TNT1 A 0 A_Stop

        TNT1 A 0
        {
            A_FaceTarget;
            A_CustomMissile(
                "CrosbowFire2",
                52,
                0,
                random(-8, 8)
            );
        }

        POSA ABCDE 1
        {
            A_FaceTarget;
            ThrustThing(
                angle * 256 / 360 + 210,
                3,
                0,
                0
            );
        }

        POSA FGHIJ 1
        {
            A_FaceTarget;
            ThrustThing(
                angle * 256 / 360 + 210,
                3,
                0,
                0
            );
        }

        TNT1 A 0
        {
            A_FaceTarget;
            A_CustomMissile(
                "CrosbowFire2",
                52,
                0,
                random(-8, 8)
            );
        }

        POSA KLMNOPQRSTU 1
        {
            A_FaceTarget;
            ThrustThing(
                angle * 256 / 360 + 210,
                3,
                0,
                0
            );
        }

        Goto See


    // Стрейф вправо с огнём.
    StrafeFireRight:
        TNT1 A 0 A_Stop

        TNT1 A 0
        {
            A_FaceTarget;
            A_CustomMissile(
                "CrosbowFire2",
                52,
                0,
                random(-8, 8)
            );
        }

        POSA ABCDE 1
        {
            A_FaceTarget;
            ThrustThing(
                angle * 256 / 360 + 210,
                -3,
                0,
                0
            );
        }

        POSA FGHIJ 1
        {
            A_FaceTarget;
            ThrustThing(
                angle * 256 / 360 + 210,
                -3,
                0,
                0
            );
        }

        TNT1 A 0
        {
            A_FaceTarget;
            A_CustomMissile(
                "CrosbowFire2",
                52,
                0,
                random(-8, 8)
            );
        }

        POSA KLMNOPQRSTU 1
        {
            A_FaceTarget;
            ThrustThing(
                angle * 256 / 360 + 210,
                -3,
                0,
                0
            );
        }

        Goto See
    }
}