actor BaronBallFire
{
	Radius		1
	Height		1
	Alpha		0.0
	Scale		0.01
    Speed 1
    Renderstyle Stencil
	StencilColor 55 250 50
    PROJECTILE
    +DOOMBOUNCE
	States
	{
	Spawn:
		null a 0 a_jump(50,"F1")
        null a 0 a_jump(50,"F2")
		null a 0 a_jump(50,"F3")
		null a 0 a_jump(50,"F4")
        null a 0 a_jump(50,"F5")
		null a 0 a_jump(50,"F6")
		null a 0 a_jump(50,"F7")
       Goto Spawn
	F1:
		firX aaaa 1 BRIGHT A_FadeIn(0.2)
		firX aaaaaaaaaa 1 BRIGHT A_FadeOut(0.04)
		Stop
			F2:
		firX bbbb 1 BRIGHT A_FadeIn(0.2)
		firX bbbbbbbbbb 1 BRIGHT A_FadeOut(0.04)
		Stop
			F3:
		firX cccc 1 BRIGHT A_FadeIn(0.2)
		firX cccccccccccccccccccccccccccccc 1 BRIGHT A_FadeOut(0.04)
		Stop
			F4:
		firX dddd 1 BRIGHT A_FadeIn(0.2)
		firX dddddddddddddddddddddddddddddd 1 BRIGHT A_FadeOut(0.04)
		Stop
			F5:
		firX eeee 1 BRIGHT A_FadeIn(0.2)
		firX eeeeeeeeee 1 BRIGHT A_FadeOut(0.04)
		Stop
			F6:
		firX ffff 1 BRIGHT A_FadeIn(0.2)
		firX ffffffffffffffffffffffffffffff 1 BRIGHT A_FadeOut(0.04)
		Stop
			F7:
		firX gggg 1 BRIGHT A_FadeIn(0.2)
		firX gggggggggggggggggggggggggggggg 1 BRIGHT A_FadeOut(0.04)
		Stop
	}
}




