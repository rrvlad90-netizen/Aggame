actor CrosbowFire //replaces BaronBall
{
  //Game Doom
  //SpawnID 10
  Radius 6
  Height 8
  Speed 28
  FastSpeed 30
  Damage 6
  Scale 0.3
  Projectile
  +RANDOMIZE
  RenderStyle Add
  Alpha 8
  SeeSound "imp/attack"
  DeathSound "imp/shotx"
  
  DamageType "MyBolt"
  States
  {
  Spawn:
    CORN e 0 A_CustomMissile("BaronBallTrail",0,0,0,0,0)
    CORN e 0 A_CustomMissile("BaronBallSmoke",-9,0,0+random(0,360),0,0+random(0,360))
    CORN e 1 bright A_CustomMissile("BaronBallFire",-7,0,0+random(0,360),0,0+random(0,360))
	CORN eee 0 A_CustomMissile("BaronBallFire",-7,2,0+random(-360,360),2,0+random(-360,360))
    loop
  Death:
    CORN eeeeeeeeeee 1 bright A_CustomMissile("BaronBallFire",-7,2,0+random(-360,360),2,0+random(-360,360))
		CORN e 1 bright A_SetTranslucent(.9,1)
		CORN e 1 bright A_SetTranslucent(.8,1)
		CORN e 1 bright A_SetTranslucent(.7,1)
		CORN e 1 bright A_SetTranslucent(.6,1)
		CORN e 1 bright A_SetTranslucent(.5,1)
		CORN e 1 bright A_SetTranslucent(.4,1)
		CORN e 1 bright A_SetTranslucent(.3,1)
		CORN e 1 bright A_SetTranslucent(.2,1)
		CORN e 1 bright A_SetTranslucent(.1,1)
		CORN e 1 bright A_SetTranslucent(.08,1)
		CORN e 1 bright A_SetTranslucent(.06,1)
		CORN e 1 bright A_SetTranslucent(.04,1)
		CORN e 1 bright A_SetTranslucent(.02,1)
    stop
  }
}


