Actor None1 replaces SuperShotgun
{
  Radius 1   //16
  Height 1   //34
  -SOLID
States
 {
  Spawn:
    TNT1 A 1
  Stop
 }
}


ACTOR CrossbowW : Weapon replaces Shotgun
{
   +INVENTORY.UNDROPPABLE
   +WEAPON.NOAUTOAIM
  Inventory.PickupMessage "Pick Up Crossbow"
   Weapon.SelectionOrder 1900  //3
   Weapon.AmmoType "Clip"
   Weapon.AmmoGive 100
   Weapon.AmmoUse 0
  Tag "Crossbow"
  States
  {
  Spawn:
    TNT1 A -1
    Stop
  Ready:
    CRBW A 1 A_WeaponReady
    Loop
  Deselect:
    CRBW A 1 A_Lower
    Loop
  Select:
    CRBW A 1 A_Raise
    Loop
  Fire:
  	CRBW A 3 A_AlertMonsters
	CRBW B 1 A_PlaySound("FFire")
	CRBW BC 2
    CRBW D 1 A_FireCustomMissile("CrosbowFire",0,true,0,7,0)
    CRBW DEFGH 2
	CRBW H 7
	CRBW H 5 A_ReFire
    Goto Ready
  }
}

