ACTOR BodyBase
{
  Health 1
  Radius 0
  Height 5
  Speed 0
  Monster
  +NOPAIN
	-PUSHABLE
	-SOLID
	+LOOKALLAROUND
  Mass 9999

  States
  {
  Spawn:
    //POSS A 0 A_Warp(AAPTR_TARGET, 0, 0, 56, WARPF_NOCHECKPOSITION)
	POSS A 0
    //POSS A 0 Thing_Hate(0, 88, 3)
  Spn:
    TNT1 A 0 A_Warp(AAPTR_MASTER, 0, 0, 56, WARPF_NOCHECKPOSITION)
    POSS A 1 A_Look
    Loop

  See:
    POSS A 1 
	{
	//A_JumpIfCloser(40,"Melee");
	A_FaceTarget(90);
	A_Chase("Missile","Missile", CHF_DONTMOVE);
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE | WARPF_COPYPITCH);
	}
    Loop
	
  Missile:
    POSS E 1
	{	
	A_FaceTarget;
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE | WARPF_COPYPITCH);
	}
    POSS F 1
    {	
	A_FaceTarget;
	A_PosAttack;
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE | WARPF_COPYPITCH);
	}
    POSS EEE 1
	{
	A_FaceTarget;
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE | WARPF_COPYPITCH);
	}
    Goto See

  Death:
    TNT1 A 0 A_ClearTarget
    TNT1 A 0 A_KillMaster
    TNT1 A 5
    //POSS I 5 A_Scream
    TNT1 A 5 A_NoBlocking
    //POSS K 5
    TNT1 A 1 A_FadeOut
    Stop
  }
}

