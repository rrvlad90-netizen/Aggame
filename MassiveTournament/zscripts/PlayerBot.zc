// ============================================================
// СЛУЖЕБНЫЙ INVENTORY
// ============================================================

class UpdateBotRouteFinished : Inventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE;
	}
}


// ============================================================
// БАЗОВЫЙ БОТ
// ============================================================

class UpdateBot : PlayerPawn
{
	const PATROL_NONE   = 0;
	const PATROL_ACTIVE = 1;
	const PATROL_COMBAT = 2;
	const PATROL_RETURN = 3;

	int JumpType;
	int JumpPhase;
	int QueuedJumpType;

	bool JumpWasPressed;
	bool JumpHasLeftFloor;

	int BotJumpCooldown;

	Actor CurrentPatrolPoint;

	bool PatrolActive;
	bool PatrolSearchDone;

	int PatrolMode;
	int PatrolSearchDelay;
	int PatrolCombatMemory;

	int FirstPatrolTID;
	int BotRouteNumber;
	int BotRouteTIDOffset;

	Vector3 PatrolBreadcrumbs[64];
	int PatrolBreadcrumbCount;
	int PatrolBreadcrumbTimer;


	Default
	{
		Health 100;
		Radius 16;
		Height 56;
		Mass 100;

		Speed 1.0;
		PainChance 0;

		Player.JumpZ 8.0;
		Player.ViewHeight 41;
		Player.MaxHealth 100;
		Player.DisplayName "UpdateBot";

		+NOPAIN;
	}


	virtual bool UseBotAutoJump()
	{
		return true;
	}


	// 51 из 256 — примерно 20%. Шанс прыжка. Jump Chance
	virtual int GetBotJumpChance()
	{
		return 51;
	}


	virtual int GetBotJumpCooldown()
	{
		return 35;
	}


	virtual double GetBotJumpStrength()
	{
		return 8.0;
	}


	virtual bool BotCanJumpDuringCombat()
	{
		return true;
	}


	virtual bool UsePatrolPoints()
	{
		return true;
	}


	virtual int GetFirstPatrolTID()
	{
		return 1000;
	}


	virtual int GetBotRouteTIDStep()
	{
		return 40;
	}


	virtual double GetPatrolSpeed()
	{
		return 6.0;
	}


	virtual double GetPatrolReachDistance()
	{
		return 24.0;
	}


	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		
		ChangeTid(6100);

		BotJumpCooldown =
			GetBotJumpCooldown();

		FirstPatrolTID =
			GetFirstPatrolTID();

		PatrolSearchDelay = 2;
		PatrolMode = PATROL_NONE;
	}


	// ========================================================
	// НУМЕРАЦИЯ МАРШРУТА
	// ========================================================

	int CalculateBotRouteNumber()
	{
		if (player == null ||
			player.Bot == null)
		{
			return 0;
		}

		int myPlayerNumber =
			PlayerNumber();

		int botNumber = 0;

		for (int i = 0;
			i <= myPlayerNumber;
			i++)
		{
			if (playeringame[i] &&
				players[i].Bot != null)
			{
				botNumber++;
			}
		}

		return botNumber;
	}


	void PrepareBotRouteOffset()
	{
		if (BotRouteNumber != 0)
			return;

		BotRouteNumber =
			CalculateBotRouteNumber();

		BotRouteTIDOffset =
			BotRouteNumber *
			GetBotRouteTIDStep();
	}


	// ========================================================
	// ПОИСК PATROL POINT
	// ========================================================

	Actor FindPatrolPointByTID(int pointTID)
	{
		if (pointTID == 0)
			return null;

		ActorIterator iterator =
			ActorIterator.Create(
				pointTID,
				"PatrolPoint"
			);

		return iterator.Next();
	}


	Actor FindNearestPatrolPoint()
	{
		ThinkerIterator iterator =
			ThinkerIterator.Create(
				"PatrolPoint"
			);

		Actor nearestPoint = null;
		double nearestDistance = 0;

		Thinker thinker;

		while ((thinker = iterator.Next()) != null)
		{
			Actor point =
				Actor(thinker);

			if (point == null)
				continue;

			double distance =
				Distance2D(point);

			if (nearestPoint == null ||
				distance < nearestDistance)
			{
				nearestPoint = point;
				nearestDistance = distance;
			}
		}

		return nearestPoint;
	}


	void StartPatrol()
	{
		TakeInventory(
			"UpdateBotRouteFinished",
			1
		);

		PrepareBotRouteOffset();

		if (FirstPatrolTID != 0)
		{
			CurrentPatrolPoint =
				FindPatrolPointByTID(
					FirstPatrolTID +
					BotRouteTIDOffset
				);
		}
		else
		{
			CurrentPatrolPoint =
				FindNearestPatrolPoint();
		}

		if (CurrentPatrolPoint == null)
		{
			PatrolActive = false;
			PatrolMode = PATROL_NONE;
			return;
		}

		PatrolActive = true;
		PatrolMode = PATROL_ACTIVE;
	}


	void FinishPatrol()
	{
		PatrolActive = false;
		PatrolMode = PATROL_NONE;
		CurrentPatrolPoint = null;

		PatrolBreadcrumbCount = 0;

		if (player != null &&
			player.onground)
		{
			Vel.X = 0;
			Vel.Y = 0;
		}

		GiveInventory(
			"UpdateBotRouteFinished",
			1
		);
	}


	void SelectNextPatrolPoint()
	{
		if (CurrentPatrolPoint == null)
		{
			FinishPatrol();
			return;
		}

		int baseNextTID =
			CurrentPatrolPoint.args[0];

		if (baseNextTID == 0)
		{
			FinishPatrol();
			return;
		}

		CurrentPatrolPoint =
			FindPatrolPointByTID(
				baseNextTID +
					BotRouteTIDOffset
			);

		if (CurrentPatrolPoint == null)
			FinishPatrol();
	}


	// ========================================================
	// БОЙ И ХЛЕБНЫЕ КРОШКИ
	// ========================================================

	bool BotHasCombatIntent()
	{
		if (Target != null &&
			Target.Health > 0)
		{
			return true;
		}

		if (player != null &&
			(player.cmd.buttons &
				(BT_ATTACK |
				 BT_ALTATTACK)) != 0)
		{
			return true;
		}

		return false;
	}


	double DistanceToPosition2D(Vector3 point)
	{
		double dx = point.X - Pos.X;
		double dy = point.Y - Pos.Y;

		return sqrt(
			dx * dx +
			dy * dy
		);
	}


	void AddPatrolBreadcrumb(Vector3 point)
	{
		if (PatrolBreadcrumbCount > 0)
		{
			Vector3 previous =
				PatrolBreadcrumbs[
					PatrolBreadcrumbCount - 1
				];

			double dx =
				point.X - previous.X;

			double dy =
				point.Y - previous.Y;

			if (sqrt(dx * dx + dy * dy) < 16.0)
				return;
		}

		if (PatrolBreadcrumbCount < 64)
		{
			PatrolBreadcrumbs[
				PatrolBreadcrumbCount
			] = point;

			PatrolBreadcrumbCount++;
			return;
		}

		// Сохраняем первую позицию возле маршрута,
		// удаляя самую старую промежуточную позицию.
		for (int i = 1; i < 63; i++)
		{
			PatrolBreadcrumbs[i] =
				PatrolBreadcrumbs[i + 1];
		}

		PatrolBreadcrumbs[63] = point;
	}


	void BeginPatrolCombat()
	{
		if (PatrolMode == PATROL_ACTIVE)
		{
			PatrolBreadcrumbCount = 0;
			AddPatrolBreadcrumb(Pos);
		}

		PatrolMode = PATROL_COMBAT;
		PatrolCombatMemory = 70;
		PatrolBreadcrumbTimer = 16;
	}


	void UpdateCombatBreadcrumbs()
	{
		if (PatrolBreadcrumbTimer > 0)
		{
			PatrolBreadcrumbTimer--;
			return;
		}

		PatrolBreadcrumbTimer = 16;
		AddPatrolBreadcrumb(Pos);
	}


	void BeginReturnToPatrol()
	{
		if (PatrolBreadcrumbCount <= 1)
		{
			PatrolBreadcrumbCount = 0;
			PatrolMode = PATROL_ACTIVE;
			return;
		}

		PatrolMode = PATROL_RETURN;
	}


	void MoveTowardPosition(Vector3 destination)
	{
		double dx =
			destination.X - Pos.X;

		double dy =
			destination.Y - Pos.Y;

		double direction =
			atan2(dy, dx);

		Angle = direction;

		double speed =
			GetPatrolSpeed();

		Vel.X =
			cos(direction) * speed;

		Vel.Y =
			sin(direction) * speed;
	}


	void UpdateReturnToPatrol()
	{
		if (PatrolBreadcrumbCount <= 1)
		{
			PatrolBreadcrumbCount = 0;
			PatrolMode = PATROL_ACTIVE;
			return;
		}

		Vector3 destination =
			PatrolBreadcrumbs[
				PatrolBreadcrumbCount - 1
			];

		if (DistanceToPosition2D(destination) <=
			GetPatrolReachDistance())
		{
			PatrolBreadcrumbCount--;

			if (PatrolBreadcrumbCount <= 1)
			{
				PatrolBreadcrumbCount = 0;
				PatrolMode = PATROL_ACTIVE;
				return;
			}

			destination =
				PatrolBreadcrumbs[
					PatrolBreadcrumbCount - 1
				];
		}

		MoveTowardPosition(destination);
	}


	void UpdateActivePatrol()
	{
		if (CurrentPatrolPoint == null)
		{
			CurrentPatrolPoint =
				FindNearestPatrolPoint();

			if (CurrentPatrolPoint == null)
			{
				FinishPatrol();
				return;
			}
		}

		if (Distance2D(CurrentPatrolPoint) <=
			GetPatrolReachDistance())
		{
			SelectNextPatrolPoint();

			if (!PatrolActive ||
				CurrentPatrolPoint == null)
			{
				return;
			}
		}

		double direction =
			AngleTo(CurrentPatrolPoint);

		Angle = direction;

		double speed =
			GetPatrolSpeed();

		Vel.X =
			cos(direction) * speed;

		Vel.Y =
			sin(direction) * speed;
	}


	void UpdatePatrol()
	{
		if (player == null ||
			player.Bot == null ||
			!PatrolActive ||
			Health <= 0)
		{
			return;
		}

		bool combat =
			BotHasCombatIntent();

		if (combat)
		{
			if (PatrolMode != PATROL_COMBAT)
				BeginPatrolCombat();

			PatrolCombatMemory = 70;
			UpdateCombatBreadcrumbs();
			return;
		}

		if (PatrolMode == PATROL_COMBAT)
		{
			UpdateCombatBreadcrumbs();

			if (PatrolCombatMemory > 0)
			{
				PatrolCombatMemory--;
				return;
			}

			BeginReturnToPatrol();
		}

		if (PatrolMode == PATROL_RETURN)
		{
			UpdateReturnToPatrol();
			return;
		}

		if (PatrolMode == PATROL_ACTIVE)
			UpdateActivePatrol();
	}


	// ========================================================
	// ПРЫЖОК
	// ========================================================

	void BeginJump(int requestedType)
	{
		if (requestedType != 1)
			requestedType = 2;

		JumpType = requestedType;
		QueuedJumpType = 0;

		JumpPhase = 1;
		JumpHasLeftFloor = false;

		if (JumpType == 1)
			SetStateLabel("BackJumpStart");
		else
			SetStateLabel("NormalJumpStart");
	}


	void UpdateHumanJumpRequest()
	{
		if (player == null ||
			player.Bot != null)
		{
			return;
		}

		bool jumpPressed =
			(player.cmd.buttons & BT_JUMP) != 0;

		bool newJumpPress =
			jumpPressed &&
			!JumpWasPressed;

		JumpWasPressed = jumpPressed;

		if (newJumpPress &&
			player.onground &&
			JumpPhase == 0)
		{
			if (player.cmd.forwardmove < 0)
				QueuedJumpType = 1;
			else
				QueuedJumpType = 2;
		}
	}


	void StartQueuedHumanJump()
	{
		if (player == null ||
			player.Bot != null ||
			Health <= 0 ||
			QueuedJumpType == 0 ||
			JumpPhase != 0)
		{
			return;
		}

		if (!player.onground ||
			Vel.Z > 0)
		{
			BeginJump(QueuedJumpType);
		}
		else if (!JumpWasPressed)
		{
			QueuedJumpType = 0;
		}
	}


	void UpdateBotJump()
	{
		if (player == null ||
			player.Bot == null ||
			Health <= 0 ||
			!UseBotAutoJump())
		{
			return;
		}

		if (BotJumpCooldown > 0)
		{
			BotJumpCooldown--;
			return;
		}

		// Новая проверка выполняется раз в 35 тиков.
		BotJumpCooldown =
			GetBotJumpCooldown();

		if (!player.onground ||
			JumpPhase != 0)
		{
			return;
		}

		if (!BotCanJumpDuringCombat() &&
			BotHasCombatIntent())
		{
			return;
		}

		if (Random(0, 255) >=
			GetBotJumpChance())
		{
			return;
		}

		int selectedType = 2;

		if (player.cmd.forwardmove < 0)
			selectedType = 1;

		Vel.Z =
			GetBotJumpStrength();

		BeginJump(selectedType);
	}


	void UpdateJumpPhysics()
	{
		if (player == null ||
			JumpPhase == 0)
		{
			return;
		}

		if (!player.onground)
			JumpHasLeftFloor = true;

		if (JumpHasLeftFloor &&
			player.onground)
		{
			JumpType = 0;
			JumpPhase = 0;
			QueuedJumpType = 0;
			JumpHasLeftFloor = false;

			SetStateLabel("Spawn");
			return;
		}
	}


	override void Tick()
	{
		UpdateHumanJumpRequest();

		Super.Tick();

		if (player == null ||
			Health <= 0)
		{
			return;
		}

		StartQueuedHumanJump();
		UpdateBotJump();
		UpdateJumpPhysics();

		if (player.Bot != null &&
			UsePatrolPoints() &&
			!PatrolSearchDone)
		{
			if (PatrolSearchDelay > 0)
			{
				PatrolSearchDelay--;
			}
			else
			{
				PatrolSearchDone = true;
				StartPatrol();
			}
		}

		UpdatePatrol();
	}


	// ========================================================
	// ACTION-ФУНКЦИИ ПРЫЖКА
	// ========================================================

	action State A_EnterUpdateBotAir()
	{
		if (invoker.player != null &&
			invoker.JumpHasLeftFloor &&
			invoker.player.onground)
		{
			invoker.JumpPhase = 3;

			if (invoker.JumpType == 1)
				return invoker.ResolveState(
					"BackJumpLand"
				);

			return invoker.ResolveState(
				"NormalJumpLand"
			);
		}

		invoker.JumpPhase = 2;

		if (invoker.JumpType == 1)
			return invoker.ResolveState(
				"BackJumpAir"
			);

		return invoker.ResolveState(
			"NormalJumpAir"
		);
	}


	action State A_CheckUpdateBotLanding()
	{
		if (invoker.player != null &&
			invoker.JumpHasLeftFloor &&
			invoker.player.onground)
		{
			invoker.JumpPhase = 3;

			if (invoker.JumpType == 1)
				return invoker.ResolveState(
					"BackJumpLand"
				);

			return invoker.ResolveState(
				"NormalJumpLand"
			);
		}

		return null;
	}


	action void A_FinishUpdateBotJump()
	{
		invoker.JumpType = 0;
		invoker.JumpPhase = 0;
		invoker.QueuedJumpType = 0;
		invoker.JumpHasLeftFloor = false;
	}


	States
	{
	Spawn:
	See:
		TNT1 A 1;
		Loop;

	Missile:
	Melee:
		TNT1 A 1;
		Goto Spawn;

	NormalJumpStart:
		TNT1 A 4;
		TNT1 A 0 A_EnterUpdateBotAir;
		Wait;

	NormalJumpAir:
		TNT1 A 1 A_CheckUpdateBotLanding;
		Loop;

	NormalJumpLand:
		TNT1 A 4;
		TNT1 A 0 A_FinishUpdateBotJump;
		Goto Spawn;

	BackJumpStart:
		TNT1 A 4;
		TNT1 A 0 A_EnterUpdateBotAir;
		Wait;

	BackJumpAir:
		TNT1 A 1 A_CheckUpdateBotLanding;
		Loop;

	BackJumpLand:
		TNT1 A 4;
		TNT1 A 0 A_FinishUpdateBotJump;
		Goto Spawn;

	Death:
		TNT1 A 1 A_NoBlocking;
		TNT1 A -1;
		Stop;

	XDeath:
		Goto Death;
	}
}


// ============================================================
// ОСНОВНОЙ ИГРОВОЙ КЛАСС
// ============================================================

class UpdatedDoom2Bot : UpdateBot
{
	const VIS_HIDDEN = 0;

	const VIS_STAND = 1;
	const VIS_RUN_FORWARD = 2;
	const VIS_RUN_BACK = 3;
	const VIS_RUN_LEFT = 4;
	const VIS_RUN_RIGHT = 5;
	const VIS_RUN_FORWARD_LEFT = 6;
	const VIS_RUN_FORWARD_RIGHT = 7;
	const VIS_RUN_BACK_LEFT = 8;
	const VIS_RUN_BACK_RIGHT = 9;

	const VIS_FIRE_STAND = 10;
	const VIS_FIRE_FORWARD = 11;
	const VIS_FIRE_BACK = 12;
	const VIS_FIRE_LEFT = 13;
	const VIS_FIRE_RIGHT = 14;
	const VIS_FIRE_FORWARD_LEFT = 15;
	const VIS_FIRE_FORWARD_RIGHT = 16;
	const VIS_FIRE_BACK_LEFT = 17;
	const VIS_FIRE_BACK_RIGHT = 18;

	const VIS_CROUCH_STAND = 19;
	const VIS_CROUCH_FORWARD = 20;
	const VIS_CROUCH_BACK = 21;
	const VIS_CROUCH_LEFT = 22;
	const VIS_CROUCH_RIGHT = 23;
	const VIS_CROUCH_FORWARD_LEFT = 24;
	const VIS_CROUCH_FORWARD_RIGHT = 25;
	const VIS_CROUCH_BACK_LEFT = 26;
	const VIS_CROUCH_BACK_RIGHT = 27;

	const VIS_CROUCH_FIRE_STAND = 28;
	const VIS_CROUCH_FIRE_FORWARD = 29;
	const VIS_CROUCH_FIRE_BACK = 30;
	const VIS_CROUCH_FIRE_LEFT = 31;
	const VIS_CROUCH_FIRE_RIGHT = 32;
	const VIS_CROUCH_FIRE_FORWARD_LEFT = 33;
	const VIS_CROUCH_FIRE_FORWARD_RIGHT = 34;
	const VIS_CROUCH_FIRE_BACK_LEFT = 35;
	const VIS_CROUCH_FIRE_BACK_RIGHT = 36;

	const VIS_JUMP_FORWARD = 37;
	const VIS_JUMP_BACK = 38;
	const VIS_JUMP_FORWARD_FIRE = 39;
	const VIS_JUMP_BACK_FIRE = 40;

	const VIS_KICK_STAND = 41;
	const VIS_KICK_CROUCH = 42;
	const VIS_KICK_AIR = 43;

	const VIS_DEATH1 = 44;
	const VIS_DEATH2 = 45;
	const VIS_DEATH3 = 46;

	const DIR_STAND       = 0;
	const DIR_FORWARD     = 1;
	const DIR_BACK        = 2;
	const DIR_LEFT        = 3;
	const DIR_RIGHT       = 4;
	const DIR_FORWARDLEFT = 5;
	const DIR_FORWARDRIGHT = 6;
	const DIR_BACKLEFT    = 7;
	const DIR_BACKRIGHT   = 8;

	const KICK_NONE   = 0;
	const KICK_STAND  = 1;
	const KICK_CROUCH = 2;
	const KICK_AIR    = 3;

	Actor LegsLayer;
	Actor BodyLayer;
	Actor WeaponLayer;

	int CurrentWeaponModel;

	int VisualDirection;
	bool VisualFireHeld;

	bool AltAttackWasPressed;

	int KickType;
	int KickTicksRemaining;
	int KickElapsed;
	bool KickDamageDone;

	int BotDecisionTimer;
	int BotCrouchTimer;
	int BotStrafeTimer;
	int BotStrafeDirection;

	bool DeathAnimationActive;
	bool XDeathVisual;
	int DeathVariant;


	Default
	{
		Player.DisplayName "UpdatedDoom2Bot";

		Health 100;
		Speed 1.0;
		PainChance 0;

		RenderStyle "Normal";

		Player.JumpZ 8.0;
		Player.MaxHealth 100;

		Player.StartItem "MyChaingun";
		Player.StartItem "Clip", 1;

		Player.WeaponSlot 2, "MyChaingun";
		Player.WeaponSlot 3, "MyShotgun";
		Player.WeaponSlot 4, "RocketLauncher";
		Player.ColorRange 112, 127;

		+NOPAIN;
	}


	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		LegsLayer = Spawn(
			"UpdatedDoom2BotLegsLayer",
			Pos
		);

		if (LegsLayer != null)
			LegsLayer.Master = self;

		BodyLayer = Spawn(
			"UpdatedDoom2BotBodyLayer",
			Pos
		);

		if (BodyLayer != null)
			BodyLayer.Master = self;

		CurrentWeaponModel = -1;
		BotDecisionTimer = 35;
	}


	void EnsureVisualLayers()
	{
		if (LegsLayer == null)
		{
			LegsLayer = Spawn(
				"UpdatedDoom2BotLegsLayer",
				Pos
			);

			if (LegsLayer != null)
				LegsLayer.Master = self;
		}

		if (BodyLayer == null)
		{
			BodyLayer = Spawn(
				"UpdatedDoom2BotBodyLayer",
				Pos
			);

			if (BodyLayer != null)
				BodyLayer.Master = self;
		}
	}

	// ========================================================
	// СОСТОЯНИЕ ИГРОКА
	// ========================================================

	bool IsUpdateBotCrouching()
	{
		return GetCrouchFactor() < 0.95;
	}


	bool IsUpdateBotAirborne()
	{
		return JumpPhase != 0 ||
			(player != null &&
			 !player.onground);
	}


	bool HideThirdPersonLayers()
	{
		if (player == null ||
			consoleplayer < 0)
		{
			return false;
		}

		return
			player == players[consoleplayer] &&
			(player.cheats & CF_CHASECAM) == 0;
	}

	int GetInputDirection()
	{
		if (player == null)
			return DIR_STAND;

		double forward =
			player.cmd.forwardmove;

		double side =
			player.cmd.sidemove;

		if (forward > 0 && side < 0)
			return DIR_FORWARDLEFT;

		if (forward > 0 && side > 0)
			return DIR_FORWARDRIGHT;

		if (forward < 0 && side < 0)
			return DIR_BACKLEFT;

		if (forward < 0 && side > 0)
			return DIR_BACKRIGHT;

		if (forward > 0)
			return DIR_FORWARD;

		if (forward < 0)
			return DIR_BACK;

		if (side < 0)
			return DIR_LEFT;

		if (side > 0)
			return DIR_RIGHT;

		return DIR_STAND;
	}


	// ========================================================
	// ВЫБОР ВИЗУАЛЬНОГО КОМПЛЕКТА
	// ========================================================

	int GetStandingVisualState(
		int direction,
		bool firing
	)
	{
		if (firing)
		{
			switch (direction)
			{
			case DIR_FORWARD:
				return VIS_FIRE_FORWARD;

			case DIR_BACK:
				return VIS_FIRE_BACK;

			case DIR_LEFT:
				return VIS_FIRE_LEFT;

			case DIR_RIGHT:
				return VIS_FIRE_RIGHT;

			case DIR_FORWARDLEFT:
				return VIS_FIRE_FORWARD_LEFT;

			case DIR_FORWARDRIGHT:
				return VIS_FIRE_FORWARD_RIGHT;

			case DIR_BACKLEFT:
				return VIS_FIRE_BACK_LEFT;

			case DIR_BACKRIGHT:
				return VIS_FIRE_BACK_RIGHT;

			default:
				return VIS_FIRE_STAND;
			}
		}

		switch (direction)
		{
		case DIR_FORWARD:
			return VIS_RUN_FORWARD;

		case DIR_BACK:
			return VIS_RUN_BACK;

		case DIR_LEFT:
			return VIS_RUN_LEFT;

		case DIR_RIGHT:
			return VIS_RUN_RIGHT;

		case DIR_FORWARDLEFT:
			return VIS_RUN_FORWARD_LEFT;

		case DIR_FORWARDRIGHT:
			return VIS_RUN_FORWARD_RIGHT;

		case DIR_BACKLEFT:
			return VIS_RUN_BACK_LEFT;

		case DIR_BACKRIGHT:
			return VIS_RUN_BACK_RIGHT;

		default:
			return VIS_STAND;
		}
	}


	int GetCrouchingVisualState(
		int direction,
		bool firing
	)
	{
		if (firing)
		{
			switch (direction)
			{
			case DIR_FORWARD:
				return VIS_CROUCH_FIRE_FORWARD;

			case DIR_BACK:
				return VIS_CROUCH_FIRE_BACK;

			case DIR_LEFT:
				return VIS_CROUCH_FIRE_LEFT;

			case DIR_RIGHT:
				return VIS_CROUCH_FIRE_RIGHT;

			case DIR_FORWARDLEFT:
				return VIS_CROUCH_FIRE_FORWARD_LEFT;

			case DIR_FORWARDRIGHT:
				return VIS_CROUCH_FIRE_FORWARD_RIGHT;

			case DIR_BACKLEFT:
				return VIS_CROUCH_FIRE_BACK_LEFT;

			case DIR_BACKRIGHT:
				return VIS_CROUCH_FIRE_BACK_RIGHT;

			default:
				return VIS_CROUCH_FIRE_STAND;
			}
		}

		switch (direction)
		{
		case DIR_FORWARD:
			return VIS_CROUCH_FORWARD;

		case DIR_BACK:
			return VIS_CROUCH_BACK;

		case DIR_LEFT:
			return VIS_CROUCH_LEFT;

		case DIR_RIGHT:
			return VIS_CROUCH_RIGHT;

		case DIR_FORWARDLEFT:
			return VIS_CROUCH_FORWARD_LEFT;

		case DIR_FORWARDRIGHT:
			return VIS_CROUCH_FORWARD_RIGHT;

		case DIR_BACKLEFT:
			return VIS_CROUCH_BACK_LEFT;

		case DIR_BACKRIGHT:
			return VIS_CROUCH_BACK_RIGHT;

		default:
			return VIS_CROUCH_STAND;
		}
	}

	int GetWantedVisualState()
	{
		if (XDeathVisual)
			return VIS_HIDDEN;

		if (Health <= 0 ||
			DeathAnimationActive)
		{
			if (DeathVariant == 2)
				return VIS_DEATH2;

			if (DeathVariant == 3)
				return VIS_DEATH3;

			return VIS_DEATH1;
		}

		if (KickTicksRemaining > 0)
		{
			if (KickType == KICK_CROUCH)
				return VIS_KICK_CROUCH;

			if (KickType == KICK_AIR)
				return VIS_KICK_AIR;

			return VIS_KICK_STAND;
		}

		// В воздухе всегда используется обычный прыжок.
		// Стрельба продолжает работать, но визуально не отображается.
		if (IsUpdateBotAirborne())
		{
			if (JumpType == 1)
				return VIS_JUMP_BACK;

			return VIS_JUMP_FORWARD;
		}

		// Наземная стрельба.
		if (VisualFireHeld)
		{
			if (IsUpdateBotCrouching())
			{
				return GetCrouchingVisualState(
					VisualDirection,
					true
				);
			}

			return GetStandingVisualState(
				VisualDirection,
				true
			);
		}

		// Обычный присед.
		if (IsUpdateBotCrouching())
		{
			return GetCrouchingVisualState(
				VisualDirection,
				false
			);
		}

		// Обычная стойка или движение.
		return GetStandingVisualState(
			VisualDirection,
			false
		);
	}


	// ========================================================
	// ОРУЖЕЙНЫЙ СЛОЙ
	// ========================================================

	int GetWeaponModelNumber()
	{
		if (player == null ||
			player.ReadyWeapon == null)
		{
			return 0;
		}

		Weapon ready =
			player.ReadyWeapon;

		if (ready is "SuperShotgun")
			return 3;

		if (ready is "Pistol")
			return 1;

		if (ready is "Shotgun")
			return 2;

		if (ready is "Chaingun")
			return 4;

		if (ready is "RocketLauncher")
			return 5;

		if (ready is "PlasmaRifle")
			return 6;

		return 0;
	}


	Actor SpawnWeaponLayer(int number)
	{
		switch (number)
		{
		case 1:
			return Spawn(
				"UpdatedDoom2BotWeapon1Layer",
				Pos
			);

		case 2:
			return Spawn(
				"UpdatedDoom2BotWeapon2Layer",
				Pos
			);

		case 3:
			return Spawn(
				"UpdatedDoom2BotWeapon3Layer",
				Pos
			);

		case 4:
			return Spawn(
				"UpdatedDoom2BotWeapon4Layer",
				Pos
			);

		case 5:
			return Spawn(
				"UpdatedDoom2BotWeapon5Layer",
				Pos
			);

		case 6:
			return Spawn(
				"UpdatedDoom2BotWeapon6Layer",
				Pos
			);
		}

		return null;
	}


	void UpdateWeaponLayer()
	{
		int wantedWeapon =
			GetWeaponModelNumber();

		if (wantedWeapon == CurrentWeaponModel &&
			(wantedWeapon == 0 || WeaponLayer != null))
		{
			return;
		}

		CurrentWeaponModel =
			wantedWeapon;

		if (WeaponLayer != null)
		{
			WeaponLayer.Destroy();
			WeaponLayer = null;
		}

		if (wantedWeapon == 0)
			return;

		WeaponLayer =
			SpawnWeaponLayer(wantedWeapon);

		if (WeaponLayer != null)
			WeaponLayer.Master = self;
	}


	// ========================================================
	// KICK
	// ========================================================

	void StartUpdatedKick()
	{
		if (KickTicksRemaining > 0 ||
			Health <= 0)
		{
			return;
		}

		KickElapsed = 0;
		KickDamageDone = false;

		if (IsUpdateBotAirborne())
		{
			KickType = KICK_AIR;
			KickTicksRemaining = 10;
		}
		else if (IsUpdateBotCrouching())
		{
			KickType = KICK_CROUCH;
			KickTicksRemaining = 8;
		}
		else
		{
			KickType = KICK_STAND;
			KickTicksRemaining = 5;
		}

		Vel.X = 0;
		Vel.Y = 0;
	}


	void FinishUpdatedKick()
	{
		KickType = KICK_NONE;
		KickTicksRemaining = 0;
		KickElapsed = 0;
		KickDamageDone = false;
	}


	void BlockMovementForKick()
	{
		if (player == null ||
			KickTicksRemaining <= 0)
		{
			return;
		}

		player.cmd.forwardmove = 0;
		player.cmd.sidemove = 0;

		player.cmd.buttons &=
			~(BT_JUMP | BT_ALTATTACK);

		if (KickType == KICK_CROUCH)
		{
			player.cmd.buttons |=
				BT_CROUCH;
		}
		else
		{
			player.cmd.buttons &=
				~BT_CROUCH;
		}

		Vel.X = 0;
		Vel.Y = 0;
	}


	void PerformUpdatedKickDamage()
	{
		FTranslatedLineTarget hitTarget;

		double attackPitch =
			AimLineAttack(
				Angle,
				64.0,
				hitTarget
			);

		LineAttack(
			Angle,
			64.0,
			attackPitch,
			20,
			'Melee',
			"BulletPuff"
		);

		if (hitTarget.linetarget != null)
		{
			A_PlaySound(
				"weapons/punch",
				CHAN_BODY
			);
		}
	}


	void UpdateKickAfterPhysics()
	{
		if (KickTicksRemaining <= 0)
			return;

		KickElapsed++;

		int damageTick = 3;

		if (KickType == KICK_CROUCH)
			damageTick = 4;

		if (KickType == KICK_AIR)
			damageTick = 5;

		if (!KickDamageDone &&
			KickElapsed >= damageTick)
		{
			KickDamageDone = true;
			PerformUpdatedKickDamage();
		}

		KickTicksRemaining--;

		if (KickTicksRemaining <= 0)
			FinishUpdatedKick();
	}


	// ========================================================
	// СЛУЧАЙНЫЕ ДЕЙСТВИЯ КОМПЬЮТЕРНОГО БОТА
	// ========================================================

    //Шанс приседа Crouch Chance
	void UpdateComputerBotEvasion()
	{
		if (player == null ||
			player.Bot == null ||
			Health <= 0 ||
			KickTicksRemaining > 0)
		{
			return;
		}

		bool combat =
			BotHasCombatIntent();

		if (!combat)
		{
			BotCrouchTimer = 0;
			BotStrafeTimer = 0;
			return;
		}

		if (BotDecisionTimer > 0)
		{
			BotDecisionTimer--;
		}
		else
		{
			BotDecisionTimer = 35;

			// 20% на присед.
			if (BotCrouchTimer <= 0 &&
				Random(0, 99) < 20)
			{
				BotCrouchTimer =
					Random(35, 70);
			}

			// 20% на страйф. Шанст страйфа Strofe chance
			if (BotStrafeTimer <= 0 &&
				Random(0, 99) < 20)
			{
				BotStrafeTimer =
					Random(18, 35);

				if (Random(0, 1) == 0)
					BotStrafeDirection = -1;
				else
					BotStrafeDirection = 1;
			}
		}

		if (BotCrouchTimer > 0)
		{
			BotCrouchTimer--;
			player.cmd.buttons |=
				BT_CROUCH;
		}

		if (BotStrafeTimer > 0)
		{
			BotStrafeTimer--;

			player.cmd.sidemove =
				BotStrafeDirection *
				0x2800;
		}
	}


	override void Tick()
	{
		bool attackPressed = false;
		bool newAltAttackPress = false;

		if (player != null)
		{
			UpdateComputerBotEvasion();

			attackPressed =
				(player.cmd.buttons &
					BT_ATTACK) != 0;

			bool altAttackPressed =
				(player.cmd.buttons &
					BT_ALTATTACK) != 0;

			newAltAttackPress =
				altAttackPressed &&
				!AltAttackWasPressed;

			AltAttackWasPressed =
				altAttackPressed;

			// Стрельба прерывает Kick.
			if (KickTicksRemaining > 0 &&
				attackPressed)
			{
				FinishUpdatedKick();
			}

			if (newAltAttackPress &&
				!attackPressed &&
				KickTicksRemaining <= 0 &&
				Health > 0)
			{
				StartUpdatedKick();
			}

			VisualFireHeld =
				attackPressed &&
				KickTicksRemaining <= 0;

			if (KickTicksRemaining > 0)
				BlockMovementForKick();

			VisualDirection =
				GetInputDirection();
		}

		Super.Tick();

		if (player == null)
			return;

		if (Health > 0)
		{
			EnsureVisualLayers();
			UpdateKickAfterPhysics();
			UpdateWeaponLayer();
		}
	}


	// ========================================================
	// СМЕРТЬ
	// ========================================================

	action void A_StartUpdatedDeath()
	{
		invoker.FinishUpdatedKick();

		invoker.VisualFireHeld = false;
		invoker.DeathAnimationActive = true;
		invoker.XDeathVisual = false;

		invoker.DeathVariant =
			Random(1, 3);
	}


	action void A_StartUpdatedXDeath()
	{
		invoker.FinishUpdatedKick();

		invoker.VisualFireHeld = false;
		invoker.DeathAnimationActive = false;
		invoker.XDeathVisual = true;
	}


	States
	{
	Spawn:
	See:
		TNT1 A 1;
		Loop;


	Missile:
	Melee:
		TNT1 A 1;
		Goto Spawn;


	Pain:
		Goto Spawn;


	NormalJumpStart:
		TNT1 A 4;
		TNT1 A 0 A_EnterUpdateBotAir;
		Wait;

	NormalJumpAir:
		TNT1 A 1 A_CheckUpdateBotLanding;
		Loop;

	NormalJumpLand:
		TNT1 A 4;
		TNT1 A 0 A_FinishUpdateBotJump;
		Goto Spawn;


	BackJumpStart:
		TNT1 A 4;
		TNT1 A 0 A_EnterUpdateBotAir;
		Wait;

	BackJumpAir:
		TNT1 A 1 A_CheckUpdateBotLanding;
		Loop;

	BackJumpLand:
		TNT1 A 4;
		TNT1 A 0 A_FinishUpdateBotJump;
		Goto Spawn;


	Death:
		TNT1 A 0 A_StartUpdatedDeath;
		TNT1 A 1 A_NoBlocking;
		TNT1 A -1;
		Stop;


	XDeath:
		TNT1 A 0 A_StartUpdatedXDeath;
		TNT1 A 0 A_SetRenderStyle(
			1.0,
			STYLE_Normal
		);
		TNT1 A 1 A_NoBlocking;

		// Позже заменить спрайтами взрыва.
		TNT1 A -1;
		Stop;
		}
}


// ============================================================
// ОБЩИЙ КЛАСС ВИЗУАЛЬНОГО СЛОЯ
// ============================================================

class UpdatedDoom2BotVisualLayer : Actor
{
	int CurrentVisualState;


	bool DetachedCorpse;
	int CorpseTicks;

	Default
	{
		Radius 1;
		Height 1;

		RenderStyle "Normal";
		Alpha 1.0;

		+NOBLOCKMAP;
		+NOINTERACTION;
		+NOGRAVITY;
		+NOCLIP;
		+DROPOFF;
	}


	virtual bool KeepLayerAfterDeath()
	{
		return true;
	}

	UpdatedDoom2Bot GetPawn()
	{
		return UpdatedDoom2Bot(Master);
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		CurrentVisualState = -1;
	}


	void SynchronizeWithPawn(
		UpdatedDoom2Bot pawn
	)
	{
		SetOrigin(
			pawn.Pos,
			true
		);

		Angle = pawn.Angle;
		Pitch = 0;
		Roll = 0;

		Scale = pawn.Scale;
		FloorClip = pawn.FloorClip;
		Translation = pawn.Translation;
		Alpha = 1.0;
	}

	void ChangeVisualState(int wantedState)
	{
		if (CurrentVisualState ==
			wantedState)
		{
			return;
		}

		CurrentVisualState =
			wantedState;

		switch (wantedState)
		{
		case 0:
			SetStateLabel("Hidden");
			break;

		case 1:
			SetStateLabel("Stand");
			break;

		case 2:
			SetStateLabel("RunForward");
			break;

		case 3:
			SetStateLabel("RunBack");
			break;

		case 4:
			SetStateLabel("RunLeft");
			break;

		case 5:
			SetStateLabel("RunRight");
			break;

		case 6:
			SetStateLabel("RunForwardLeft");
			break;

		case 7:
			SetStateLabel("RunForwardRight");
			break;

		case 8:
			SetStateLabel("RunBackLeft");
			break;

		case 9:
			SetStateLabel("RunBackRight");
			break;

		case 10:
			SetStateLabel("FireStand");
			break;

		case 11:
			SetStateLabel("FireForward");
			break;

		case 12:
			SetStateLabel("FireBack");
			break;

		case 13:
			SetStateLabel("FireLeft");
			break;

		case 14:
			SetStateLabel("FireRight");
			break;

		case 15:
			SetStateLabel("FireForwardLeft");
			break;

		case 16:
			SetStateLabel("FireForwardRight");
			break;

		case 17:
			SetStateLabel("FireBackLeft");
			break;

		case 18:
			SetStateLabel("FireBackRight");
			break;

		case 19:
			SetStateLabel("CrouchStand");
			break;

		case 20:
			SetStateLabel("CrouchForward");
			break;

		case 21:
			SetStateLabel("CrouchBack");
			break;

		case 22:
			SetStateLabel("CrouchLeft");
			break;

		case 23:
			SetStateLabel("CrouchRight");
			break;

		case 24:
			SetStateLabel("CrouchForwardLeft");
			break;

		case 25:
			SetStateLabel("CrouchForwardRight");
			break;

		case 26:
			SetStateLabel("CrouchBackLeft");
			break;

		case 27:
			SetStateLabel("CrouchBackRight");
			break;

		case 28:
			SetStateLabel("CrouchFireStand");
			break;

		case 29:
			SetStateLabel("CrouchFireForward");
			break;

		case 30:
			SetStateLabel("CrouchFireBack");
			break;

		case 31:
			SetStateLabel("CrouchFireLeft");
			break;

		case 32:
			SetStateLabel("CrouchFireRight");
			break;

		case 33:
			SetStateLabel("CrouchFireForwardLeft");
			break;

		case 34:
			SetStateLabel("CrouchFireForwardRight");
			break;

		case 35:
			SetStateLabel("CrouchFireBackLeft");
			break;

		case 36:
			SetStateLabel("CrouchFireBackRight");
			break;

		case 37:
			SetStateLabel("JumpForward");
			break;

		case 38:
			SetStateLabel("JumpBack");
			break;

		case 39:
			SetStateLabel("JumpForwardFire");
			break;

		case 40:
			SetStateLabel("JumpBackFire");
			break;

		case 41:
			SetStateLabel("KickStand");
			break;

		case 42:
			SetStateLabel("KickCrouch");
			break;

		case 43:
			SetStateLabel("KickAir");
			break;

		case 44:
			SetStateLabel("Death1");
			break;

		case 45:
			SetStateLabel("Death2");
			break;

		case 46:
			SetStateLabel("Death3");
			break;

		default:
			SetStateLabel("Stand");
			break;
		}
	}


	override void Tick()
	{
		Super.Tick();

		// Отсоединённая модель трупа.
		if (DetachedCorpse)
		{
			if (CorpseTicks > 0)
			{
				CorpseTicks--;
			}
			else
			{
				Destroy();
			}

			return;
		}

		UpdatedDoom2Bot pawn =
			GetPawn();

		if (pawn == null)
		{
			Destroy();
			return;
		}

		SynchronizeWithPawn(pawn);

		// При XDeath никаких 3D-моделей не оставляем.
		if (pawn.XDeathVisual)
		{
			Destroy();
			return;
		}

		// Обычная смерть.
		if (pawn.DeathAnimationActive)
		{
			ChangeVisualState(
				pawn.GetWantedVisualState()
			);

			bInvisible = false;

			if (!KeepLayerAfterDeath())
			{
				Destroy();
				return;
			}

			bool landed =
				pawn.Pos.Z <= pawn.FloorZ + 1.0;

			if (pawn.player != null &&
				pawn.player.onground)
			{
				landed = true;
			}

			// Пока pawn падает, слои продолжают следовать за ним.
			if (!landed)
				return;

			// После приземления оставляем независимый труп.
			DetachedCorpse = true;
			CorpseTicks = 600;
			Master = null;

			return;
		}

		bInvisible =
			pawn.HideThirdPersonLayers();

		ChangeVisualState(
			pawn.GetWantedVisualState()
		);
	}


	States
	{
	Spawn:
	Hidden:
		TNT1 A -1;
		Stop;


	// --------------------------------------------------------
	// СТОЙКА И ДВИЖЕНИЕ
	// --------------------------------------------------------

	Stand:
		STID A 1;
		Loop;

	RunForward:
		RNFW ABCDEFGHIJK 2;
		Loop;

	RunBack:
		RNBK ABCDEFGHIJ 2;
		Loop;

	RunLeft:
		RNLF ABCDEFGHIJK 2;
		Loop;

	RunRight:
		RNRT ABCDEFGHIJK 2;
		Loop;

	RunForwardLeft:
		RNFL ABCDEFGHIJK 2;
		Loop;

	RunForwardRight:
		RNFR ABCDEFGHIJK 2;
		Loop;

	RunBackLeft:
		RNBL ABCDEFGHIJ 2;
		Loop;

	RunBackRight:
		RNBR ABCDEFGHIJ 2;
		Loop;


	// --------------------------------------------------------
	// СТРЕЛЬБА СТОЯ
	// --------------------------------------------------------

	FireStand:
		FSID A 1;
		Loop;

	FireForward:
		FSFW ABCDEFGHIJK 2;
		Loop;

	FireBack:
		FSBK ABCDEFGHIJ 2;
		Loop;

	FireLeft:
		FSLF ABCDEFGHIJK 2;
		Loop;

	FireRight:
		FSRT ABCDEFGHIJK 2;
		Loop;

	FireForwardLeft:
		FSFL ABCDEFGHIJK 2;
		Loop;

	FireForwardRight:
		FSFR ABCDEFGHIJK 2;
		Loop;

	FireBackLeft:
		FSBL ABCDEFGHIJ 2;
		Loop;

	FireBackRight:
		FSBR ABCDEFGHIJ 2;
		Loop;


	// --------------------------------------------------------
	// ПРИСЕД
	// --------------------------------------------------------

	CrouchStand:
		CRID A 1;
		Loop;

	CrouchForward:
		CRFW ABCDEFGH 1;
		Loop;

	CrouchBack:
		CRBK ABCDEFGH 1;
		Loop;

	CrouchLeft:
		CRLF ABCDEFGH 1;
		Loop;

	CrouchRight:
		CRRT ABCDEFGH 1;
		Loop;

	CrouchForwardLeft:
		CRFL ABCDEFGH 1;
		Loop;

	CrouchForwardRight:
		CRFR ABCDEFGH 1;
		Loop;

	CrouchBackLeft:
		CRBL ABCDEFGH 1;
		Loop;

	CrouchBackRight:
		CRBR ABCDEFGH 1;
		Loop;


	// --------------------------------------------------------
	// СТРЕЛЬБА В ПРИСЕДЕ
	// --------------------------------------------------------

	CrouchFireStand:
		CFID A 1;
		Loop;

	CrouchFireForward:
		CFFW ABCDEFGH 1;
		Loop;

	CrouchFireBack:
		CFBK ABCDEFGH 1;
		Loop;

	CrouchFireLeft:
		CFLF ABCDEFGH 1;
		Loop;

	CrouchFireRight:
		CFRT ABCDEFGH 1;
		Loop;

	CrouchFireForwardLeft:
		CFFL ABCDEFGH 1;
		Loop;

	CrouchFireForwardRight:
		CFFR ABCDEFGH 1;
		Loop;

	CrouchFireBackLeft:
		CFBL ABCDEFGH 1;
		Loop;

	CrouchFireBackRight:
		CFBR ABCDEFGH 1;
		Loop;


	// --------------------------------------------------------
	// ПРЫЖКИ
	// --------------------------------------------------------

	JumpForward:
		JPFW ABCDEFGHIJKLMNO 2;
		JPFW O -1;
		Stop;

	JumpBack:
		JPBK ABCDEFGHIJ 2;
		JPBK J -1;
		Stop;

	JumpForwardFire:
		JFFW ABCDEFGHIJKLMNO 2;
		Loop;

	JumpBackFire:
		JFBK ABCDEFGHIJ 2;
		Loop;


	// --------------------------------------------------------
	// KICK
	// --------------------------------------------------------

	KickStand:
		KKST ABCDE 2;
		KKST E -1;
		Stop;

	KickCrouch:
		KKCR ABCDEFGH 2;
		KKCR H -1;
		Stop;

	KickAir:
		KKAR ABCDEFGHIJ 2;
		KKAR J -1;
		Stop;


	// --------------------------------------------------------
	// ТРИ ВАРИАНТА СМЕРТИ
	// --------------------------------------------------------

	Death1:
		TNT1 A 1 ACS_Execute(2, 0, 0);
		D1AA ABCDEFGHIJKLMNOPQRSTUVWXYZ 1;
		D1AB ABCDD 1;
		D1AB D -1;
		Stop;

	Death2:
	    TNT1 A 1 ACS_Execute(2, 0, 0);
		D2AA ABCDEFGHIJKLMNOPQRSTUVWXYZ 1;
		D2AB ABCDD 1;
		D2AB D -1;
		Stop;

	Death3:
		TNT1 A 1 ACS_Execute(2, 0, 0);
		D3AA ABCDEFGHIJKLMNOPQRSTUVWXYZ 1;
		D3AB ABCDD 1;
		D3AB D -1;
		Stop;
		
	XDeath:
		TNT1 A 1 ACS_Execute(2, 0, 0);
		D1AA ABCDEFGHIJKLMNOPQRSTUVWXYZ 1;
		D1AB ABCDD 1;
		D1AB D -1;
		Stop;		
	}
}


