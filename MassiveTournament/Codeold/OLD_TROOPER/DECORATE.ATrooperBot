ACTOR ATrooperBody
{
  Health 1
  Radius 0
  Height 5
  Speed 0
  Monster
  +NOPAIN
	-PUSHABLE
	-SOLID
	+LOOKALLAROUND
  Mass 9999
  Damagefactor "EnemyBolt", 0
  Obituary "You was shooted by trooper alien"
  
  States
  {
  Spawn:
    //POSS A 0 A_Warp(AAPTR_TARGET, 0, 0, 56, WARPF_NOCHECKPOSITION)
	POSS A 0
	POSS A 0 Thing_ChangeTID(0, 99)
    POSS A 0 Thing_Hate(0, 88, 3)
  Spn:
    POSS A 1
	{
	A_Look;
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE);
	}
    Loop
	
 See:
    POSS ABCDEFGHIJKLMNOPQR 1 
	{
	//A_FaceTarget(90);
	A_FaceTarget;
	A_Chase("Missile","Missile", CHF_DONTMOVE);
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE);
	}
    Loop	
	
  Missile:
    POSS E 1
	{	
	A_FaceTarget;
	//A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE | WARPF_COPYPITCH);
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE);
	}
    POSS F 1
    {	
	A_FaceTarget;
	A_PlaySoundEx("FFire","SoundSlot5");
	//A_CustomMissile("EnemyBolt"); //,3,0);
	A_CustomMissile("EnemyBolt", 3, 0, random(-5,5));
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE);
	}
    POSS EEE 1
	{
	A_FaceTarget;
	A_Warp(AAPTR_MASTER, 0, 0, 36, 0, WARPF_USECALLERANGLE);
	}
    Goto See
	
  Death:
    TNT1 A 0 A_ClearTarget
    TNT1 A 0 A_KillMaster
    TNT1 A 5
    //POSS I 5 A_Scream
    TNT1 A 5 A_NoBlocking
    //POSS K 5
    TNT1 A 1 A_FadeOut
    Stop
  }
}


ACTOR ATrooperLegs : PlayerPawn replaces BaronofHell
{
  Health 100
  Radius 20
  Height 46   //56!! bilo
  Speed 14
  PainChance 255
  Monster
  +SLIDESONWALLS
  +FLOORCLIP
  +BOSS
  +NOPAIN
  -FRIENDLY
  Mass 9999
  DeathSound "PREDDY"

  Damagefactor "EnemyBolt", 0
  //Damagefactor "EnemyVehicleBolt", 0
  States
  {
  Spawn:
    //POSS A 1 NoDelay A_SpawnItem("ATrooperBody", 0, 56)
	POSS A 0
	POSS A 0 Thing_ChangeTID(0, 550)
    POSS A 0 Thing_Hate(0, 199, 6)
	POSS A 0 Thing_SetGoal(550,1,0) //Thing_SetGoal(550,30,0)
	POSS A 1 A_JumpIfInventory("ASpan2",1,"Spn2")
    POSS A 1 A_JumpIfInventory("ASpan",1,"Spn")
    Goto Diss
  Spn:
    POSS A 1 A_SpawnItemEx("ATrooperBody", 0, 0, 36, 0, 0, 0, 0, SXF_SETMASTER | SXF_TRANSFERPOINTERS, 0)
    TNT1 A 0 A_PlaySound("PREDRG")
    TNT1 A 0 GiveInventory("ASpan2",1)
  Spn2:
    TNT1 A 0 A_ChangeFlag("NOPAIN",false)
	POSS A 20
    POSS A 3 A_Look
    Loop
  See:
	TNT1 A 0 A_ChangeFlag("NOPAIN",false) 
	POSS ABCDEFGHIJKLMNOPQR 1 A_Chase
	Loop 
	
  StrifeLeft:
  	//RQPONMLKJIHGFEDCBA  1
	POSS RQPO 1
	{  
	A_FaceTarget;
//	A_Recoil(1);
	ThrustThing(angle*256/360+210,3, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSS NMLKJ 1
	{  
	A_FaceTarget;
//	A_Recoil(1);
	ThrustThing(angle*256/360+210,3, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSS IHGF 1
	{  
	A_FaceTarget;
//	A_Recoil(1);	
	ThrustThing(angle*256/360+210,3, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSS EDCBA 1
	{  
	A_FaceTarget;
//	A_Recoil(1);	
	ThrustThing(angle*256/360+210,3, 0, 0);
	}

  StrifeRight:
	POSS RQPO 1
	{  
	A_FaceTarget;
//	A_Recoil(1);
	ThrustThing(angle*256/360+210,-3, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSS NMLKJ 1
	{  
	A_FaceTarget;
//	A_Recoil(1);
	ThrustThing(angle*256/360+210,-3, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSS IHGF 1
	{  
	A_FaceTarget;
//	A_Recoil(1);	
	ThrustThing(angle*256/360+210,-3, 0, 0);
	}
	TNT1 A 0 A_Stop 
	POSS EDCBA 1
	{  
	A_FaceTarget;
//	A_Recoil(1);	
	ThrustThing(angle*256/360+210,-3, 0, 0);
	}
    Goto See
	
 Pain:
  TNT1 A 0 A_ChangeFlag("NOPAIN",true) 
  //POSS A 0 Thing_Hate(0, 88, 3)
  POSS A 0 A_FaceTarget
  //POSS RQPONMLKJIHGFEDCBA 1 A_Recoil(1)
  TNT1 A 0 A_Stop
  TNT1 A 0 A_Jump(120, "StrifeRight")
  TNT1 A 0 A_Jump(120, "StrifeLeft")
  Goto See
  
    Death:
	TNT1 A 0 TakeInventory("ASpan2",1)
    TNT1 A 0 ACS_Execute(1, 0, 0)
    TNT1 A 0 A_KillChildren
	TNT1 A 0 A_ClearTarget
    POSD A 1
    POSD B 1 A_Scream
    POSD C 1 A_NoBlocking
    POSD DEFGHIJKLMNOPQRSTUVWXYZ 1
	PODD ABCDEFGHIJ 1
    PODD J 180
    PODD J 5 A_Respawn
    Stop
	
		XDeath:
		TNT1 A 0 TakeInventory("ASpan2",1)
		TNT1 A 0 ACS_Execute(1, 0, 0)
        TNT1 A 0 A_KillChildren
		POSD A 1
		TNT1 AAAAAA 0 A_CustomMissile ("CeilBloodLauncherLong", 0, 0, random (0, 360), 2, random (50, 130))
		TNT1 AA 0 A_CustomMissile ("XDeath1", 32, 0, random (0, 360), 2, random (0, 160))
		 TNT1 AA 0 A_CustomMissile ("XDeath2", 32, 0, random (0, 360), 2, random (0, 160))
		 TNT1 AA 0 A_CustomMissile ("XDeath3", 32, 0, random (0, 360), 2, random (0, 160))
		 TNT1 A 0 A_CustomMissile ("XDeath4", 32, 0, random (0, 360), 2, random (0, 160))
		 TNT1 AAAAAAAA 0 A_CustomMissile ("SuperWallRedBlood", 40, 0, random (0, 360), 2, random (-5, 5))
		 TNT1 AAAA 0 A_CustomMissile ("Instestin", 32, 0, random (0, 360), 2, random (0, 160))
		 TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 35, 0, random (0, 360), 2, random (0, 160))
		 TNT1 AAAAAA 0 bright A_CustomMissile ("SuperGoreSpawner", 32, 0, random (0, 360), 2, random (50, 130))
		POSD B 1 A_PlaySound("PREDDY")//A_XScream
		POSD C 1 A_NoBlocking
		//TNT1 A 0 A_CustomMissile ("GiantBloodSpot", 4, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 150
		TNT1 A 1 A_Respawn
		Stop
		
   Diss: 
    TNT1 A 0 GiveInventory("ASpan",1)
    TNT1 A 5 A_ClearTarget
    TNT1 A 5 A_Respawn
    Stop	
	}
}


